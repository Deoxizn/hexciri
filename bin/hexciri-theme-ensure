#!/bin/bash
# hexciri-theme-ensure: make sure the active theme is actually live.
#
# The installer seeds the maiden theme from within the chroot user phase, where
# no noctalia/niri/session exists — if that run dies partway, the box boots
# themeless (default palette, no wallpaper). This runs at every login via
# spawn-at-startup, cheaply checks that Noctalia is on the hexciri custom
# palette and the theme tree exists, and only re-runs hexciri-theme-set when
# something is missing. Idempotent and near-instant on healthy setups.
set -euo pipefail

state="$HOME/.local/state/hexciri/current"
name_file="$state/theme.name"
noctalia_cfg="$HOME/.config/noctalia/config.toml"

# Strata's "Follow Omarchy" theme mode watches this path for live changes.
# Hexciri keeps its own current-theme state, so bridge it through a symlink
# (idempotent; a stray real dir is moved aside first).
omarchy_state="$HOME/.local/state/omarchy"
omarchy_current="$omarchy_state/current"
if [[ -d $omarchy_current && ! -L $omarchy_current ]]; then
  mv "$omarchy_current" "$omarchy_current.pre-strata"
fi
mkdir -p "$omarchy_state"
ln -sfn "$state" "$omarchy_current"

need_apply=false

if [[ -f $name_file ]]; then
  name="$(<"$name_file")"
else
  name="sakurazuki"
  need_apply=true
fi

if [[ ! -d "$state/theme" || ! -f "$state/theme/colors.toml" ]]; then
  need_apply=true
fi

# Palette source (Theme vs Wallpaper/stock) is the user's independent choice
# via the Themes menu — never force it back to custom at login. If the theme
# tree is live, we're done.
if $need_apply; then
  echo "hexciri-theme-ensure: $name theme not live — re-applying $name"
  hexciri-theme-set "$name"
else
  echo "hexciri-theme-ensure: theme '$name' is live"
fi