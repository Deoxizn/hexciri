#!/bin/bash
# hexciri:summary=Switch the active WM/shell combo (niri|hyprland|sway|mango × noctalia|none)
# hexciri:args=wm=<wm> shell=<shell>  — e.g. "hexciri-session-set wm=hyprland"; menu picks if omitted
# hexciri:requires-sudo=true
#
# The deliberate WM-swap path (install --wm is the non-interactive fresh-install
# shortcut). Steps:
#   1. resolve the target combo (args or the System > Session picker)
#   2. pull fresh + re-exec (must not run stale bytes — same guard as the updater funnel)
#   3. install the target WM package (sudo) + generate /usr/share/wayland-sessions/${wm}.desktop
#   4. carry-over the INSTALLED config into the target WM (monitors whole-file,
#      keybinds re-rendered from intents.toml — the schema IS the carry-over)
#   5. write ~/.config/hexciri/{wm,shell} (the authoritative selector)
#   6. re-run the theme hook (hexciri-sync: per-WM borders/keybinds render)
#   7. print "log out and pick <wm> in the session picker" (current session untouched)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="${HEXCIRI_PATH:-$HOME/.local/opt/hexciri}"
[[ -d $REPO ]] || REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
SEL_DIR="$XDG_CONFIG_HOME/hexciri"
SESSION_DIR="/usr/share/wayland-sessions"

known_wm()   { case "${1:-}" in niri|hyprland|sway|mango) return 0;; *) return 1;; esac; }
known_shell(){ case "${1:-}" in noctalia|none) return 0;; *) return 1;; esac; }

# ── resolve target combo ──
want_wm=""
want_shell=""
for a in "$@"; do
  case "$a" in
    wm=*)     want_wm="${a#wm=}" ;;
    shell=*)  want_shell="${a#shell=}" ;;
  esac
done

picker() {
  local prompt="$1"; shift
  printf '%s\n' "$@" | "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt="$prompt" --lines="$#"
}
if [[ -z $want_wm ]]; then
  want_wm=$(picker "WM: " niri hyprland sway mango) || exit 0
fi
if [[ -z $want_shell ]]; then
  want_shell=$(picker "Shell: " noctalia none) || exit 0
fi
known_wm "$want_wm"   || { echo "unknown WM: $want_wm (niri|hyprland|sway|mango)" >&2; exit 1; }
known_shell "$want_shell" || { echo "unknown shell: $want_shell (noctalia|none)" >&2; exit 1; }

cur_wm="$("$SCRIPT_DIR/hexciri-session" wm)"
cur_shell="$("$SCRIPT_DIR/hexciri-session" shell)"
if [[ $want_wm == "$cur_wm" && $want_shell == "$cur_shell" ]]; then
  echo "already on $cur_wm+$cur_shell — nothing to do"
  exit 0
fi

# ── step 2: pull fresh + re-exec once (never switch on stale bytes) ──
if [[ ${HXC_SESSION_RERUN:-0} == 0 ]] && git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  behind=$(git -C "$REPO" rev-list --count HEAD..@{upstream} 2>/dev/null || echo 0)
  if (( behind > 0 )); then
    echo "pulling $behind new commit(s) before switching..."
    git -C "$REPO" pull --ff-only --quiet
    export HXC_SESSION_RERUN=1
    exec "$0" "$@"
  fi
fi

# ── step 3: install the target WM (only what it needs; no multi-GB preinstall) ──
pkg_install() {
  local wm="$1"
  case "$wm" in
    niri)     sudo pacman -S --needed --noconfirm niri 2>/dev/null || true ;;
    hyprland) sudo pacman -S --needed --noconfirm hyprland hyprlock 2>/dev/null || true ;;
    sway)     sudo pacman -S --needed --noconfirm sway swaylock 2>/dev/null || true ;;
    mango)    # AUR-only. NOT swallowed: an install failure aborts the swap so the
              # selector/session file are never written for a WM that isn't there.
              local aur=""
              command -v yay  >/dev/null 2>&1 && aur=yay
              command -v paru >/dev/null 2>&1 && aur=paru
              if [[ -n $aur ]]; then
                echo "mango ships on the AUR as 'mangowm' — installing via $aur (build may take a while)..."
                "$aur" -S --needed --noconfirm mangowm
              else
                echo "mango is AUR-only ('mangowm') and no yay/paru is installed — install it first, then re-run hexciri-session-set" >&2
                return 1
              fi
              ;;
  esac
}
if [[ $want_wm != "$cur_wm" ]]; then
  echo "installing $want_wm (this may take a moment)..."
  pkg_install "$want_wm"
fi

# ── session file: guarantee a login-gate entry exists (sddm rejects pre-session) ──
if [[ $want_wm != "$cur_wm" ]] ; then
  exec_line="/usr/bin/$want_wm"
  case "$want_wm" in
    niri) exec_line="/usr/bin/niri" ;;
    hyprland) exec_line="/usr/bin/Hyprland" ;;
    sway) exec_line="/usr/bin/sway" ;;
  esac
  sudo mkdir -p "$SESSION_DIR"
  if [[ ! -f "$SESSION_DIR/$want_wm.desktop" ]]; then
    printf '[Desktop Entry]\nName=%s\nComment=%s Wayland compositor\nExec=%s\nType=Application\n' \
      "$want_wm" "$want_wm" "$exec_line" | sudo tee "$SESSION_DIR/$want_wm.desktop" >/dev/null
    echo "session file: $SESSION_DIR/$want_wm.desktop"
  fi
fi

# ── step 4.0: seed the target WM's config dir from the repo defaults ──
# A swap into a WM that has never been installed on this box starts from the
# same files a fresh install deploys (config/<wm>/…), then the carry-over below
# overwrites the per-machine surfaces (monitors, env/input/autostart, keybinds,
# theme colors). Existing files are NEVER touched — user edits survive.
seed_wm() {
  local wm="$1"
  case "$wm" in
    niri)
      for _f in config cursors env monitors input looknfeel window-rules keybinds autostart; do
        [[ -f $REPO/config/niri/$_f.kdl && ! -f $XDG_CONFIG_HOME/niri/$_f.kdl ]] \
          && cp -f "$REPO/config/niri/$_f.kdl" "$XDG_CONFIG_HOME/niri/$_f.kdl"
      done
      ;;
    hyprland)
      mkdir -p "$XDG_CONFIG_HOME/hypr/conf"
      [[ -f $REPO/config/hypr/hyprland.lua && ! -f $XDG_CONFIG_HOME/hypr/hyprland.lua ]] \
        && cp -f "$REPO/config/hypr/hyprland.lua" "$XDG_CONFIG_HOME/hypr/hyprland.lua"
      for _f in env input monitors looknfeel window-rules keybinds autostart; do
        [[ -f $REPO/config/hypr/conf/$_f.lua && ! -f $XDG_CONFIG_HOME/hypr/conf/$_f.lua ]] \
          && cp -f "$REPO/config/hypr/conf/$_f.lua" "$XDG_CONFIG_HOME/hypr/conf/$_f.lua"
      done
      ;;
    sway)
      mkdir -p "$XDG_CONFIG_HOME/sway/conf.d"
      [[ -f $REPO/config/sway/config && ! -f $XDG_CONFIG_HOME/sway/config ]] \
        && cp -f "$REPO/config/sway/config" "$XDG_CONFIG_HOME/sway/config"
      for _f in input monitors looknfeel window-rules keybinds autostart; do
        [[ -f $REPO/config/sway/conf.d/$_f.conf && ! -f $XDG_CONFIG_HOME/sway/conf.d/$_f.conf ]] \
          && cp -f "$REPO/config/sway/conf.d/$_f.conf" "$XDG_CONFIG_HOME/sway/conf.d/$_f.conf"
      done
      mkdir -p "$XDG_CONFIG_HOME/environment.d"
      [[ -f $REPO/config/sway/environment.d/10-hexciri.conf && ! -f $XDG_CONFIG_HOME/environment.d/10-hexciri.conf ]] \
        && cp -f "$REPO/config/sway/environment.d/10-hexciri.conf" "$XDG_CONFIG_HOME/environment.d/10-hexciri.conf"
      ;;
    mango)
      mkdir -p "$XDG_CONFIG_HOME/mango"
      [[ -f $REPO/config/mango/config.conf && ! -f $XDG_CONFIG_HOME/mango/config.conf ]] \
        && cp -f "$REPO/config/mango/config.conf" "$XDG_CONFIG_HOME/mango/config.conf"
      for _f in env input monitors looknfeel window-rules keybinds autostart; do
        [[ -f $REPO/config/mango/$_f.conf && ! -f $XDG_CONFIG_HOME/mango/$_f.conf ]] \
          && cp -f "$REPO/config/mango/$_f.conf" "$XDG_CONFIG_HOME/mango/$_f.conf"
      done
      ;;
  esac
}
if [[ $want_wm != "$cur_wm" ]]; then
  echo "seeding $want_wm config defaults (missing files only)..."
  seed_wm "$want_wm"
fi

# ── step 4: carry-over the INSTALLED config into the target WM ──
# Monitors: the only whole-file surface. Read the CURRENT WM's live output layout
# (the machine's real scale/positions — never the repo template) and write it
# into the target WM's monitor fragment. env/input/autostart go through
# hexciri-config-render (rendered from the live niri fragments). Keybinds are
# NOT copied: the intent schema is the carry-over; step 6 re-renders them.
monitors_from=""
case "$cur_wm" in
  niri)
    if [[ -f $XDG_CONFIG_HOME/niri/monitors.kdl ]]; then
      monitors_from="$XDG_CONFIG_HOME/niri/monitors.kdl"
    elif [[ -f $XDG_CONFIG_HOME/niri/config.kdl ]] \
         && ! grep -q '^include "' "$XDG_CONFIG_HOME/niri/config.kdl"; then
      monitors_from="$XDG_CONFIG_HOME/niri/config.kdl"
    fi
    ;;
  hyprland)
    if [[ -f $XDG_CONFIG_HOME/hypr/conf/monitors.lua ]]; then
      monitors_from="$XDG_CONFIG_HOME/hypr/conf/monitors.lua"
    elif [[ -f $XDG_CONFIG_HOME/hypr/conf/monitors.conf ]]; then
      monitors_from="$XDG_CONFIG_HOME/hypr/conf/monitors.conf"
    fi
    ;;
  sway)
    monitors_from="$XDG_CONFIG_HOME/sway/conf.d/monitors.conf"
    ;;
  mango)
    monitors_from="$XDG_CONFIG_HOME/mango/monitors.conf"
    ;;
esac

if [[ -n $monitors_from && -f $monitors_from && $want_wm != "$cur_wm" ]]; then
  case "$want_wm" in
    hyprland)
      hypr_dir="$XDG_CONFIG_HOME/hypr/conf"
      mkdir -p "$hypr_dir"
      python3 - "$monitors_from" "$hypr_dir/monitors.lua" <<'PYEOF'
import re, sys
src, dst = sys.argv[1], sys.argv[2]
txt = open(src).read()
blocks = []

def lua_monitor(name, mode, pos, scale, vrr):
    out = ["hl.monitor({"]
    if name:
        out.append(f'    output = "{name}",')
    if mode:
        out.append(f'    mode = "{mode}",')
    if pos:
        out.append(f'    position = "{pos}",')
    if scale:
        out.append(f'    scale = {scale},')
    if vrr:
        out.append("    vrr = 1,")
    out.append("})")
    return "\n".join(out)

src_wm = "niri/sway"
# (1) hyprland already: hl.monitor blocks pass through as-is
if "hl.monitor(" in txt:
    blocks.append(txt.strip())
    src_wm = "hyprland"
# (2) niri/sway `output "X" { ... }` blocks (niri: mode "2880x1920@120", scale,
#     position x/y, variable-refresh-rate; sway: scale/mode/position/adaptive_sync)
for blk in re.finditer(r'output\s+"([^"]+)"\s*\{(.*?)\}', txt, re.S):
    name = blk.group(1).strip().strip('"')
    body = blk.group(2)
    mode  = re.search(r'mode\s+"?([\d.]+x[\d.]+@[\d.]+)"?', body)
    scale = re.search(r'scale\s+([\d.]+)', body)
    pos   = re.search(r'position\s+(?:x=)?(-?[\d.]+)[,\s]+(?:y=)?(-?[\d.]+)', body)
    vrr   = "variable-refresh-rate" in body or "adaptive_sync" in body
    blocks.append(lua_monitor(
        name,
        mode and mode.group(1),
        pos and f"{pos.group(1)}x{pos.group(2)}",
        scale and scale.group(1),
        vrr,
    ))
    src_wm = "niri/sway"
# (3) legacy hyprland `monitor = name,res@rate,pos,scale` lines
for m in re.finditer(r'monitor\s*=\s*([^,\n]+),([^,\n]+),([^,\n]+),([^,\n]+)', txt):
    name, resrate, p, s = (g.strip() for g in m.groups())
    blocks.append(lua_monitor(
        name,
        None if resrate in ("preferred", "") else resrate,
        None if p in ("auto", "") else p,
        None if s in ("auto", "") else s,
        False,
    ))
    src_wm = "hyprland"
# (4) mango monitorrule=name:...,width/height/refresh/x/y/scale/vrr
for m in re.finditer(r'monitorrule=name:([^,\s]+),(.*)$', txt, re.M):
    name = m.group(1)
    params = {}
    for kv in m.group(2).split(","):
        k, _, v = kv.partition(":")
        params[k.strip()] = v.strip()
    mode = None
    if params.get("width") and params.get("height"):
        mode = f"{params['width']}x{params['height']}" + (f"@{params['refresh']}" if params.get("refresh") else "")
    pos = None
    if params.get("x") is not None and params.get("y") is not None:
        pos = f"{params['x']}x{params['y']}"
    blocks.append(lua_monitor(
        name,
        mode,
        pos,
        params.get("scale"),
        params.get("vrr") == "1",
    ))
    src_wm = "mango"

if not blocks:
    note = "-- NOTE: no monitor entries found to carry over — the seeded defaults apply."
    body = note
else:
    body = "\n".join(blocks)
open(dst, "w").write(
    "-- hexciri — carried over from " + src_wm + " on WM swap.\n"
    "-- source = " + src + "\n"
    "-- Regenerate by hand, or swap again; hyprland.lua require()s this via hypr.conf.monitors.\n\n"
    + body + "\n"
)
print(f"carried monitors → {dst} (from {src_wm})")
PYEOF
      ;;
    sway)
      sway_dir="$XDG_CONFIG_HOME/sway/conf.d"
      mkdir -p "$sway_dir"
      cp -f "$monitors_from" "$sway_dir/monitors.conf"
      # sway output blocks are niri-compatible shape; sway needs include glob
      sway_main="$XDG_CONFIG_HOME/sway/config"
      include_line='include ~/.config/sway/conf.d/*'
      if [[ -f $sway_main ]] && ! grep -qF "$include_line" "$sway_main"; then
        printf '\n%s\n' "$include_line" >> "$sway_main"
      elif [[ ! -f $sway_main ]]; then
        printf 'include ~/.config/sway/conf.d/*\n' > "$sway_main"
      fi
      echo "carried monitors → $sway_dir/monitors.conf (from $cur_wm)"
      ;;
    niri)
      # translate hyprland monitor = ... lines → niri output { } blocks
      if [[ -n "$monitors_from" ]] && grep -q '^monitor =' "$monitors_from"; then
        niri_mon="$XDG_CONFIG_HOME/niri/monitors.kdl"
        python3 - "$monitors_from" "$niri_mon" <<'PYEOF'
import re, sys
src, dst = sys.argv[1], sys.argv[2]
mons = []
for m in re.finditer(r'monitor\s*=\s*([^,\n]+),([^,\n]+),([^,\n]+),([^,\n]+)(?:,.*)?', open(src).read()):
    name, resrate, pos, scale = (g.strip() for g in m.groups())
    if not name:
        continue  # hyprland "monitor = ,preferred,auto,1" → niri can't name blank
    x, y = pos.split("x") if "x" in pos else ("0", "0")
    lines = [f'output "{name}" {{']
    if resrate and resrate != "preferred":
        lines.append(f'    mode "{resrate}"')
    if scale:
        lines.append(f'    scale {scale}')
    lines.append(f'    position x={x} y={y}')
    lines.append("}")
    mons.append("\n".join(lines))
body = "\n\n".join(mons) if mons else "// NOTE: nothing to carry over — defaults will apply."
open(dst, "w").write("// hexciri — carried over from hyprland on WM swap.\n" +
                     f"// source = {src}\n\n" + body + "\n")
print(f"carried monitors → {dst} (from hyprland)")
PYEOF
      fi
      ;;
  esac
fi

# ── step 4b: env/input/autostart — rendered from the live niri fragments ──
# hexciri-config-render resolves the LIVE ~/.config/niri/<concern>.kdl (machine
# reality, carry-over rule) and emits the target WM's syntax. Each concern lands
# in its own fragment so the theme hook / carry-over keeps touching one file.
if [[ $want_wm != "$cur_wm" ]] && [[ -x $SCRIPT_DIR/hexciri-config-render ]]; then
  case "$want_wm" in
    niri)
      # niri → niri is a no-op (the live fragments ARE the source).
      ;;
    hyprland)
      hypr_dir="$XDG_CONFIG_HOME/hypr/conf"
      mkdir -p "$hypr_dir"
      for concern in env input autostart; do
        "$SCRIPT_DIR/hexciri-config-render" "$concern" hyprland > "$hypr_dir/$concern.lua"
      done
      # base Lua entry: require() all the concerns. monitors/keybinds/looknfeel
      # are written by their own steps at this point (style: seed_wm then the
      # carry-overs); this fallback only fires when the repo defaults are gone.
      hypr_main="$XDG_CONFIG_HOME/hypr/hyprland.lua"
      if [[ ! -f $hypr_main ]]; then
        printf '%s\n' \
          '-- hexciri — generated on WM swap; carry-over from niri.' \
          '-- require() pulls the per-concern fragments in conf/.' \
          '' \
          'require("hypr.conf.env")' \
          'require("hypr.conf.input")' \
          'require("hypr.conf.monitors")' \
          'require("hypr.conf.looknfeel")' \
          'require("hypr.conf.window-rules")' \
          'require("hypr.conf.keybinds")' \
          'require("hypr.conf.autostart")' \
          > "$hypr_main"
      fi
      echo "carried env/input/autostart → $hypr_dir/{env,input,autostart}.lua"
      ;;
    sway)
      # env has no sway directive — the writer drops KEY=VALUE into
      # ~/.config/environment.d/10-hexciri.conf (imported by the session command)
      envdest="$XDG_CONFIG_HOME/environment.d/10-hexciri.conf"
      envsrc="$(mktemp)"
      mkdir -p "$(dirname "$envdest")"
      "$SCRIPT_DIR/hexciri-config-render" env niri > "$envsrc"
      python3 - "$envsrc" "$envdest" <<'PYEOF'
import re, sys
src, dst = sys.argv[1], sys.argv[2]
raw = open(src).read()
lines = []
for m in re.finditer(r'^\s*([A-Za-z_][A-Za-z0-9_]*)\s+"([^"]*)"', raw, re.M):
    k, v = m.group(1), m.group(2)
    if k == "XDG_CURRENT_DESKTOP":
        v = "sway"
    lines.append(f"{k}={v}")
open(dst, "w").write("# hexciri — environment + sway (rendered from niri env fragment on WM swap)\n" +
                     "\n".join(lines) + "\n")
print(f"env → {dst} (environment.d)")
PYEOF
      rm -f "$envsrc"
      sway_dir="$XDG_CONFIG_HOME/sway/conf.d"
      mkdir -p "$sway_dir"
      "$SCRIPT_DIR/hexciri-config-render" input sway  > "$sway_dir/input.conf"
      "$SCRIPT_DIR/hexciri-config-render" autostart sway > "$sway_dir/autostart.conf"
      echo "carried env/input/autostart → sway (environment.d + conf.d)"
      ;;
    mango)
      mango_dir="$XDG_CONFIG_HOME/mango"
      mkdir -p "$mango_dir"
      # mango supports source= (docs: "Sub-Configuration") — keep the concern
      # split like the other targets; entry file sources the fragments.
      "$SCRIPT_DIR/hexciri-config-render" env mango       > "$mango_dir/env.conf"
      "$SCRIPT_DIR/hexciri-config-render" input mango     > "$mango_dir/input.conf"
      "$SCRIPT_DIR/hexciri-config-render" autostart mango > "$mango_dir/autostart.conf"
      mango_main="$mango_dir/config.conf"
      if [[ ! -f $mango_main ]]; then
        printf '%s\n' \
          '# hexciri — generated on WM swap; carry-over from niri (v1.5 experimental).' \
          'source-optional=$HOME/.config/mango/env.conf' \
          'source-optional=$HOME/.config/mango/input.conf' \
          'source-optional=$HOME/.config/mango/monitors.conf' \
          'source-optional=$HOME/.config/mango/looknfeel.conf' \
          'source-optional=$HOME/.config/mango/window-rules.conf' \
          'source-optional=$HOME/.config/mango/keybinds.conf' \
          'source-optional=$HOME/.config/mango/autostart.conf' \
          > "$mango_main"
      fi
      echo "carried env/input/autostart → $mango_dir/{env,input,autostart}.conf"
      ;;
  esac
fi
mkdir -p "$SEL_DIR"
echo "$want_wm"    > "$SEL_DIR/wm"
echo "$want_shell" > "$SEL_DIR/shell"
echo "selector: ~/.config/hexciri/wm = $want_wm  shell = $want_shell"

# ── step 6: regenerate (bin re-link + keybinds render + theme hook: borders) ──
# Keybinds: the intent schema is the carry-over — re-render the target
# WM's keybind fragment from intents.toml so custom intent rows follow the swap
# (the seeded repo snapshot is only the fallback the master renders agree on).
if [[ $want_wm != "$cur_wm" ]] && [[ -x $SCRIPT_DIR/hexciri-keybinds-render ]]; then
  case "$want_wm" in
    hyprland) mkdir -p "$XDG_CONFIG_HOME/hypr/conf"; "$SCRIPT_DIR/hexciri-keybinds-render" hyprland > "$XDG_CONFIG_HOME/hypr/conf/keybinds.lua" ;;
    sway)     mkdir -p "$XDG_CONFIG_HOME/sway/conf.d"; "$SCRIPT_DIR/hexciri-keybinds-render" sway     > "$XDG_CONFIG_HOME/sway/conf.d/keybinds.conf" ;;
    mango)    mkdir -p "$XDG_CONFIG_HOME/mango";    "$SCRIPT_DIR/hexciri-keybinds-render" mango    > "$XDG_CONFIG_HOME/mango/keybinds.conf" ;;
    niri)     ;;  # committed static snapshot (config/niri/keybinds.kdl); nothing to do
  esac
  echo "re-rendered keybinds for $want_wm (from config/keybinds/intents.toml)"
fi
"$SCRIPT_DIR/hexciri-update-hexciri" >/dev/null 2>&1 || true
# Per-WM borders: re-run the theme hook so the target WM's looknfeel fragment
# (seeded in step 4.0) gets the active theme's colors. Idempotent — the hook
# only patches files that exist, and colors are already right on a healthy box.
if command -v hexciri-hook >/dev/null 2>&1; then
  _hook=hexciri-hook
elif [[ -x $SCRIPT_DIR/hexciri-hook ]]; then
  _hook="$SCRIPT_DIR/hexciri-hook"
else
  _hook=""
fi
if [[ -n $_hook ]] && [[ -d $HOME/.local/state/hexciri/current/theme ]]; then
  _tname="sakurazuki"
  [[ -f $HOME/.local/state/hexciri/current/theme.name ]] && _tname="$(<"$HOME/.local/state/hexciri/current/theme.name")"
  "$_hook" theme-set "$_tname" >/dev/null 2>&1 || true
  echo "re-applied theme borders for $want_wm (theme '$_tname')"
fi

# ── step 7 ──
echo
echo "Switched selector to $want_wm + $want_shell (carried over from $cur_wm+$cur_shell)."
echo "Log out and pick '$want_wm' in the session picker — the current session is untouched."