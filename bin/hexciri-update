#!/bin/bash
# hexciri:summary=Update controller: system update (bare), framework sync (self), hardware, menu
# hexciri:args=[self|sys|hardware|menu|refresh-boot|help] [args]
#
# One controller for every update-related command. Names that used to be
# separate scripts are now symlinks into this file and dispatch on argv[0]:
#   hexciri-update          full system update (repo pkgs + AUR + reboot offer)
#   hexciri-update self     (was hexciri-update-hexciri) pull the framework repo
#   hexciri-update-run      deprecated alias of the system update (kept)
#   hexciri-update-hardware restart-audio/wifi/bluetooth/trackpad menu
#   hexciri-update-menu     the Update submenu (root menu ▸ Update)
#   hexciri-refresh-boot    re-apply layer state (links, menu curation, firewall, sshd)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" 2>/dev/null && pwd || dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
bindir="${HEXCIRI_BIN_DIR:-$SCRIPT_DIR}"

# ── migrate the noctalia arch-updater plugin to the renamed updater ──
# Runs unconditionally and BEFORE any prompt/gate: a user who cancels the
# system update at the "Run system update?" confirm (or runs in a context
# without input) should still pay off a stale update_cmd — otherwise the press
# that pulls the fix silently defers it. Idempotent.
ST="$HOME/.local/state/noctalia/settings.toml"
if [[ -f $ST ]] && grep -q 'update_cmd = "hexciri-update-run"' "$ST"; then
  sed -i 's|update_cmd = "hexciri-update-run"|update_cmd = "hexciri-update"|' "$ST"
  echo "arch-updater plugin: update_cmd migrated to hexciri-update"
fi

# ══════════════════════════════════════════════ hexciri-update (bare)
# Safe system update: repo pkgs + AUR + reboot prompt on kernel change.
# usage: hexciri-update [self|...] ; bare = system update (--yes accepted)
update_sys() {
  # ── one-shot self-heal: pull the framework, then RE-EXEC our freshly-pulled
  # ── bytes so every step below (confirm, migrations, pacman) runs the NEWEST
  # ── code in this press. A self-updating script keeps running its own old bytes
  # ── until it re-execs; without this, a fix shipped by the pull (updater rename,
  # ── plugin update_cmd migration, whatever ships next) only lands on the NEXT
  # ── press — the "press once, walk away" hole. HXC_RERUN=1 on the re-exec
  # ── skips the pull so the pass always terminates. ──
  if [[ ${HXC_RERUN:-0} == 0 ]]; then
    export HXC_RERUN=1
    "$SCRIPT_DIR/hexciri-update-hexciri" || echo "framework self-update skipped/failed (continuing)"
    exec "$0" "$@"
  fi

  local YES=false
  [[ ${1:-} == "--yes" || ${1:-} == "-y" ]] && YES=true
  confirm() { $YES && return 0; read -rp "$1 [y/N] " r; [[ $r =~ ^[Yy]$ ]]; }

  local LOG="$HOME/.local/state/hexciri/update.log"
  mkdir -p "$(dirname "$LOG")"

  # ~2G free on / or stop before a half-finished transaction
  local avail_kb
  avail_kb=$(df -k / --output=avail | tail -n 1)
  (( avail_kb > 2*1024*1024 )) || { echo "hexciri-update: <2G free on / — free space first"; exit 1; }

  # ── password-locked default keyring is the #1 recurring "browser lost sync"
  # ── breaker: the gcr prompt UI that should ask for it crashes on this
  # ── desktop, so Brave/Chromium can't reach Sync/credentials and keep
  # ── re-provisioning. On a fingerprint-login machine pam_gnome_keyring
  # ── never receives the account password, so PAM can neither create nor
  # ── auto-unlock a login keyring — that path is a dead end on this
  # ── hardware. The correct fix is an empty-password default keyring which
  # ── gnome-keyring auto-opens at every boot with no prompt and no PAM.
  # ── We detect a locked default collection here, report it clearly, and
  # ── tell the user how to recreate via `secret-tool store` + the gcr
  # ── dialog (leave password blank). We do NOT kill daemons (causes
  # ── SIGSEGV when the prompt object races the service) or delete files. ──
  gkr_ensure() {
    command -v python3 >/dev/null 2>&1 || return 0
    [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] || return 0
    local locked
    locked="$(python3 - 2>/dev/null <<'PY' || true
import sys
try:
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio, GLib
except Exception:
    sys.exit(0)
try:
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    def call(dest, obj, iface, method, args):
        p = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None, dest, obj, iface, None)
        return p.call_sync(method, args, 0, -1, None)
    cols = call('org.freedesktop.secrets', '/org/freedesktop/secrets',
                'org.freedesktop.DBus.Properties', 'Get',
                GLib.Variant('(ss)', ('org.freedesktop.Secret.Service', 'Collections'))).unpack()[0]
    for path in cols:
        lbl = call('org.freedesktop.secrets', path, 'org.freedesktop.DBus.Properties', 'Get',
                   GLib.Variant('(ss)', ('org.freedesktop.Secret.Collection', 'Label'))).unpack()[0]
        if lbl == 'session':
            continue
        locked = call('org.freedesktop.secrets', path, 'org.freedesktop.DBus.Properties', 'Get',
                      GLib.Variant('(ss)', ('org.freedesktop.Secret.Collection', 'Locked'))).unpack()[0]
        if not locked:
            continue
        # An empty-password keyring reports Locked=True until something first
        # touches it at boot, then auto-unlocks with NO prompt. Distinguish
        # that healthy case from a genuinely password-locked one by attempting
        # the unlock and re-reading the flag.
        call('org.freedesktop.secrets', '/org/freedesktop/secrets',
             'org.freedesktop.Secret.Service', 'Unlock',
             GLib.Variant('(ao)', ([path],)))
        locked = call('org.freedesktop.secrets', path, 'org.freedesktop.DBus.Properties', 'Get',
                      GLib.Variant('(ss)', ('org.freedesktop.Secret.Collection', 'Locked'))).unpack()[0]
        if locked:
            sys.stdout.write('LOCKED')
            break
except Exception:
    pass
PY
  )"
    [[ $locked == LOCKED ]] || return 0
    echo "keyring: default keyring is password-locked — browser prompts/breaks every boot"
    echo "keyring: fix in one step:"
    echo "keyring:   secret-tool store --label=default fixcheck fixkey"
    echo "keyring:   leave password BLANK in both fields, confirm"
    echo "keyring:   an empty-password keyring auto-opens every boot — no prompts, no PAM"
  }
  gkr_ensure

  confirm "Run system update? (repo + AUR)" || { echo "cancelled"; exit 0; }

  # Validate sudo up front (the pacman transaction needs it anyway) so the repo
  # sync's one-time legacy /usr/local/bin purge (sudo -n) succeeds here, where
  # root is already granted.
  sudo -v || { echo "sudo needed for the system update"; exit 1; }

  # xwayland-satellite pin (upstream #468): 0.8.2 regressed popup positioning
  # (commit 3273a0f) — X11 dropdowns (Steam menus, etc.) spawn offset and lose
  # hover on niri. Hold BEFORE the Syu below so a pinned 0.8.1 can't ride back
  # up, then downgrade a buggy 0.8.2 while outside any transaction. Root
  # hexciri-sync (§6) re-asserts the hold every pass; install.sh covers fresh
  # boxes. Drop when a fixed 0.8.3+ lands in the repos.
  if grep -Eq '^IgnorePkg.*xwayland-satellite' /etc/pacman.conf 2>/dev/null; then
    :
  elif grep -Eq '^IgnorePkg[[:space:]]*=' /etc/pacman.conf 2>/dev/null; then
    sudo sed -Ei 's/^(IgnorePkg[^#]*)(#.*)?$/\1 xwayland-satellite \2/' /etc/pacman.conf && \
      echo "pacman: held xwayland-satellite (IgnorePkg)" || \
      echo "pacman hold skipped — add by hand: IgnorePkg = xwayland-satellite in /etc/pacman.conf"
  elif grep -Eq '^#IgnorePkg[[:space:]]*=' /etc/pacman.conf 2>/dev/null; then
    sudo sed -Ei '0,/^#IgnorePkg[[:space:]]*=.*/s//IgnorePkg = xwayland-satellite/' /etc/pacman.conf && \
      echo "pacman: held xwayland-satellite (IgnorePkg)" || \
      echo "pacman hold skipped — add by hand: IgnorePkg = xwayland-satellite in /etc/pacman.conf"
  else
    printf '\nIgnorePkg = xwayland-satellite\n' | sudo tee -a /etc/pacman.conf >/dev/null && \
      echo "pacman: held xwayland-satellite (IgnorePkg)" || \
      echo "pacman hold skipped — add by hand: IgnorePkg = xwayland-satellite in /etc/pacman.conf"
  fi
  if pacman -Q xwayland-satellite 2>/dev/null | grep -q ' 0\.8\.2'; then
    echo "downgrading xwayland-satellite 0.8.2 → 0.8.1 (upstream #468 popup regression)"
    sudo pacman -U --noconfirm https://archive.archlinux.org/packages/x/xwayland-satellite/xwayland-satellite-0.8.1-2-x86_64.pkg.tar.zst || \
      echo "downgrade skipped — run by hand: sudo pacman -U https://archive.archlinux.org/packages/x/xwayland-satellite/xwayland-satellite-0.8.1-2-x86_64.pkg.tar.zst"
  fi

  # Re-apply the alpm hook from the pulled tree now that root is granted. The
  # hook only self-refreshes while a package transaction actually runs, so a
  # no-op update (nothing to upgrade) never fired it — a stale hook (e.g. missing
  # the gnome-keyring target) would linger on boxes that keep coming up empty.
  local REPO="${HEXCIRI_PATH:-$HOME/.local/opt/hexciri}"
  if [[ -f $REPO/default/alpm/hexciri-sync.hook ]] && ! cmp -s "$REPO/default/alpm/hexciri-sync.hook" /usr/share/libalpm/hooks/hexciri-sync.hook 2>/dev/null; then
    sudo install -m644 "$REPO/default/alpm/hexciri-sync.hook" /usr/share/libalpm/hooks/hexciri-sync.hook && \
      echo "alpm hook re-applied (newer targets active from the next transaction)"
  fi

  # Pull + apply framework commits already happened at the top (self-heal re-exec),
  # and the plugin update_cmd migration ran unconditionally before the confirm.

  {
    echo "=== $(date -Is) ==="
    sudo pacman -Syu --noconfirm
    # Kernels and drivers are CachyOS's and update above like everything else;
    # there is no separate refresh loop anymore.
    if command -v yay &>/dev/null && pacman -Qmq 2>/dev/null | grep -qv yay-bin; then
      yay -Sua --noconfirm 2>&1 | grep -v 'Missing AUR Debug Packages' || true
    fi
  } 2>&1 | tee -a "$LOG"

  # ── re-apply hexciri sync state: the alpm hook only fires when a tracked
  # ── package actually changed, so a no-op update never ran it. Running it
  # ── here — every press — guarantees links, menu curation, firewall and sshd
  # ── land even when pacman had nothing to do. Idempotent; the hook stays
  # ── for plain `pacman -Syu`. ──
  # ── hexciri-sync now reports only real changes, so a no-op press silently
  # ── skips — no header, no "nothing to do" theater. ──
  local sync_out
  sync_out="$(sudo "$REPO/bin/hexciri-sync" 2>&1)" || sync_out+=$'\nhexciri-sync step failed (continuing)'
  if [[ -n $sync_out ]]; then
    echo "[Hexciri]"
    printf '%s\n' "$sync_out"
  fi

  # Reboot offer only when the kernel hexciri is pinned to boot differs from the
  # one currently running.
  local running expected entry pin e vmlinuz pkg d
  running=$(uname -r)
  expected=""

  pin=/usr/share/hexciri/boot-default
  entry=""
  if [[ -r $pin ]]; then
    e="$(cat "$pin" 2>/dev/null || true)"
    [[ -f /boot/loader/entries/$e ]] && entry="$e"
  fi
  if [[ -z $entry && -r /boot/loader/loader.conf ]]; then
    e="$(awk '$1=="default"{print $2}' /boot/loader/loader.conf 2>/dev/null)"
    [[ -f /boot/loader/entries/$e ]] && entry="$e"
  fi

  if [[ -n $entry ]]; then
    vmlinuz="$(awk '$1=="linux"{print $2; exit}' "/boot/loader/entries/$entry" 2>/dev/null)"
    pkg="${vmlinuz##*/}"; pkg="${pkg#vmlinuz-}"
    for d in /usr/lib/modules/*; do
      [[ -d $d ]] || continue
      if pacman -Qqo "$d" 2>/dev/null | grep -qx "$pkg"; then
        expected="${d##*/}"; break
      fi
    done
  fi
  [[ -n $expected ]] || expected="$(ls -1 /usr/lib/modules/ 2>/dev/null | sort -V | tail -n 1)"

  if [[ -n $expected && $expected != "$running" ]]; then
    echo "kernel: $running -> $expected (a different kernel is now the boot default)"
    # Always ask, even under --yes: --yes answers the update question, never reboot.
    read -rp "Reboot now? [y/N] " r || true; [[ $r =~ ^[Yy]$ ]] && systemctl reboot || true
  else
    echo "update complete."
  fi
}

# ══════════════════════════════════════════════ hexciri-update-hexciri
# Hexciri repo sync: pull newer commits. Nothing new → says up to date and stops.
update_self() {
  local REPO="${HEXCIRI_PATH:-$HOME/.local/opt/hexciri}"
  if [[ ! -d $REPO ]]; then
    echo "hexciri repo not found at: $REPO"
    echo "expected the bootstrap clone at ~/.local/opt/hexciri"
    exit 1
  fi

  # Section header printed once per pass (survives the pull/re-exec via env).
  if [[ ${HXC_SECTION:-0} == 0 ]]; then
    echo "[Hexciri]"
    export HXC_SECTION=1
  fi

  relink() {
    mkdir -p "$HOME/.local/bin"
    for f in "$REPO"/bin/*; do
      [[ -f $f ]] || continue   # dirs (e.g. __pycache__) must not end the loop's status
      ln -sfn "$REPO/bin/$(basename "$f")" "$HOME/.local/bin/$(basename "$f")" || true
    done
    # prune stale names: a ~/.local/bin/hexciri-* entry whose source file is gone
    # from repo/bin (consolidation removes scripts) must not keep dangling.
    local b
    for b in "$HOME"/.local/bin/hexciri-*; do
      [[ -e $b || -L $b ]] || continue
      [[ -e "$REPO/bin/$(basename "$b")" ]] || rm -f "$b"
    done
    return 0
  }

  # NOTE: theme-content syncing (omarchy defaults + extras pulls) deliberately
  # lives ONLY in the Update > Themes job — not here. It's network-heavy and
  # noisy, and every bare system update funnels through update_self first, so
  # riding along here spams theme pulls into unrelated runs.

  # cfg/ layout: only config.kdl lives in ~/.config/niri/, fragments live in
  # ~/.config/niri/cfg/ (CachyOS-with-niri layout). One-time: move flat live
  # fragments the old layout left behind into cfg/ — never clobber: a cfg/
  # copy already there always wins, and the live file is a per-machine
  # authoring.
  migrate_niri_cfg_dir() {
    local ndir="${XDG_CONFIG_HOME:-$HOME/.config}/niri" frag
    [[ -d $ndir ]] || return 0
    mkdir -p "$ndir/cfg"
    for frag in autostart cursors env input looknfeel monitors window-rules keybinds; do
      [[ -f "$ndir/$frag.kdl" && ! -f "$ndir/cfg/$frag.kdl" ]] || continue
      mv -f "$ndir/$frag.kdl" "$ndir/cfg/$frag.kdl" && \
        echo "moved niri fragment into cfg/ ($frag.kdl)"
    done
  }

  # Keybind fragment: shipped file seeds the live config only when absent.
  # A live file from elsewhere (e.g. stock CachyOS-with-niri binds) is adapted
  # to ours ONCE: rebuilt as repo base + stock-only combos appended under a
  # marker. Later runs and later user edits are never touched again.
  sync_keybinds() {
    command -v niri >/dev/null 2>&1 || return 0   # no niri here (e.g. MangoWM box) — push no niri configs
    migrate_niri_cfg_dir
    # pre-0.1.3 one-time: legacy configs have no environment PATH line, so niri
    # can't find the ~/.local/bin commands. Inject only if missing; idempotent.
    "$REPO/bin/hexciri-migrate-niri-path" 2>/dev/null || true
    local src="$REPO/config/niri/cfg/keybinds.kdl"
    local dst="$HOME/.config/niri/cfg/keybinds.kdl"
    [[ -f $src ]] || return 0
    if [[ ! -f $dst && ! -L $dst ]]; then
      mkdir -p "$(dirname "$dst")"
      cp -f "$src" "$dst"
      echo "seeded niri keybinds ($dst)"
      return 0
    fi
    adapt_stock_keybinds "$src" "$dst"
    sync_new_binds "$src" "$dst"
  }

  # Hyprland overlay deploy: the hexciri fragments (hexciri-binds.lua,
  # hexciri-autostart.lua) ship in the repo and seed/refresh the live config
  # like hooks do — manifest-tracked, so a live file the user made theirs is
  # never overwritten. Then the requires in hyprland.lua are asserted (backed
  # up on first edit) so the overlays load AFTER the stock config.* fragments
  # and win on shared combos. Finally pins ~/.config/hexciri/wm so
  # hexciri-session resolves hyprland deterministically (incl. ssh bring-up).
  sync_hyprland() {
    command -v Hyprland >/dev/null 2>&1 || command -v hyprland >/dev/null 2>&1 || return 0
    local src="$REPO/config/hypr/config" dst="$HOME/.config/hypr/config"
    local main="$HOME/.config/hypr/hyprland.lua"
    local rev manifest f rel entry oldrev found r custom
    [[ -d $src && -d $dst ]] || return 0
    [[ -f $main ]] || return 0
    rev="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo unknown)"
    manifest="$dst/.hexciri-manifest"
    owned() {
      [[ -f $manifest ]] || return 1
      entry="$(grep -E "^[0-9a-f]{40} $1\$" "$manifest" 2>/dev/null | head -n 1 || true)"
      [[ -n $entry ]] || return 1
      printf '%s' "${entry%% *}"
    }
    record_owned() {
      grep -vE "^[0-9a-f]{40} $2\$|^! $2\$|^#[0-9a-f]+$" "$manifest" 2>/dev/null > "$manifest.tmp" || true
      printf '%s %s\n' "$1" "$2" >> "$manifest.tmp"
      mv -f "$manifest.tmp" "$manifest"
    }
    record_custom() {
      if ! grep -qxF "! $1" "$manifest" 2>/dev/null; then
        printf '! %s\n' "$1" >> "$manifest"
      fi
    }
    while IFS= read -r f; do
      rel="${f#$src/}"
      [[ $rel == *.lua ]] || continue
      # hexciri-layout.lua is owned by the layout cycler (rewritten per
      # press) — seeded + required below, never manifest-tracked here, or
      # every update would fight the live value.
      [[ $rel == hexciri-layout.lua ]] && continue
      if [[ ! -f $dst/$rel ]]; then
        if cp -f "$f" "$dst/$rel" 2>/dev/null; then
          echo "seeded hyprland overlay ($rel)"
          [[ $rev != unknown ]] && record_owned "$rev" "$rel"
        fi
        continue
      fi
      if grep -qxF "! $rel" "$manifest" 2>/dev/null; then
        continue
      fi
      if oldrev="$(owned "$rel")"; then
        if git -C "$REPO" show "$oldrev:config/hypr/config/$rel" 2>/dev/null | cmp -s - "$dst/$rel"; then
          if ! cmp -s "$f" "$dst/$rel" 2>/dev/null; then
            cp -f "$f" "$dst/$rel" 2>/dev/null && echo "refreshed hyprland overlay ($rel)" || true
          fi
          [[ $rev != unknown ]] && record_owned "$rev" "$rel"
        else
          record_custom "$rel"
          echo "kept custom hyprland overlay ($rel)"
        fi
        continue
      fi
      # No record: classify via git history (pre-manifest seed or user file).
      found=""
      custom=""
      if [[ $rev != unknown ]]; then
        found="$(git -C "$REPO" log --format=%H -- "config/hypr/config/$rel" 2>/dev/null | \
          while IFS= read -r r; do
            [[ -n $r ]] || continue
            if git -C "$REPO" show "$r:config/hypr/config/$rel" 2>/dev/null | cmp -s - "$dst/$rel"; then
              echo "$r"; break
            fi
          done || true)"
      fi
      if [[ -z $found ]]; then
        record_custom "$rel"
        echo "kept custom hyprland overlay ($rel)"
      elif cmp -s "$f" "$dst/$rel" 2>/dev/null; then
        record_owned "$found" "$rel"
      else
        cp -f "$f" "$dst/$rel" 2>/dev/null && echo "refreshed hyprland overlay ($rel)" || true
        [[ $rev != unknown ]] && record_owned "$rev" "$rel"
      fi
    done < <(find "$src" -type f 2>/dev/null || true)

    # Assert the requires: hexciri-binds AFTER config.binds, hexciri-autostart
    # AFTER config.autostart (last require wins for a given combo). Back the
    # main file up once so a user can diff what changed.
    if ! grep -q 'require("config.hexciri-binds")' "$main" 2>/dev/null; then
      cp -f "$main" "$main.hexciri.bak" 2>/dev/null || true
      if grep -q 'require("config.binds")' "$main" 2>/dev/null; then
        sed -i '/require("config.binds")/a require("config.hexciri-binds")' "$main"
      elif grep -q 'require("config.binds.lua")' "$main" 2>/dev/null; then
        sed -i '/require("config.binds.lua")/a require("config.hexciri-binds")' "$main"
      fi
      if grep -q 'config.hexciri-binds' "$main" 2>/dev/null; then
        echo "hyprland: required config.hexciri-binds after stock binds"
      else
        echo "hyprland: NOTE could not place config.hexciri-binds (no stock binds require found)" >&2
      fi
    fi
    if ! grep -q 'require("config.hexciri-autostart")' "$main" 2>/dev/null; then
      cp -f "$main" "$main.hexciri.bak" 2>/dev/null || true
      if grep -q 'require("config.autostart")' "$main" 2>/dev/null; then
        sed -i '/require("config.autostart")/a require("config.hexciri-autostart")' "$main"
      fi
      if grep -q 'config.hexciri-autostart' "$main" 2>/dev/null; then
        echo "hyprland: required config.hexciri-autostart after stock autostart"
      else
        echo "hyprland: NOTE could not place config.hexciri-autostart (no stock autostart require found)" >&2
      fi
    fi

    # hexciri-layout.lua (live layout file owned by hexciri-hyprland-layout):
    # seed from the repo template when absent — never overwrite, the cycler
    # rewrites it on every press. Assert the require so the file loads.
    if [[ ! -f $dst/hexciri-layout.lua && -f $src/hexciri-layout.lua ]]; then
      if cp -f "$src/hexciri-layout.lua" "$dst/hexciri-layout.lua" 2>/dev/null; then
        echo "seeded hyprland live layout (hexciri-layout.lua)"
      fi
    fi
    if ! grep -q 'require("config.hexciri-layout")' "$main" 2>/dev/null; then
      cp -f "$main" "$main.hexciri.bak" 2>/dev/null || true
      if grep -q 'require("config.hexciri-binds")' "$main" 2>/dev/null; then
        sed -i '/require("config.hexciri-binds")/a require("config.hexciri-layout")' "$main" && \
          echo "hyprland: required config.hexciri-layout after hexciri binds"
      fi
    fi

    # Neutralize stock binds that the hexciri overlay owns outright. In this
    # shell a duplicate combo STACKS (both actions fire) — the overlay being
    # required later does NOT dislodge the stock line. Comment the stock ones
    # out once (first change backs up binds.lua → binds.lua.hexciri.bak):
    #   Mod+Alt+Space      float toggle   → root menu owns it
    #   Mod+Escape         hyprctl kill   → power menu owns it
    #   Mod+Return         launch prefix  → hexciri-terminal owns it
    #   Mod+T              stock editor   → float toggle owns it
    #   Mod+L              session lock   → layout cycler owns it (lock lives on Mod+Ctrl+L)
    #   Mod+W              BROWSER=firefox (dead) → removed outright; browser lives on Mod+Shift+B
    #   Mod+Shift+S        move scratchpad→ web search owns it
    #   Mod+Shift+1..3     monitor moves  → workspace-move verb owns it
    if [[ -f $dst/hexciri-binds.lua && -f $dst/binds.lua ]]; then
      python3 - "$dst/binds.lua" <<'PYEOF'
import re, sys, shutil, os
kb = sys.argv[1]
src = open(kb).read()
pats = [
    'mainMod .. " + ALT + Space"',
    'mainMod .. " + Escape"',
    'mainMod .. " + Return"',
    'mainMod .. " + W"',
    'mainMod .. " + T"',
    'mainMod .. " + L"',
    'mainMod .. " + SHIFT + S"',
    'window.move({ monitor = MONITOR1 })',
    'window.move({ monitor = MONITOR2 })',
    'window.move({ monitor = MONITOR3 })',
]
out, changed = [], False
for line in src.split("\n"):
    if line.lstrip().startswith("--"):
        out.append(line)
        continue
    if any(p in line for p in pats):
        indent = line[:len(line) - len(line.lstrip())]
        out.append(indent + "-- [hexciri] " + line.strip())
        changed = True
    else:
        out.append(line)
if changed:
    bak = kb + ".hexciri.bak"
    if not os.path.exists(bak):
        shutil.copy2(kb, bak)
    open(kb, "w").write("\n".join(out) + ("\n" if src.endswith("\n") else "\n"))
    print("hyprland: neutralized stock binds owned by the hexciri overlay (backup: binds.lua.hexciri.bak)")
PYEOF
    fi

    # Pin the WM so hexciri-session is deterministic everywhere (ssh included).
    local wmfile="$HOME/.config/hexciri/wm"
    if [[ -f $wmfile ]] && [[ "$(tr -d '[:space:]' <"$wmfile")" == hyprland ]]; then
      :
    else
      mkdir -p "$(dirname "$wmfile")"
      printf 'hyprland\n' > "$wmfile"
      echo "hexciri: pinned WM = hyprland (~/.config/hexciri/wm)"
    fi

    # Hexciri commands live in ~/.local/bin. Niri gets a config-side PATH
    # (env.kdl injection); hyprland has none — on the CachyOS/UWSM layout the
    # ~/.config/uwsm/env file is what every compositor spawn inherits, so
    # assert ~/.local/bin there additively (backed up, rest untouched). Skips
    # non-UWSM boxes (file absent) — those source the login profile instead.
    if [[ -f $HOME/.config/uwsm/env ]] && ! grep -q '\.local/bin' "$HOME/.config/uwsm/env" 2>/dev/null; then
      cp -f "$HOME/.config/uwsm/env" "$HOME/.config/uwsm/env.hexciri.bak" 2>/dev/null || true
      {
        printf '\n# hexciri: hexciri-* commands live in ~/.local/bin (niri injects this into env.kdl instead)\n'
        printf 'export PATH="$HOME/.local/bin:$PATH"\n'
      } >> "$HOME/.config/uwsm/env"
      echo "hyprland: added ~/.local/bin to the session PATH ($HOME/.config/uwsm/env)"
    fi
  }

  adapt_stock_keybinds() {
    local src="$1" dst="$2"
    grep -q 'hexciri-adapted-stock' "$dst" 2>/dev/null && return 0
    cmp -s "$src" "$dst" && return 0
    REPO_BINDS="$src" LIVE_BINDS="$dst" python3 <<'EOF'
import os, re, shutil, time

src = os.environ["REPO_BINDS"]
dst = os.environ["LIVE_BINDS"]

def combo_key(pre):
    """Combo compare key: strip quoted values + k=v bind attributes, upper."""
    pre = re.sub(r'"[^"]*"', '', pre)
    toks = [t for t in pre.split() if '=' not in t]
    return ''.join(toks).upper() or None

def dangles(entry):
    """First spawned command with no binary on PATH (dead bind on this box)."""
    m = re.search(r'spawn(-sh)?\s+"?([^\s"]+)', entry)
    if not m:
        return None
    cmd = m.group(2)
    if '/' in cmd:
        return None if os.access(cmd, os.X_OK) else cmd
    return None if shutil.which(cmd) else cmd

def entries(text):
    """(key, full entry text) for each bind in top-level binds{} blocks."""
    out, depth, in_binds, at = [], 0, False, 0
    cur = None
    for line in text.splitlines():
        s = line.strip()
        bare = re.sub(r'"[^"]*"', '""', line)
        bal = bare.count('{') - bare.count('}')
        if cur is None:
            if re.match(r'^binds\s*\{', s) and depth == 0:
                in_binds, at = True, depth
            elif (in_binds and depth == at + 1 and s
                    and not s.startswith(("//", "/-"))):
                m = re.match(r'^(.+?)\s*\{(.*)$', s)
                if m and ';' not in re.sub(r'"[^"]*"', '', m.group(1)):
                    key = combo_key(m.group(1))
                    if key and key != "BINDS":
                        cur = [key, [line], bal]
                        if cur[2] <= 0:
                            out.append((cur[0], "\n".join(cur[1])))
                            cur = None
                        depth += bal
                        continue
        else:
            cur[1].append(line)
            cur[2] += bal
            if cur[2] <= 0:
                out.append((cur[0], "\n".join(cur[1])))
                cur = None
        depth += bal
        if in_binds and depth <= at:
            in_binds = False
    return out

repo = open(src).read()
live = open(dst).read()
repo_combos = {c for c, _ in entries(repo)}
extras, dropped = [], []
for c, t in entries(live):
    if c in repo_combos:
        continue
    pkg = dangles(t)
    if pkg:
        dropped.append((c, pkg))
        continue
    extras.append(t)

shutil.copyfile(dst, "%s.bak.%d" % (dst, int(time.time())))
if os.path.islink(dst):
    os.unlink(dst)
mark = ("// ── adapted from stock binds (one-time): combos the previous "
        "config shipped that ours doesn't define — kept below, edit freely. "
        "// hexciri-adapted-stock")
# niri allows ONE binds{} node per file (a second is a parse error), so splice
# extras INSIDE the base file's binds block, before its closing brace.
lines = repo.rstrip().split("\n")
depth, open_idx, close_idx = 0, None, None
for i, line in enumerate(lines):
    s = line.strip()
    bare = re.sub(r'"[^"]*"', '""', line)
    if open_idx is None and re.match(r'^binds\s*\{', s) and depth == 0:
        open_idx = i
    depth += bare.count('{') - bare.count('}')
    if open_idx is not None and depth == 0:
        close_idx = i
        break
unplaced = 0
if extras and open_idx is not None and close_idx is not None:
    ins = ["", mark] + list(extras)
    body = "\n".join(lines[:close_idx] + ins + lines[close_idx:]) + "\n"
else:
    if extras:
        unplaced = len(extras)
        extras = []
    body = repo.rstrip() + "\n\n" + mark + "\n"
with open(dst, "w") as f:
    f.write(body)
print("adapted stock niri binds: base is ours, kept %d stock-only bind(s), dropped %d with missing spawns (%s)"
      % (len(extras), len(dropped), dst))
for c, pkg in dropped:
    print("  dropped %s (spawns missing %s)" % (c, pkg))
if unplaced:
    print("  WARNING: base binds block not found — %d extras NOT placed" % unplaced)
EOF
  }

  # Propagate NEW repo binds to the live file (additive only): combos the repo
  # defines that were never synced and aren't live get spliced into the live
  # binds block. Conflicts (live binds it differently) are logged, never
  # overwritten; user deletions stick (recorded combos are never re-added).
  sync_new_binds() {
    local src="$1" dst="$2"
    local db="$HOME/.local/state/hexciri/keybinds-synced"
    local cdb="$HOME/.local/state/hexciri/keybinds-conflicts-reported"
    REPO_BINDS="$src" LIVE_BINDS="$dst" SYNCED_DB="$db" CONFLICTS_DB="$cdb" python3 <<'EOF'
import os, re, hashlib

src = os.environ["REPO_BINDS"]
dst = os.environ["LIVE_BINDS"]
db = os.environ["SYNCED_DB"]
cdb = os.environ.get("CONFLICTS_DB", "")

def combo_key(pre):
    pre = re.sub(r'"[^"]*"', '', pre)
    toks = [t for t in pre.split() if '=' not in t]
    return ''.join(toks).upper() or None

def entries(text):
    out, depth, in_binds, at = [], 0, False, 0
    cur = None
    for line in text.splitlines():
        s = line.strip()
        bare = re.sub(r'"[^"]*"', '""', line)
        bal = bare.count('{') - bare.count('}')
        if cur is None:
            if re.match(r'^binds\s*\{', s) and depth == 0:
                in_binds, at = True, depth
            elif (in_binds and depth == at + 1 and s
                    and not s.startswith(("//", "/-"))):
                m = re.match(r'^(.+?)\s*\{(.*)$', s)
                if m and ';' not in re.sub(r'"[^"]*"', '', m.group(1)):
                    key = combo_key(m.group(1))
                    if key and key != "BINDS":
                        cur = [key, [line], bal]
                        if cur[2] <= 0:
                            out.append((cur[0], "\n".join(cur[1])))
                            cur = None
                        depth += bal
                        continue
        else:
            cur[1].append(line)
            cur[2] += bal
            if cur[2] <= 0:
                out.append((cur[0], "\n".join(cur[1])))
                cur = None
        depth += bal
        if in_binds and depth <= at:
            in_binds = False
    return out

repo = open(src).read()
live = open(dst).read()
repo_map = {}
for c, t in entries(repo):
    repo_map.setdefault(c, t)
live_map = {}
for c, t in entries(live):
    live_map.setdefault(c, t)
synced = set()
if os.path.isfile(db):
    synced = {l.strip() for l in open(db) if l.strip()}

added, conflicts, seen = [], [], set(synced)
for c, t in repo_map.items():
    if c not in live_map:
        if c in synced:
            continue
        seen.add(c)
        added.append((c, t))
    elif live_map[c] != t:
        seen.add(c)
        conflicts.append((c, t))
    else:
        seen.add(c)

if added:
    lines = live.rstrip().split("\n")
    depth, open_idx, close_idx = 0, None, None
    for i, line in enumerate(lines):
        s = line.strip()
        bare = re.sub(r'"[^"]*"', '""', line)
        if open_idx is None and re.match(r'^binds\s*\{', s) and depth == 0:
            open_idx = i
        depth += bare.count('{') - bare.count('}')
        if open_idx is not None and depth == 0:
            close_idx = i
            break
    if open_idx is not None and close_idx is not None:
        ins = [""] + [t for _, t in added]
        live = "\n".join(lines[:close_idx] + ins + lines[close_idx:]) + "\n"
        import shutil, time
        shutil.copyfile(dst, "%s.bak.%d" % (dst, int(time.time())))
        if os.path.islink(dst):
            os.unlink(dst)
        with open(dst, "w") as f:
            f.write(live)
    else:
        print("  WARNING: live binds block not found — %d new binds NOT placed" % len(added))
        added = []
os.makedirs(os.path.dirname(db) or ".", exist_ok=True)
with open(db, "w") as f:
    f.write("\n".join(sorted(seen)) + "\n")
# Conflicts are deliberate user edits — report each one ONCE (keyed by combo
# + repo text, so a changed repo bind re-reports once), then stay silent.
# A kept-live customization must never nag on every press.
def rep_key(c, t):
    return c + ":" + hashlib.sha1(t.encode()).hexdigest()[:12]
reported = set()
if cdb and os.path.isfile(cdb):
    reported = {l.strip() for l in open(cdb) if l.strip()}
new_conflicts = [(c, t) for c, t in conflicts if rep_key(c, t) not in reported]
if cdb:
    os.makedirs(os.path.dirname(cdb) or ".", exist_ok=True)
    with open(cdb, "w") as f:
        f.write("\n".join(sorted(reported | {rep_key(c, t) for c, t in conflicts})) + "\n")
if added or new_conflicts:
    print("keybinds sync: +%d new bind(s), %d conflict(s) kept live" % (len(added), len(new_conflicts)))
    for c, t in new_conflicts:
        print("  conflict %s: live differs — left alone (edit %s by hand to take ours)" % (c, dst))
EOF
  }

  # Kitty config: seed once when absent — live file is per-machine after that.
  sync_kitty() {
    local src="$REPO/config/kitty/kitty.conf"
    local dst="$HOME/.config/kitty/kitty.conf"
    [[ -f $src ]] || return 0
    command -v kitty >/dev/null 2>&1 || return 0   # no kitty here — push nothing
    if [[ ! -f $dst ]]; then
      mkdir -p "$(dirname "$dst")"
      cp -f "$src" "$dst"
      echo "seeded kitty config ($dst)"
      return 0
    fi
    # A present config is the user's until proven otherwise: never rewrite it.
    # But stock CachyOS kitty.conf lacks the three hexciri-owned lines (fish
    # shell, nerd font, no close-confirm), leaving bash + a "running bash?"
    # prompt on every Mod+Q. Add the missing ones; present values always win.
    local added=0 key line
    while IFS= read -r line; do
      key=${line%% *}
      if ! grep -qE "^[[:space:]]*$key([[:space:]]|$)" "$dst"; then
        if (( added == 0 )); then
          printf '\n# hexciri-owned lines below (added: missing from stock; edit freely — present values are never changed)\n' >>"$dst"
        fi
        printf '%s\n' "$line" >>"$dst"
        added=1
      fi
    done < <(printf '%s\n' "shell fish" "font_family MesloLGS Nerd Font Mono" "confirm_os_window_close 0")
    (( added )) && echo "kitty config: added missing hexciri-owned lines ($dst)"
    return 0
  }

  # fastfetch config: seed when absent; refresh when the live file matches a
  # past repo revision (unmodified seed — safe to advance); keep silently when
  # it matches the current one, and keep-as-custom when it matches none (the
  # user made it theirs). No manifest, no rm dance — git history is the record.
  sync_fastfetch() {
    local src="$REPO/config/fastfetch/config.jsonc"
    local dst="$HOME/.config/fastfetch/config.jsonc"
    local r found=""
    [[ -f $src ]] || return 0
    # The hexciri logo the config points at (source hexciri-nb.png) ships in
    # repo branding but was never deployed — without it fastfetch falls back
    # to the distro logo. Copy when missing or stale.
    if [[ -f $REPO/branding/hexciri-nb.png ]]; then
      mkdir -p "$(dirname "$dst")"
      if [[ ! -f $HOME/.config/fastfetch/hexciri-nb.png ]] || ! cmp -s "$REPO/branding/hexciri-nb.png" "$HOME/.config/fastfetch/hexciri-nb.png"; then
        cp -f "$REPO/branding/hexciri-nb.png" "$HOME/.config/fastfetch/hexciri-nb.png" && \
          echo "deployed hexciri fastfetch logo ($dst dir)"
      fi
    fi
    if [[ ! -f $dst ]]; then
      mkdir -p "$(dirname "$dst")"
      cp -f "$src" "$dst" && echo "seeded fastfetch config ($dst)"
      return 0
    fi
    cmp -s "$src" "$dst" 2>/dev/null && return 0
    while IFS= read -r r; do
      [[ -n $r ]] || continue
      if git -C "$REPO" show "$r:config/fastfetch/config.jsonc" 2>/dev/null | cmp -s - "$dst"; then
        found="$r"
        break
      fi
    done < <(git -C "$REPO" log --format=%H -- config/fastfetch/config.jsonc 2>/dev/null || true)
    if [[ -z $found ]]; then
      echo "kept custom fastfetch config ($dst)"
      return 0
    fi
    cp -f "$src" "$dst" && echo "refreshed fastfetch config ($dst)"
    return 0
  }

  # Noctalia bar config + plugin settings: adopt once. A missing live config
  # is seeded; a present non-hexciri one is backed up to .stock and replaced.
  # Anything carrying our header afterwards is the user's and is never touched.
  sync_noctalia() {
    local src="$REPO/config/noctalia/config.toml"
    local dst="$HOME/.config/noctalia/config.toml"
    [[ -f $src ]] || return 0
    mkdir -p "$(dirname "$dst")"
    if [[ ! -f $dst ]]; then
      cp -f "$src" "$dst" && echo "seeded noctalia config ($dst)"
    elif ! grep -q '^# Hexciri — Noctalia config' "$dst" 2>/dev/null; then
      [[ -f $dst.stock ]] || cp -f "$dst" "$dst.stock"
      cp -f "$src" "$dst" && echo "adopted noctalia config (stock backed up to $dst.stock)"
    fi
    # Islands look: merge MISSING bar-style keys into the live [bar.default]
    # (present values — user-tuned or GUI-written — always win). Seed-only
    # would leave every existing box on the docked bar forever. Covers both
    # the config file and the state settings file: Noctalia resolves per-key
    # with the state file winning, so a [bar.default] there shadows the
    # config for every key it sets.
    STATE_CFG="$HOME/.local/state/noctalia/settings.toml"
    REPO_CFG="$src" LIVE_CFG="$dst" STATE_CFG="$STATE_CFG" python3 <<'EOF' || true
import os, re
wanted = [
    'background_opacity = 0.0',
    'margin_edge = 10',
    'margin_ends = 10',
    'concave_edge_corners = false',
    'radius = 16',
    'padding = 10',
    'widget_spacing = 4',
    'capsule = true',
    'capsule_fill = "surface_variant"',
    'capsule_thickness = 0.76',
    'contact_shadow = true',
    'panel_overlap = 1',
]
def merge(path, tag):
    try:
        lines = open(path).read().split("\n")
    except OSError:
        return
    start = end = None
    for i, l in enumerate(lines):
        if l.strip() == "[bar.default]":
            start = i
            continue
        if start is not None and re.match(r"^\[", l.strip()):
            end = i
            break
    if start is None:
        return
    if end is None:
        end = len(lines)
    have = set()
    for l in lines[start + 1:end]:
        m = re.match(r"^\s*([A-Za-z0-9_]+)\s*=", l)
        if m:
            have.add(m.group(1))
    missing = [w for w in wanted if re.match(r"^([A-Za-z0-9_]+)", w).group(1) not in have]
    if missing:
        ins = ["", "# Islands look (hexciri default — tune freely)"] + missing
        lines[end:end] = ins
        open(path, "w").write("\n".join(lines))
        print("noctalia bar (%s): added missing key(s): %s" % (tag, ", ".join(m.split("=")[0].strip() for m in missing)))
merge(os.environ["LIVE_CFG"], "config")
merge(os.environ["STATE_CFG"], "state")
EOF
    # Plugin preset: merge MISSING keys from the shipped preset into the live
    # settings (GUI values always win). Seeding only when settings.toml is
    # absent misses every box whose file already exists — the exact hole that
    # left update_cmd unset and sent the plugin down its interactive default
    # (stuck at the AUR helper's exclude prompt).
    local psrc="$REPO/config/noctalia/arch-updater.toml" pdst="$HOME/.local/state/noctalia/settings.toml"
    if [[ -f $psrc ]]; then
      mkdir -p "$(dirname "$pdst")"
      [[ -f $pdst ]] || printf 'config_version = 14\n' > "$pdst"
      REPO_PRESET="$psrc" LIVE_SETTINGS="$pdst" python3 <<'EOF' || true
import os, re
table = '[plugin_settings."yuuto/arch-updater"]'
psrc, pdst = os.environ["REPO_PRESET"], os.environ["LIVE_SETTINGS"]
wanted = {}
for line in open(psrc):
    s = line.strip()
    if not s or s.startswith(("#", "[")):
        continue
    m = re.match(r'^([A-Za-z0-9_]+)\s*=', s)
    if m:
        wanted.setdefault(m.group(1), line.rstrip("\n"))
if not wanted:
    raise SystemExit
lines = open(pdst).read().split("\n")
start, end = None, len(lines)
for i, l in enumerate(lines):
    if l.strip() == table:
        start = i
        break
if start is None:
    lines += ["", table] + list(wanted.values())
    missing = list(wanted)
else:
    for i in range(start + 1, len(lines)):
        if lines[i].strip().startswith("["):
            end = i
            break
    have = set()
    for l in lines[start + 1:end]:
        m = re.match(r'^\s*([A-Za-z0-9_]+)\s*=', l)
        if m:
            have.add(m.group(1))
    missing = [k for k in wanted if k not in have]
    for k in missing:
        lines.insert(end, wanted[k])
        end += 1
if missing:
    open(pdst, "w").write("\n".join(lines))
    print("noctalia arch-updater: seeded missing key(s): %s" % ", ".join(missing))
EOF
    fi
    return 0
  }

  # Niri island-bar rule: Noctalia v5 publishes a full-bar blur region even
  # with background_opacity = 0, hazing the gaps between capsules. Existing
  # boxes keep their live window-rules.kdl untouched, so append the opt-out
  # once (marker-guarded, idempotent). Fresh boxes get it from the repo file.
  sync_niri_bar_blur() {
    command -v niri >/dev/null 2>&1 || return 0
    local dst done_any=0
    for dst in "$HOME/.config/niri/cfg/window-rules.kdl" "$HOME/.config/niri/window-rules.kdl" \
               "$HOME/.config/niri/cfg/rules.kdl" "$HOME/.config/niri/rules.kdl"; do
      [[ -f $dst ]] || continue
      grep -q 'noctalia-bar' "$dst" 2>/dev/null && continue
      cat >> "$dst" <<'EOF'

// Noctalia island bar: no compositor blur (hexciri default — safe to delete).
// Noctalia v5 publishes a full-bar blur region even with background_opacity = 0,
// so blurring here hazes the gaps between capsules. Must come AFTER the general
// noctalia rule so it wins for the bar.
layer-rule {
    match namespace="^noctalia-bar-.*$"
    background-effect {
        blur false
    }
}
EOF
      echo "niri window-rules: added Noctalia island-bar no-blur rule ($dst)"
      done_any=1
    done
    if (( done_any )); then
      niri validate >/dev/null 2>&1 || echo "WARNING: niri validate fails — check window-rules.kdl" >&2
    fi
    return 0
  }

  # Repo hook scripts (theme bridge, app hooks): seed missing files, and refresh
  # repo-owned ones when the checkout advances — a file the user edited (differs
  # from what we last seeded, verified via git) is never overwritten. The rev
  # in .hexciri-manifest drives it, so no manual rm-to-refresh, ever.
  sync_hooks() {
    local src="$REPO/hooks" dst="$HOME/.config/hexciri/hooks"
    local rev manifest f rel entry oldrev found r
    [[ -d $src ]] || return 0
    rev="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo unknown)"
    manifest="$dst/.hexciri-manifest"
    owned() { # owned <rel> -> prints recorded rev or nothing
      [[ -f $manifest ]] || return 1
      entry="$(grep -E "^[0-9a-f]{40} $rel\$" "$manifest" 2>/dev/null | head -n 1 || true)"
      [[ -n $entry ]] || return 1
      printf '%s' "${entry%% *}"
    }
    record_owned() { # record_owned <rel> <rev>
      mkdir -p "$dst"
      grep -vE "^[0-9a-f]{40} $2\$|^! $2\$|^#[0-9a-f]+$" "$manifest" 2>/dev/null > "$manifest.tmp" || true
      printf '%s %s\n' "$1" "$2" >> "$manifest.tmp"
      mv -f "$manifest.tmp" "$manifest"
    }
    record_custom() { # record_custom <rel>
      mkdir -p "$dst"
      if ! grep -qxF "! $1" "$manifest" 2>/dev/null; then
        printf '! %s\n' "$1" >> "$manifest"
      fi
    }
    is_custom() {
      grep -qxF "! $1" "$manifest" 2>/dev/null
    }
    { find "$src" -type f 2>/dev/null || true; } | while IFS= read -r f; do
      rel="${f#$src/}"
      if [[ ! -f "$dst/$rel" ]]; then
        mkdir -p "$(dirname "$dst/$rel")"
        if cp -f "$f" "$dst/$rel" 2>/dev/null; then
          echo "seeded hook ($rel)"
          [[ $rev != unknown ]] && record_owned "$rev" "$rel"
        fi
        continue
      fi
      if is_custom "$rel"; then
        continue
      fi
      if oldrev="$(owned "$rel")"; then
        if git -C "$REPO" show "$oldrev:hooks/$rel" 2>/dev/null | cmp -s - "$dst/$rel"; then
          if ! cmp -s "$f" "$dst/$rel" 2>/dev/null; then
            cp -f "$f" "$dst/$rel" 2>/dev/null && echo "refreshed hook ($rel)" || true
          fi
          [[ $rev != unknown ]] && record_owned "$rev" "$rel"
          continue
        else
          record_custom "$rel"
          echo "kept custom hook ($rel)"
          continue
        fi
      fi
      # No record (pre-manifest seed or user file): classify via history.
      found=""
      if [[ $rev != unknown ]]; then
        while IFS= read -r r; do
          [[ -n $r ]] || continue
          if git -C "$REPO" show "$r:hooks/$rel" 2>/dev/null | cmp -s - "$dst/$rel"; then
            found="$r"
            break
          fi
        done < <(git -C "$REPO" log --format=%H -- "hooks/$rel" 2>/dev/null || true)
      fi
      if [[ -z $found ]]; then
        record_custom "$rel"
        echo "kept custom hook ($rel)"
      elif cmp -s "$f" "$dst/$rel" 2>/dev/null; then
        record_owned "$found" "$rel"
      else
        cp -f "$f" "$dst/$rel" 2>/dev/null && echo "refreshed hook ($rel)" || true
        [[ $rev != unknown ]] && record_owned "$rev" "$rel"
      fi
    done
    return 0
  }

  # MIME re-apply: browsers reclaim image/doc defaults on install/first-run.
  # The single mime-defaults table heals only broken (browser-owned, empty,
  # stale) slots — a deliberate pick is never overridden. Best-effort.
  sync_mime() {
    if [[ -x $REPO/bin/hexciri-mime-defaults ]]; then
      HEXCIRI_PATH="$REPO" "$REPO/bin/hexciri-mime-defaults" heal >/dev/null 2>&1 || true
    fi
    # keep aether:// Apply buttons one-click: stock Aether fails
    # as_omarchy_theme links off-Omarchy and never touches the bar —
    # the hexciri handler strips, applies, and follows through to theme-set.
    if [[ -x $REPO/bin/hexciri-aether-url ]]; then
      "$REPO/bin/hexciri-aether-url" heal >/dev/null 2>&1 || true
    fi
  }

  # Strata → Nautilus file-manager migration (runs every pass; no-op when
  # clean). Removes the per-user Strata install, restores Nautilus as the
  # folder handler, heals the Mod+Shift+F bind back to nautilus, pins the
  # portal FileChooser back to gtk (strata's override + the gnome-first system
  # default both leave niri with no Open/Save dialog), and re-runs
  # the GTK hook so Nautilus picks up the active palette. A deliberate
  # non-Nautilus, non-Strata pick (e.g. thunar) is never touched: only
  # Strata-owned or broken slots heal.
  #
  # NOTE: the bind heal must run BEFORE sync_keybinds. sync_new_binds treats a
  # live Mod+Shift+F → strata vs repo → nautilus as a user conflict and keeps
  # the live file — exactly why the Strata bind survived the original
  # migration. Healing first lets the sync see an already-matching combo.
  migrate_strata_to_nautilus() {
    local changed=0 cur gtk_hook mimeapps strata_ref kb pc portal_changed=0
    # 1. per-user Strata install out (binary, desktop, icon, portal, dbus
    #    services, share/cache, config, version state). A live --portal daemon
    #    recreates config, so stop it first. Runs unconditionally for the
    #    portal/dbus crumbs: the binary can already be gone while its
    #    FileChooser override still hijacks every Open/Save dialog.
    if [[ -x $HOME/.local/bin/strata || -f $HOME/.local/share/applications/io.github.lgse.Strata.desktop || -d $HOME/.config/strata \
      || -f $HOME/.local/share/xdg-desktop-portal/portals/strata.portal \
      || -f $HOME/.local/share/dbus-1/services/org.freedesktop.impl.portal.desktop.strata.service ]]; then
      pkill -x strata 2>/dev/null || true
      rm -f "$HOME/.local/bin/strata" \
        "$HOME/.local/share/applications/io.github.lgse.Strata.desktop" \
        "$HOME/.local/share/icons/hicolor/scalable/apps/io.github.lgse.Strata.svg" \
        "$HOME/.local/state/hexciri/strata.version" \
        "$HOME/.local/share/xdg-desktop-portal/portals/strata.portal" \
        "$HOME/.local/share/dbus-1/services/org.freedesktop.impl.portal.desktop.strata.service" \
        "$HOME/.local/share/dbus-1/services/io.github.lgse.Strata.FileManager1.service"
      rm -rf "$HOME/.cache/hexciri/strata" "$HOME/.config/strata" "$HOME/.local/share/strata" "$HOME/.cache/strata"
      update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
      echo "migrated: per-user Strata install removed"
      changed=1
    fi
    # 2. Strata-era launcher hide out (the stock entry applies again; the
    #    system-level NoDisplay stamp is undone by root hexciri-sync §5b).
    if [[ -f $HOME/.local/share/applications/org.gnome.Nautilus.desktop ]]; then
      rm -f "$HOME/.local/share/applications/org.gnome.Nautilus.desktop" && \
        echo "migrated: nautilus launcher unhidden"
      changed=1
    fi
    # 3. folder handling back to Nautilus. xdg-mime query skips dead desktop
    #    files, so a removed Strata can resolve to something else (or empty)
    #    while mimeapps.list still names it — check the file content too. Only
    #    Strata-owned or empty slots heal; a deliberate thunar etc. pick stays.
    if command -v nautilus >/dev/null 2>&1; then
      cur="$(xdg-mime query default inode/directory 2>/dev/null || true)"
      mimeapps="$HOME/.config/mimeapps.list"
      strata_ref=false
      if [[ $cur == io.github.lgse.Strata.desktop || -z $cur ]]; then
        strata_ref=true
      elif [[ -f $mimeapps ]] && grep -q 'io\.github\.lgse\.Strata\.desktop' "$mimeapps"; then
        strata_ref=true
      fi
      if $strata_ref; then
        xdg-mime default org.gnome.Nautilus.desktop inode/directory 2>/dev/null && \
          echo "migrated: inode/directory → org.gnome.Nautilus.desktop" || true
        changed=1
      fi
      if [[ $(cat "$HOME/.local/state/hexciri/defaults/files" 2>/dev/null || true) == strata ]]; then
        printf '%s' "nautilus" > "$HOME/.local/state/hexciri/defaults/files" && \
          echo "migrated: default files strata → nautilus"
        changed=1
      fi
      # 4. re-theme GTK so Nautilus picks up the active palette (the hook is
      #    idempotent; prefer a customized live copy over the repo one).
      if (( changed == 1 )); then
        gtk_hook="$HOME/.config/hexciri/hooks/theme-set.d/10-gtk.sh"
        [[ -x $gtk_hook ]] || gtk_hook="$REPO/hooks/theme-set.d/10-gtk.sh"
        if [[ -x $gtk_hook ]]; then
          bash "$gtk_hook" >/dev/null 2>&1 || true
          echo "migrated: GTK theme re-applied for nautilus"
        fi
      fi
    fi
    # 5. file-manager bind back to Nautilus. Only Strata-owned spawns heal —
    #    a deliberate thunar/yazi/nautilus pick (or any other customization)
    #    stays. Runs outside the nautilus-present gate: the bind should point
    #    at nautilus even if the package is still being healed, and niri
    #    picks up the edited file live (no reload needed).
    for kb in "$HOME/.config/niri/cfg/keybinds.kdl" "$HOME/.config/niri/keybinds.kdl"; do
      [[ -f $kb ]] || continue
      if grep -qi 'strata' "$kb"; then
        cp -f "$kb" "$kb.bak.$(date +%s)" 2>/dev/null || true
        # Replace any quoted spawn target containing strata (path, bare
        # binary, or desktop id) with the canonical nautilus spawn. The
        # [Ss] covers the binary (strata) and the desktop id (Strata).
        sed -Ei 's/spawn[[:space:]]+"[^"]*[Ss]trata[^"]*"/spawn "nautilus"/g' "$kb" && \
          echo "migrated: keybind strata → nautilus ($kb)"
        changed=1
      fi
    done
    # 6. file chooser back to GTK. Strata's --install-portal wrote
    #    ~/.config/xdg-desktop-portal/portals.conf with
    #    FileChooser=strata;... — with the binary gone the portal tries to
    #    activate a dead strata backend and no Open/Save dialog ever appears
    #    ("Could not activate remote peer strata"). And the system default
    #    (niri-portals.conf default=gnome;gtk) never falls back on niri: the
    #    gnome backend is settings-only here, so FileChooser must pin gtk
    #    explicitly. A deliberate non-gtk FileChooser pick is never touched:
    #    only missing files and strata-owned lines heal.
    pc="$HOME/.config/xdg-desktop-portal/portals.conf"
    if [[ ! -f $pc ]]; then
      mkdir -p "$(dirname "$pc")"
      printf '[preferred]\norg.freedesktop.impl.portal.FileChooser=gtk;\n' > "$pc" && \
        echo "migrated: FileChooser → gtk ($pc)"
      portal_changed=1
    elif grep -qi '^org\.freedesktop\.impl\.portal\.FileChooser=.*strata' "$pc"; then
      cp -f "$pc" "$pc.bak.$(date +%s)" 2>/dev/null || true
      # Keep any other preferred keys the user set; only the FileChooser line
      # heals.
      sed -Ei 's|^org\.freedesktop\.impl\.portal\.FileChooser=.*|org.freedesktop.impl.portal.FileChooser=gtk;|' "$pc" && \
        echo "migrated: FileChooser strata → gtk ($pc)"
      portal_changed=1
    fi
    if (( portal_changed == 1 )); then
      changed=1
      # Pick up the new backend list without relogin; best-effort (no session
      # bus on headless boxes).
      systemctl --user restart xdg-desktop-portal.service 2>/dev/null || true
    fi
  }

  # Fuzzel app launcher retirement (runs every pass; no-op when clean).
  # Mod+Space is now the Noctalia launcher; Mod+D (the old Noctalia bind) is
  # retired as a duplicate. Only fuzzel-owned spawns heal — a deliberate
  # Mod+Space/Mod+D rebind to something else stays. hexciri-fuzzel itself
  # stays: every menu (incl. Mod+Alt+Space) uses it as --dmenu.
  #
  # NOTE: must run BEFORE sync_keybinds. sync_new_binds treats a live
  # Mod+Space → fuzzel vs repo → noctalia as a user conflict and keeps the
  # live file — healing first lets the sync see an already-matching combo.
  migrate_fuzzel_launcher_to_noctalia() {
    local kb
    for kb in "$HOME/.config/niri/cfg/keybinds.kdl" "$HOME/.config/niri/keybinds.kdl"; do
      [[ -f $kb ]] || continue
      KB="$kb" python3 <<'EOF' || true
import os, re, shutil, time
kb = os.environ["KB"]
lines = open(kb).read().split("\n")
out, changed = [], False
for line in lines:
    if re.match(r'^\s*Mod\+Space\s*\{.*hexciri-fuzzel', line) and not re.search(r'calc|search|\brun\b|--dmenu', line):
        out.append('    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }')
        changed = True
        continue
    if re.match(r'^\s*Mod\+D\s*\{.*noctalia.*launcher', line):
        changed = True
        continue
    out.append(line)
if changed:
    shutil.copyfile(kb, "%s.bak.%d" % (kb, int(time.time())))
    if os.path.islink(kb):
        os.unlink(kb)
    with open(kb, "w") as f:
        f.write("\n".join(out))
    print("migrated: fuzzel launcher retired → Noctalia on Mod+Space (%s)" % kb)
EOF
    done
  }

  # mupdf → zathura document-reader migration (runs every pass; no-op when
  # clean). Installs zathura + its format plugins (pdf-mupdf for PDF/ePub/XPS,
  # ps for PostScript, djvu for DjVu, cb for comic archives), removes the mupdf
  # package once zathura lands, and flips a kept "mupdf" default pick to
  # zathura. A deliberate non-zathura, non-mupdf pick (e.g. evince) is never
  # touched: only mupdf-owned slots flip. The MIME heal itself runs later in
  # sync_mime via hexciri-mime-defaults (stale mupdf.desktop slots heal there).
  migrate_mupdf_to_zathura() {
    local pkgs="zathura zathura-pdf-mupdf zathura-ps zathura-djvu zathura-cb" missing="" p
    command -v pacman >/dev/null 2>&1 || return 0
    # zathura-pdf-mupdf conflicts with zathura-pdf-poppler — drop the poppler
    # backend first so the mupdf backend installs cleanly.
    if pacman -Q zathura-pdf-poppler >/dev/null 2>&1; then
      if sudo pacman -Rns --noconfirm zathura-pdf-poppler 2>&1 | tail -n 2; then
        echo "migrated: removed zathura-pdf-poppler (mupdf backend is the default)"
      else
        echo "migrated: kept zathura-pdf-poppler (removal failed) — install zathura-pdf-mupdf by hand if wanted"
        return 0
      fi
    fi
    for p in $pkgs; do
      pacman -Q "$p" >/dev/null 2>&1 || missing+="$p "
    done
    if [[ -n $missing ]]; then
      echo "migrated: installing zathura (replaces mupdf): $missing"
      # shellcheck disable=SC2086
      if sudo pacman -S --needed --noconfirm $missing 2>&1 | tail -n 3; then
        echo "migrated: zathura installed"
      else
        echo "migrated: zathura install skipped/partial (offline?) — run: sudo pacman -S --needed $missing"
        return 0
      fi
    fi
    if pacman -Q mupdf >/dev/null 2>&1; then
      if sudo pacman -Rns --noconfirm mupdf 2>&1 | tail -n 2; then
        echo "migrated: removed mupdf (replaced by zathura)"
      else
        echo "migrated: kept mupdf (something still needs it)"
      fi
    fi
    # stale per-user mupdf desktop override: the package is gone, the override is dead.
    if ! pacman -Q mupdf >/dev/null 2>&1 && [[ -f $HOME/.local/share/applications/mupdf.desktop ]]; then
      rm -f "$HOME/.local/share/applications/mupdf.desktop" && \
        echo "migrated: removed stale mupdf desktop override"
    fi
    if [[ $(cat "$HOME/.local/state/hexciri/defaults/pdf" 2>/dev/null || true) == mupdf ]]; then
      mkdir -p "$HOME/.local/state/hexciri/defaults"
      printf '%s' "zathura" > "$HOME/.local/state/hexciri/defaults/pdf" && \
        echo "migrated: default pdf mupdf → zathura"
    fi
  }

  # vlc → mpv media-player migration (runs every pass; no-op when
  # clean). Installs mpv, removes the vlc plugin stack (meta plus any
  # orphaned split plugins left behind), and drops the CachyOS wallpaper
  # pack (Noctalia shows theme backgrounds, never that pack). A deliberate
  # full-vlc install (vlc/vlc-gui-qt present) is never touched: only the
  # plugin stack with no player behind it goes.
  migrate_vlc_to_mpv() {
    local left
    command -v pacman >/dev/null 2>&1 || return 0
    if ! pacman -Q mpv >/dev/null 2>&1; then
      echo "migrated: installing mpv (replaces vlc)"
      if sudo pacman -S --needed --noconfirm mpv 2>&1 | tail -n 3; then
        echo "migrated: mpv installed"
      else
        echo "migrated: mpv install skipped/partial (offline?) — run: sudo pacman -S --needed mpv"
        return 0
      fi
    fi
    if pacman -Q vlc-plugins-all >/dev/null 2>&1; then
      if sudo pacman -Rns --noconfirm vlc-plugins-all 2>&1 | tail -n 2; then
        echo "migrated: removed vlc-plugins-all (replaced by mpv)"
      else
        echo "migrated: kept vlc-plugins-all (something still needs it)"
      fi
    fi
    if ! pacman -Q vlc >/dev/null 2>&1 && ! pacman -Q vlc-gui-qt >/dev/null 2>&1; then
      left="$(pacman -Qq 2>/dev/null | grep -E '^vlc-plugin|^libvlc$' || true)"
      if [[ -n $left ]]; then
        # shellcheck disable=SC2086
        if sudo pacman -Rns --noconfirm $left 2>&1 | tail -n 2; then
          echo "migrated: removed orphaned vlc plugins (replaced by mpv)"
        else
          echo "migrated: kept orphaned vlc plugins (something still needs them)"
        fi
      fi
    fi
    if pacman -Q cachyos-wallpapers >/dev/null 2>&1; then
      if sudo pacman -Rns --noconfirm cachyos-wallpapers 2>&1 | tail -n 2; then
        echo "migrated: removed cachyos-wallpapers (noctalia uses theme backgrounds)"
      else
        echo "migrated: kept cachyos-wallpapers (something still needs it)"
      fi
    fi
  }

  # Hyprland-native app migration (runs every pass; no-op when clean or on
  # niri). The first install.sh baked the niri stack (nautilus, imv,
  # gtksourceview5) onto every box, and CachyOS hyprland preinstalls its own
  # editor + calculator — but hyprland boxes ship Qt natives (dolphin, qview)
  # and hexciri's editor/calculator are zed + the fuzzel calc menu script.
  # Remove the redundant half once its replacement is live. Safety rules (same
  # as the one-time stock removals): only-if-installed, kept-when-needed, and
  # a role package goes only when the stored pick isn't itself (an explicit
  # user pick is never uninstalled from under them). Stale per-user desktop
  # overrides for removed packages go too (mirrors the mupdf stale override).
  migrate_hyprland_native_apps() {
    local wm files_pick images_pick p rm_list=""
    command -v pacman >/dev/null 2>&1 || return 0
    wm="$("$REPO/bin/hexciri-session" wm 2>/dev/null || echo niri)"
    [[ $wm == hyprland ]] || return 0
    # xdg-desktop-portal-gnome pins nautilus as its FileChooser dep: drop the
    # portal first or the nautilus removal below fails every pass with a
    # dependency error (kept, noisy). hexciri never uses the gnome portal
    # (FileChooser is pinned to gtk; install.sh removes it on fresh boxes) —
    # kept only if something else still needs it, in which case nautilus
    # stays too. Restart the portal service so the removed backend drops out
    # without a relogin (strata-migration precedent).
    if pacman -Q xdg-desktop-portal-gnome >/dev/null 2>&1; then
      if sudo pacman -Rns --noconfirm xdg-desktop-portal-gnome 2>&1 | tail -n 2; then
        echo "migrated: removed xdg-desktop-portal-gnome (unused; pinned nautilus)"
        systemctl --user restart xdg-desktop-portal.service 2>/dev/null || true
      else
        echo "migrated: kept xdg-desktop-portal-gnome (something still needs it)"
      fi
    fi
    files_pick="$(cat "$HOME/.local/state/hexciri/defaults/files" 2>/dev/null || true)"
    images_pick="$(cat "$HOME/.local/state/hexciri/defaults/images" 2>/dev/null || true)"
    if command -v dolphin >/dev/null 2>&1 && [[ $files_pick != nautilus ]]; then
      rm_list+="nautilus "
    fi
    if command -v qview >/dev/null 2>&1 && [[ $images_pick != imv ]]; then
      rm_list+="imv "
    fi
    if command -v zeditor >/dev/null 2>&1; then
      rm_list+="gnome-text-editor "
    fi
    # No app dependency: hexciri's calculator is the Mod+Shift+C fuzzel menu
    # script (libqalculate).
    rm_list+="gnome-calculator "
    # NOTE: gtksourceview5 is deliberately NOT removed — libspelling depends
    # on it, so the removal always fails (pacman dependency error, kept
    # anyway) and would print that error on every single pass. It stays:
    # invisible, still required.
    local rdd_list=""
    # Forced removals (vim precedent): the CachyOS hyprland meta pins the
    # stock editor + calculator, so plain -Rns refuses while it's installed.
    # -Rdd breaks only the meta's declared dep. Without the meta they take
    # the clean -Rns path above instead.
    if pacman -Q cachyos-hypr-noctalia >/dev/null 2>&1; then
      for p in gnome-text-editor gnome-calculator; do
        # shellcheck disable=SC2076
        if [[ " $rm_list " =~ " $p " ]]; then
          rm_list=${rm_list//"$p "/}
          rdd_list+="$p "
        fi
      done
    fi
    for p in $rm_list; do
      pacman -Q "$p" >/dev/null 2>&1 || continue
      # shellcheck disable=SC2086
      if sudo pacman -Rns --noconfirm "$p" 2>&1 | tail -n 2; then
        echo "migrated: removed $p (hyprland-native replacement is live)"
      else
        echo "migrated: kept $p (something still needs it)"
      fi
    done
    for p in $rdd_list; do
      pacman -Q "$p" >/dev/null 2>&1 || continue
      if sudo pacman -Rdd --noconfirm "$p" 2>&1 | tail -n 2; then
        echo "migrated: removed $p (forced: breaks only cachyos-hypr-noctalia's declared dep)"
      else
        echo "migrated: kept $p (forced removal failed)"
      fi
    done
    if ! pacman -Q imv >/dev/null 2>&1; then
      for p in imv imv-dir; do
        if [[ -f $HOME/.local/share/applications/$p.desktop ]]; then
          rm -f "$HOME/.local/share/applications/$p.desktop" && \
            echo "migrated: removed stale $p desktop override"
        fi
      done
    fi
  }

  # Desktop faillock tuning (runs every pass; no-op when clean). Stock
  # faillock (deny=3, unlock_time=600) turns one typo burst into a
  # reboot-only saga: 3 rapid fails lock the account 10 minutes, and every
  # "let me try again" inside the window fails AND extends it — so a correct
  # password reads as wrong until reboot wipes /run. Desktop-appropriate
  # bounds (deny=5 absorbs typo bursts, unlock_time=60 caps the cost at a
  # minute) keep brute-force protection while ending the saga. Stock files
  # only (any uncommented deny/unlock_time/fail_interval = admin choice,
  # never touched). Needs root; failure (no sudo here) skips silently like
  # the other privileged migrations.
  migrate_faillock_desktop_tuning() {
    local conf=/etc/security/faillock.conf key val
    [[ -f $conf ]] || return 0
    if grep -qE '^[[:space:]]*(deny|unlock_time|fail_interval)[[:space:]]*=' "$conf"; then
      return 0
    fi
    for kv in "deny = 5" "unlock_time = 60"; do
      key=${kv%% *}
      if ! grep -qE "^[[:space:]]*$key[[:space:]]*=" "$conf"; then
        printf '%s\n' "$kv" | sudo tee -a "$conf" >/dev/null 2>&1 || return 0
        echo "migrated: faillock $kv (desktop bounds; stock file only)"
      fi
    done
  }

  # Layer-critical packages: without polkit-gnome every pkexec app (btrfs-assistant,
  # gparted) is dead — no agent, no password dialog. gnome-keyring is Noctalia's
  # Secret Service provider (calendar tokens and other secrets have nowhere to
  # persist without it; libsecret alone is not a provider). adw-gtk-theme ships
  # the adw-gtk3-dark base theme the GTK hook sets — without it GTK3/plain-GTK4
  # apps fall back to built-in styling and look unthemed. brightnessctl +
  # playerctl are niri keybind needs (XF86MonBrightness* / XF86AudioPlay/Next/
  # Prev) — without them brightness + media keys are dead while volume (wpctl)
  # keeps working. fwupd ships fwupdmgr for Update > Firmware — without it the
  # blade fails with "command not found". jq parses compositor JSON for the WM
  # bridges (window lookups, outputs, reminders) — rowan boxes predate its
  # install.sh want and silently lose those paths. noctalia is the shell itself (bar,
  # lock, launcher, notifications) — a meta removal orphaned it once and left
  # a gray compositor with no shell, so it heals here like the rest. This is the
  # self-healing subset of install.sh's _hexciri_wants (the full set stays
  # install-time-only so deliberate removals stick); --needed makes it a no-op
  # when present, and failure (offline?) never stops the sync.
  # zathura is deliberately NOT here: it's a swappable default like imv — delete
  # its apps-list line and add your preferred PDF reader instead. The pdf
  # defaults helper only pins the picked reader over browser-stolen, empty, or
  # stale (reader-removed) slots, so it never fights a deliberate pick. The
  # one-time mupdf → zathura migration below owns the switch.
  # nautilus is layer here when it is the box's file manager, so a box that
  # lost it (removed meta, stray -Rns) gets it back instead of landing
  # without one. Boxes whose FM is dolphin skip it (see gate above).
  # nautilus is layer only when no file manager exists at all: hyprland
  # boxes ship dolphin, so a missing nautilus there is not a hole to heal —
  # without this gate every update would drag nautilus back onto hyprland.
  # (imv needs no gate here: it was never layer, install-time only.)
  ensure_layer_pkgs() {
    local pkgs="polkit-gnome gnome-keyring adw-gtk-theme brightnessctl playerctl fwupd noctalia jq" missing=""
    if ! command -v dolphin >/dev/null 2>&1 && ! command -v nautilus >/dev/null 2>&1; then
      pkgs+=" nautilus"
    fi
    command -v pacman >/dev/null 2>&1 || return 0
    for p in $pkgs; do
      pacman -Q "$p" >/dev/null 2>&1 || missing+="$p "
    done
    [[ -n $missing ]] || return 0
    echo "layer packages missing ($missing)— installing"
    sudo pacman -S --needed --noconfirm $missing 2>&1 | tail -n 3 || \
      echo "layer packages skipped/partial (offline?) — run: sudo pacman -S --needed $missing"
  }

  git -C "$REPO" fetch --tags origin --quiet 2>/dev/null || true
  local behind
  behind=$(git -C "$REPO" rev-list --count HEAD..@{upstream} 2>/dev/null || echo 0)

  # ── once, after the pull: re-exec from the freshly-pulled tree. Every entry
  # ── point funnels through this script (hexciri-update, the Repo/Hexciri menu,
  # ── hxup, and the alpm hook's hexciri-sync all invoke it), so a pull here is
  # ── THE deploy. Anything the pulled commit ships must run the NEW bytes of
  # ── THIS script, not the pre-pull copy that's executing now. ──
  if (( behind > 0 )) && [[ ${HXC_UPX_RERUN:-0} == 0 ]]; then
    echo "== framework self-update (repo pull) =="
    echo "pulling $behind new commit(s)..."
    git -C "$REPO" pull --ff-only --quiet
    export HXC_UPX_RERUN=1
    exec "$0" "$@"
  fi

  relink

  # ── deploy-side migrations (run every pass; idempotent). ──
  ST="$HOME/.local/state/noctalia/settings.toml"
  if [[ -f $ST ]] && grep -q 'update_cmd = "hexciri-update-run"' "$ST"; then
    sed -i 's|update_cmd = "hexciri-update-run"|update_cmd = "hexciri-update"|' "$ST"
    echo "arch-updater plugin: update_cmd migrated to hexciri-update"
  fi

  # Islands bar: the shipped background_opacity is now 0.0 (transparent bar,
  # solid pills). Flip live configs still on the old 0.95 default; any other
  # value is a deliberate pick and stays. Section-scoped to [bar.default].
  NC="$HOME/.config/noctalia/config.toml"
  if [[ -f $NC ]]; then
    LIVE_CFG="$NC" python3 <<'EOF' || true
import os, re
p = os.environ["LIVE_CFG"]
lines = open(p).read().split("\n")
in_bar = False
changed = False
for i, l in enumerate(lines):
    s = l.strip()
    if s.startswith("["):
        in_bar = (s == "[bar.default]")
        continue
    if in_bar and re.match(r"^background_opacity\s*=\s*0\.95\s*(#.*)?$", l):
        lines[i] = re.sub(r"0\.95", "0.0", l, count=1)
        changed = True
if changed:
    open(p, "w").write("\n".join(lines))
    print("noctalia bar: background_opacity 0.95 -> 0.0 (islands default)")
EOF
  fi

  # State the sync must keep live (idempotent; a plain pull/re-link is all the
  # deploy a repo-runtime project does, so this is the deploy):
  #   * active theme tree live (hexciri-theme-ensure; also drops the retired
  #     Strata omarchy/current bridge)
  #   * user wallpaper store merged into the active theme's backgrounds
  #   * legacy niri config PATH migration (so a kept pre-0.1.3 config can't kill keybinds)
  "$REPO/bin/hexciri-theme-ensure" >/dev/null 2>&1 || true
  mkdir -p "$HOME/.config/hexciri/wallpapers"
  "$REPO/bin/hexciri-wallpaper-refresh" >/dev/null 2>&1 || true

  # 90-greeter-sync.sh → folded into the theme bridge §8 (runs last by
  # definition): remove the live orphan so theme-sets sync once, with fresh
  # state. Runs every pass; no-op when clean. The file was generated (never
  # hand-edited), so no backup is kept — a re-pull restores it if wanted.
  migrate_greeter_hook_fold() {
    local old="$HOME/.config/hexciri/hooks/theme-set.d/90-greeter-sync.sh"
    [[ -f $old ]] || return 0
    rm -f "$old" && echo "migrated: removed superseded 90-greeter-sync.sh hook (greeter sync runs at the end of the theme bridge)"
  }

  ensure_layer_pkgs
  migrate_strata_to_nautilus
  migrate_fuzzel_launcher_to_noctalia
  migrate_mupdf_to_zathura
  migrate_vlc_to_mpv
  migrate_hyprland_native_apps
  migrate_faillock_desktop_tuning
  migrate_greeter_hook_fold
  sync_keybinds
  sync_hyprland
  sync_kitty
  sync_fastfetch
  sync_noctalia
  sync_niri_bar_blur
  sync_hooks
  sync_mime

  if (( behind == 0 )); then
    echo "up to date (HEAD $(git -C "$REPO" rev-parse --short HEAD))"
    exit 0
  fi
  echo "framework sync complete (HEAD $(git -C "$REPO" rev-parse --short HEAD))"
}

# ══════════════════════════════════════════════ hexciri-update-hardware
update_hardware() { # [choice]
  if [[ $# -gt 0 ]]; then
    # Direct dispatch from menu search
    local choice="$*"
  else
    local choice
    choice=$(
      printf '%s\n' 'Audio' 'Wi-Fi' 'Bluetooth' 'Trackpad' |
        "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Restart: ' --width=26 --lines=4
    ) || exec "$SCRIPT_DIR/hexciri-update"
  fi

  case "$choice" in
    Audio)     exec "$SCRIPT_DIR/hexciri-terminal" -e bash -c 'systemctl --user restart pipewire pipewire-pulse; echo "pipewire restarted"; read -rp "press enter to close"' ;;
    Wi-Fi)     exec "$SCRIPT_DIR/hexciri-terminal" -e bash -c 'sudo systemctl restart NetworkManager; echo "NetworkManager restarted"; read -rp "press enter to close"' ;;
    Bluetooth) exec "$SCRIPT_DIR/hexciri-terminal" -e bash -c 'sudo systemctl restart bluetooth; echo "bluetooth restarted"; read -rp "press enter to close"' ;;
    Trackpad)  exec "$SCRIPT_DIR/hexciri-terminal" -e bash -c 'sudo modprobe -r i2c-hid-acpi && sudo modprobe i2c-hid-acpi; echo "trackpad stack reloaded"; read -rp "press enter to close"' ;;
  esac
}

# ══════════════════════════════════════════════ hexciri-update-menu
update_menu() { # [choice]
  local entries choice

  entries=('Hexciri' 'Themes' 'Wallpaper' 'Hardware >' 'Firmware' 'Repo')

  if [[ $# -gt 0 ]]; then
    choice="$*"
  else
    choice=$(
      printf '%s\n' "${entries[@]}" |
        "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Update: ' --width=30 --lines=${#entries[@]}
    ) || exec "$SCRIPT_DIR/hexciri-menu"   # Esc = back to root menu
  fi
  choice=${choice%' >'}

  case "$choice" in
    "Hexciri")   exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$SCRIPT_DIR/hexciri-update" ;;
    "Hardware")  exec "$SCRIPT_DIR/hexciri-update-hardware" ;;
    "Firmware")  exec "$SCRIPT_DIR/hexciri-terminal" -e "$SCRIPT_DIR/hexciri-hold" bash -c 'if ! command -v fwupdmgr >/dev/null 2>&1; then echo "fwupd not installed — installing..."; sudo pacman -S --needed --noconfirm fwupd || exit 1; fi; fwupdmgr update' ;;
    "Repo")      exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$SCRIPT_DIR/hexciri-update-hexciri" ;;
    "Themes")    exec "$SCRIPT_DIR/hexciri-terminal" -e bash -c "'$SCRIPT_DIR/hexciri-theme-omarchy' && '$SCRIPT_DIR/hexciri-theme-extras' --run sync" ;;
    "Wallpaper") exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$SCRIPT_DIR/hexciri-wallpaper-refresh" "$HOME/.local/state/hexciri/current/theme" ;;
    *)           exit 0 ;;
  esac
}

# (mirror channels removed — CachyOS has no stable/bleeding feeds; its own
# repos stay exactly as installed.)

# ══════════════════════════════════════════════ hexciri-refresh-boot
update_refresh_boot() {
  # Re-run the root sync pass on demand (links, menu curation, firewall, sshd).
  local sync_cmd
  if [[ -x "$SCRIPT_DIR/hexciri-sync" ]]; then
    sync_cmd="$SCRIPT_DIR/hexciri-sync"
  else
    sync_cmd="hexciri-sync"
  fi
  echo "Re-asserting hexciri layer state (links, menu curation, firewall, sshd)..."
  sudo "$sync_cmd"
  echo "Layer re-applied."
}

# ══════════════════════════════════════════════ dispatch
sub="${1:-}"
case "$(basename "$0")" in
  hexciri-update-hexciri) sub=self ;;
  hexciri-update-run)     sub=run ;;
  hexciri-update-hardware) sub=hardware ;;
  hexciri-update-menu)    sub=menu ;;
  hexciri-refresh-boot)   sub=refresh-boot ;;
  *)                      : ;;  # hexciri-update bare, or unknown → decide below
esac

# hexciri-update bare: $1 may be a subcommand OR nothing. Unknown first-arg —
# e.g. --yes — means the bare system update (args pass through untouched).
known_sub() {
  case "$1" in
    sys|self|run|hardware|menu|refresh-boot|help) return 0 ;;
    *) return 1 ;;
  esac
}
if [[ $(basename "$0") == hexciri-update ]]; then
  if [[ -n $sub ]] && known_sub "$sub"; then
    shift 2>/dev/null || true   # consume the subcommand word
  else
    sub=""                     # bare system update; args (--yes) stay in "$@"
  fi
else
  # other arg0 names keep their own argument stream (e.g. hexciri-update-menu Audio)
  :
fi

case "$sub" in
  sys|""|run)   update_sys "$@" ;;
  self)         update_self "$@" ;;
  hardware)     update_hardware "$@" ;;
  menu)         update_menu "$@" ;;
  refresh-boot) update_refresh_boot ;;
  help)         echo "usage: hexciri-update <self|sys|hardware|menu|refresh-boot|help>"; exit 0 ;;
  *)            echo "unknown update subcommand: $sub" >&2; exit 1 ;;
esac