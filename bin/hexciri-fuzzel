#!/bin/bash
# hexciri:fuzzel=wrapper:shared-theming
# hexciri:summary=Fuzzel launcher wrapper: app launcher + web search + calculator + runner (Noctalia theme)
# hexciri:args=[search [PROVIDER]|calc|run] — bare = app launcher, --dmenu passthrough preserved
#
# Modes (mirror the walker/elephant launcher features that matter):
#   hexciri-fuzzel                 app launcher (default, unchanged)
#   hexciri-fuzzel search          web search with the default provider (Mod+Shift+S)
#   hexciri-fuzzel search NAME     web search with provider NAME (from the providers file)
#   hexciri-fuzzel calc            calculator via qalc; result copied to clipboard + notify
#   hexciri-fuzzel run             execute a command ($PATH scan + free text), detached
#   hexciri-fuzzel --dmenu ...     passthrough for dmenu consumers (hexciri-clipboard)
#
# Search providers: builtin table below; override/extend via
#   ~/.config/hexciri/search-providers   lines:  name|Display Name|url-template  (%s = URL-encoded query)
#   default provider: default=NAME  in that file, else HEXCIRI_SEARCH_PROVIDER, else "google".
# Query percent-encoding is done with python3 (already a hexciri dependency).
set -euo pipefail

CONFIG="$HOME/.config/noctalia/config.toml"

# ── Noctalia theme colors (unchanged) ──
bg_color="1a1b26cc"
text_color="c0caf5ff"
match_color="7aa2f7ff"
sel_bg_color="33467cdd"
sel_text_color="c0caf5ff"
border_color="7aa2f7ff"

if [[ -f "$CONFIG" ]]; then
    while IFS='=' read -r key value; do
        key=$(echo "$key" | xargs)
        value=$(echo "$value" | tr -d '"' | xargs)
        case "$key" in
            bg_color)       bg_color="${value}cc" ;;
            text_color)     text_color="${value}ff" ;;
            accent_color)   match_color="${value}ff"; sel_bg_color="${value}dd" ;;
            border_color)   border_color="${value}ff" ;;
        esac
    done < <(grep -E '^\s*(bg_color|text_color|accent_color|border_color)\s*=' "$CONFIG")
fi

ensure_rgba() {
    local color="$1"
    color="${color#\#}"
    case ${#color} in
        6) echo "${color}ff" ;;
        8) echo "$color" ;;
        *) echo "$color" ;;
    esac
}

bg_color=$(ensure_rgba "$bg_color")
text_color=$(ensure_rgba "$text_color")
match_color=$(ensure_rgba "$match_color")
sel_bg_color=$(ensure_rgba "$sel_bg_color")
sel_text_color=$(ensure_rgba "$sel_text_color")
border_color=$(ensure_rgba "$border_color")

# Shared fuzzel base arguments (theme). Mode code appends mode-specific flags.
FZ=( fuzzel \
    --font="JetBrainsMono Nerd Font:size=11" \
    --background-color="$bg_color" \
    --text-color="$text_color" \
    --match-color="$match_color" \
    --selection-color="$sel_bg_color" \
    --selection-text-color="$sel_text_color" \
    --border-color="$border_color" \
    --border-width=2 )

# ── search providers ──
# Builtin fallbacks to survive a missing user file (hexciri ships
# config/hexciri/search-providers and seeds it on install + update).
declare -A PROVIDERS LABELS
PROVIDERS[google]="https://google.com/search?udm=8&q=%s"; LABELS[google]="Google AI"
PROVIDERS[googleclassic]="https://google.com/search?udm=14&q=%s"; LABELS[googleclassic]="Google (classic)"
PROVIDERS[ddg]="https://duckduckgo.com/?q=%s";         LABELS[ddg]="DuckDuckGo"
PROVIDERS[brave]="https://search.brave.com/search?q=%s"; LABELS[brave]="Brave"
PROVIDERS[searxng]="https://searx.be/search?q=%s";     LABELS[searxng]="SearXNG"
PROVIDERS[github]="https://github.com/search?q=%s&type=code"; LABELS[github]="GitHub"
PROVIDERS[wiki]="https://en.wikipedia.org/w/index.php?search=%s"; LABELS[wiki]="Wikipedia"
PROVIDERS[archwiki]="https://wiki.archlinux.org/index.php?search=%s"; LABELS[archwiki]="Arch Wiki"
PROVIDERS[youtube]="https://www.youtube.com/results?search_query=%s"; LABELS[youtube]="YouTube"
PROVIDERS[aur]="https://aur.archlinux.org/packages?K=%s"; LABELS[aur]="AUR"
PROVIDERS[man]="https://man.archlinux.org/search?q=%s"; LABELS[man]="Arch Man Pages"
DEFAULT_PROVIDER="google"

# User file (config/hexciri/search-providers): lines are either
#   default=name
#   name|Display Name|url-template        (%s = URL-encoded query)
#   name=url-template                     (legacy, no label)
# Comments (#) and blanks ignored. The file is the single source of truth
# once it exists; builtins above only serve a box that never got it seeded.
SP_FILE="$HOME/.config/hexciri/search-providers"
if [[ -f $SP_FILE ]]; then
    while IFS= read -r line; do
        line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
        [[ -n $line && $line != "#"* ]] || continue
        case "$line" in
            default=*) DEFAULT_PROVIDER="${line#default=}" ;;
            *\|*)
                name="${line%%|*}"; rest="${line#*|}"
                label="${rest%%|*}"; url="${rest#*|}"
                PROVIDERS["$name"]="$url"; LABELS["$name"]="$label" ;;
            *=*) name="${line%%=*}"; PROVIDERS["$name"]="${line#*=}" ;;
        esac
    done < "$SP_FILE"
fi
DEFAULT_PROVIDER="${HEXCIRI_SEARCH_PROVIDER:-$DEFAULT_PROVIDER}"

urlenc() { python3 -c 'import sys,urllib.parse;sys.stdout.write(urllib.parse.quote(sys.argv[1],safe=""))' "$1"; }

mode_search() {
    local prov="${1:-$DEFAULT_PROVIDER}"
    local tpl="${PROVIDERS[$prov]:-${PROVIDERS[$DEFAULT_PROVIDER]}}"
    local lbl="${LABELS[$prov]:-$prov}"
    local q
    q="$("${FZ[@]}" --dmenu --prompt-only="Search [$lbl]: " --width=70)" || exit 0
    [[ -n $q ]] || exit 0
    xdg-open "${tpl/\%s/$(urlenc "$q")}" &
}

mode_calc() {
    local expr res
    expr="$("${FZ[@]}" --dmenu --prompt-only="Calc: " --width=45)" || exit 0
    [[ -n $expr ]] || exit 0
    res="$(qalc -t "$expr" 2>&1 || true)"
    printf '%s' "$res" | wl-copy
    notify-send "Calc" "$expr = $res" 2>/dev/null || true
}

mode_run() {
    local cmd
    cmd="$(compgen -c 2>/dev/null | sort -u | "${FZ[@]}" --dmenu --prompt="Run: " --width=70 --lines=12)" || exit 0
    [[ -n $cmd ]] || exit 0
    setsid bash -c "exec $cmd" >/dev/null 2>&1 & disown
}

# ── dispatch ──
case "${1:-}" in
    search) mode_search "${2:-}" ;;
    calc)   mode_calc ;;
    run)    mode_run ;;
    *)      exec "${FZ[@]}" "$@" ;;   # app launcher / --dmenu passthrough
esac