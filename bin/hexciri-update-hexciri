#!/bin/bash
# hexciri:summary=Hexciri repo sync: pull newer commits. Nothing new → says up to date and stops.
# The repo clone is the runtime (commands/configs/catalog live in it, ~/.local/bin
# symlinks into it), so a pull IS the deployment — no install.sh required. Re-links
# the bin dir so renamed/new commands land immediately, and one-time-clears the
# legacy root copies a pre-symlink install left in /usr/local/bin + /usr/share/hexciri.
set -euo pipefail

REPO="${HEXCIRI_PATH:-$HOME/.local/opt/hexciri}"
if [[ ! -d $REPO ]]; then
  echo "hexciri repo not found at: $REPO"
  echo "expected the bootstrap clone at ~/.local/opt/hexciri"
  exit 1
fi

relink() {
  mkdir -p "$HOME/.local/bin"
  for f in "$REPO"/bin/*; do
    [[ -f $f ]] || continue   # dirs (e.g. __pycache__) must not end the loop's status
    ln -sfn "$REPO/bin/$(basename "$f")" "$HOME/.local/bin/$(basename "$f")" || true
  done
  return 0
}

# One-time legacy migration: pre-symlink installs hard-copied every command to
# /usr/local/bin and mirrored catalog/themes/default into /usr/share/hexciri.
# The runtime is the repo now (~/.local/bin → repo/bin), so clear the stale
# root copies and re-point the alpm hook. Uses sudo -n deliberately: the normal
# path runs a sync with no root at all (the Repo menu / plain pull), and the
# rare third-party box reaches this through the system update (hexciri-update)
# which has already validated sudo. Silent skip when no root is available.
legacy_purge() {
  local stale=false f
  for f in /usr/local/bin/hexciri-*; do
    [[ -f $f && ! -L $f ]] && stale=true && break
  done
  $stale || return 0
  echo "legacy root command copies found — clearing /usr/local/bin + /usr/share/hexciri (one-time)"
  if sudo -n rm -f /usr/local/bin/hexciri-* 2>/dev/null; then
    sudo -n ln -sfn "$REPO/bin/hexciri-sync" /usr/local/bin/hexciri-sync 2>/dev/null || true
    sudo -n rm -rf /usr/share/hexciri/themes /usr/share/hexciri/theme-sources \
      /usr/share/hexciri/default /usr/share/hexciri/VERSION 2>/dev/null || true
    echo "legacy /usr/local/bin copies + /usr/share/hexciri mirror removed (hook relinked to the repo)"
  else
    echo "note: stale /usr/local/bin/hexciri-* remain (no sudo session) — a system update will clear them"
  fi
  # pre-0.1.3 one-time: legacy configs have no environment PATH line, so niri can't
  # find the ~/.local/bin hexciri-* commands after the stale root copies go away.
  # Inject ~/.local/bin PATH only if missing; idempotent. (Deletion already happened
  # at this point, so run the guard regardless of sudo success above.)
  "$REPO/bin/hexciri-migrate-niri-path" 2>/dev/null || true
}

# The shorthand Omarchy default set is part of the framework, so it rides along
# with the repo sync: seed the sparse clone if missing, otherwise git-pull and
# re-link. hexciri-theme-extras only touches the handpicked extras list (the
# explicit "Update ▸ Themes" menu action). Non-fatal so a sync proceeds even if
# the theme clone/sync hits a snag.
sync_themes() {
  if [[ -x "$REPO/bin/hexciri-theme-omarchy" ]]; then
    HEXCIRI_PATH="$REPO" "$REPO/bin/hexciri-theme-omarchy" </dev/null 2>&1 || \
      echo "omarchy themes sync skipped/failed (continuing)" >&2
  fi
}

echo "syncing $REPO ..."
git -C "$REPO" fetch --tags origin --quiet 2>/dev/null || true
behind=$(git -C "$REPO" rev-list --count HEAD..@{upstream} 2>/dev/null || echo 0)

# ── once, after the pull: re-exec from the freshly-pulled tree. Every entry
# ── point funnels through this script (hexciri-update, the Repo/Hexciri menu,
# ── hxup, and the alpm hook's hexciri-sync all invoke it), so a pull here is
# ── THE deploy. Anything the pulled commit ships — relinks, migrations like the
# ── plugin update_cmd, whatever ships next — must run the NEW bytes of THIS
# ── script, not the pre-pull copy that's executing now. HXC_UPX_RERUN guards
# ── the single re-exec; the second pass sees behind==0 and runs the deploy
# ── steps below with current code. Same one-shot self-heal as hexciri-update
# ── and hexciri-sync. ──
if (( behind > 0 )) && [[ ${HXC_UPX_RERUN:-0} == 0 ]]; then
  echo "pulling $behind new commit(s)..."
  git -C "$REPO" pull --ff-only --quiet
  export HXC_UPX_RERUN=1
  exec "$0" "$@"
fi

relink
sync_themes

# ── deploy-side migrations (run every pass; idempotent). ──
# noctalia arch-updater plugin: update_cmd is seeded once into the user's state
# settings.toml and "never touched again", so re-point a stale
# "hexciri-update-run" → "hexciri-update" here, in the one place every update
# press funnels through. (The pre-rename shim keeps the old name working
# regardless; this is tidy-up, not load-bearing.)
ST="$HOME/.local/state/noctalia/settings.toml"
if [[ -f $ST ]] && grep -q 'update_cmd = "hexciri-update-run"' "$ST"; then
  sed -i 's|update_cmd = "hexciri-update-run"|update_cmd = "hexciri-update"|' "$ST"
  echo "arch-updater plugin: update_cmd migrated to hexciri-update"
fi

# State the sync must keep live (idempotent; a plain pull/re-link is all the
# deploy a repo-runtime project does, so this is the deploy):
#   * Strata bridge: omarchy/current symlink → our state (Follow Omarchy mode)
#   * user wallpaper store merged into the active theme's backgrounds
#   * legacy niri config PATH migration (so a kept pre-0.1.3 config can't kill keybinds)
"$REPO/bin/hexciri-theme-ensure" >/dev/null 2>&1 || true
mkdir -p "$HOME/.config/hexciri/wallpapers"
"$REPO/bin/hexciri-wallpaper-refresh" >/dev/null 2>&1 || true

# Keybind fragment is OWNED by the hand-written niri keybinds file
# (config/niri/keybinds.kdl) and copied whole into ~/.config/niri/keybinds.kdl.
# Pull that ships a newer hand-written keybind file must refresh the live
# fragment too, or the machine keeps stale binds. Deterministic + idempotent:
# bytes identical unless the shipped file changed. Runs on every pass (even
# "up to date") so a stale fragment self-heals on the next press.
sync_keybinds() {
  [[ -x "$REPO/bin/hexciri-session" ]] || return 0
  src="$REPO/config/niri/keybinds.kdl"
  dst="$HOME/.config/niri/keybinds.kdl"
  [[ -f $src ]] || return 0
  # Non-destructive: the live file is a per-machine authoring (this machine's
  # full bind set, personal app binds included) — never clobber it. Only seed
  # when no config exists (fresh install / first sync).
  [[ -f $dst ]] && return 0
  mkdir -p "$(dirname "$dst")"
  cp -f "$src" "$dst"
  echo "seeded niri keybinds ($dst)"
}
sync_keybinds

# ── niri-only purge: hexciri no longer ships hyprland/sway/mango, so the
# leftover per-WM config dirs from older builds are garbage. Config dirs the
# user never chose to keep → remove on every sync so a box that once swapped
# WMs heals silently. (~/.config/swaync stays — that's the notification daemon,
# unrelated to the sway compositor.) System-side session files go in the root
# hexciri-sync (they need sudo); packages are left installed on purpose.
purge_other_wms() {
  local wm cfg bin purged=false
  for wm in hypr sway mango; do
    cfg="$XDG_CONFIG_HOME/$wm"
    [[ -e $cfg ]] || continue
    case "$wm" in
      hypr)  bin=Hyprland ;;
      sway)  bin=sway ;;
      mango) bin=mango ;;
    esac
    if pgrep -x "$bin" >/dev/null 2>&1; then
      echo "warning: '$wm' is running right now — leaving $cfg in place"
      continue
    fi
    rm -rf "$cfg"
    echo "purged leftover '${wm}' config: $cfg"
    purged=true
  done
  return 0
}
purge_other_wms

if (( behind == 0 )); then
  echo "up to date (HEAD $(git -C "$REPO" rev-parse --short HEAD))"
  legacy_purge
  exit 0
fi