#!/bin/bash
# hexciri:summary=Default apps: kitty + fish + brave-origin + dolphin(hyprland)/nautilus(niri) + imv + zathura + zed + opencode (xdg-native)
# Only shows apps that are actually installed; current choice is marked with ✓.
# usage: hexciri-defaults [Browser|Editor|Images|PDF|Terminal|Shell|Files|Agent]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

STATE_BASE="$HOME/.local/state/hexciri/defaults"
mkdir -p "$STATE_BASE"
get() { cat "$STATE_BASE/$1" 2>/dev/null || true; }
setv() { printf '%s' "$2" > "$STATE_BASE/$1"; }

# Per-WM file manager: hyprland boxes ship dolphin as their natural FM (stock
# Mod+E opens it, Omarchy hyprland conventions use it too); niri keeps the
# hexciri nautilus default. First seed only — an explicit Defaults > Files
# pick is never overridden.
_active_wm="$("$SCRIPT_DIR/hexciri-session" wm 2>/dev/null || echo niri)"

# seed user core on first run
[[ -f $STATE_BASE/terminal ]] || setv terminal kitty
[[ -f $STATE_BASE/shell ]]    || setv shell fish
[[ -f $STATE_BASE/browser ]]  || setv browser brave-origin
if ! [[ -f $STATE_BASE/files ]]; then
  if [[ $_active_wm == hyprland ]] && command -v dolphin >/dev/null 2>&1; then
    setv files dolphin
  else
    setv files nautilus
  fi
fi
[[ -f $STATE_BASE/editor ]]   || setv editor zed
[[ -f $STATE_BASE/agent ]]    || setv agent opencode
[[ -f $STATE_BASE/images ]]   || setv images imv
[[ -f $STATE_BASE/pdf ]]      || setv pdf zathura

# available(): only list candidates whose binary exists (browser: via desktop file)
has_bin() { command -v "$1" >/dev/null 2>&1; }
has_desktop() {
  local d
  for d in "$@"; do
    [[ -f $HOME/.local/share/applications/$d || -f /usr/local/share/applications/$d || -f /usr/share/applications/$d ]] && return 0
  done
  return 1
}
available() { # <browser|terminal|...> <current> <candidates...>
  local type=$1 current=$2; shift 2
  local c
  for c in "$@"; do
    case "$type" in
      browser) has_desktop "$c.desktop" || continue ;;
      editor)  # Arch's zed ships as zeditor, not zed
        if [[ $c == zed ]]; then
          command -v zeditor >/dev/null 2>&1 || continue
        else
          has_bin "$c" || continue
        fi
        ;;
      pdf)  # offered by desktop file — what xdg-mime needs to point at
        case "$c" in
          mupdf) has_desktop mupdf.desktop || continue ;;
          zathura) has_desktop org.pwmt.zathura.desktop zathura.desktop || continue ;;
          evince) has_desktop org.gnome.Evince.desktop evince.desktop || continue ;;
          okular) has_desktop org.kde.okular.desktop okular.desktop || continue ;;
          *) has_bin "$c" || continue ;;
        esac
        ;;
      *) has_bin "$c" || continue ;;
    esac
    printf '%s\n' "$c"
  done | while read -r c; do
    if [[ $c == "$current" ]]; then printf '✓ %s\n' "$c"; else printf '%s\n' "$c"; fi
  done
}

# mupdf → zathura migration for the stored pick: a kept "mupdf" value whose
# reader is gone flips to zathura once its desktop exists. A deliberate
# reinstall of mupdf keeps working (its desktop exists → no flip).
if [[ $(get pdf) == mupdf ]]; then
  if ! has_desktop mupdf.desktop && has_desktop org.pwmt.zathura.desktop zathura.desktop; then
    setv pdf zathura
  fi
fi

menu_via_fuzzel() { # <prompt> -- <items...>
  local prompt=$1; shift
  [[ $1 == -- ]] && shift
  if command -v hexciri-fuzzel &>/dev/null; then
    printf '%s\n' "$@" | hexciri-fuzzel --dmenu --prompt="$prompt" --width=30 --lines=8
  else
    printf '%s\n' "$@" | head -n 1
  fi
}

pick_type="${1:-}"
if [[ -z $pick_type ]]; then
  pick_type="$(menu_via_fuzzel 'Defaults: ' -- Browser Editor Terminal Shell Files Images PDF Agent)" || exec "$SCRIPT_DIR/hexciri-system"   # Esc = back to System menu
fi

# hexciri-defaults run <type>: launch the current default, no menu. Used by
# the hyprland File manager bind (Mod+Shift+F → hexciri-defaults run files).
# files only today — seeding above already guarantees a valid pick.
if [[ ${pick_type,,} == run ]] && [[ $# -ge 2 ]]; then
  case "${2,,}" in
    files)
      _run="$(get files)"
      case "$_run" in
        yazi) exec kitty --class yazi -e yazi 2>/dev/null || exec yazi ;;
        *)    [[ -n $_run ]] && command -v "$_run" >/dev/null 2>&1 && exec "$_run" ;;
      esac
      ;;
  esac
  exit 1   # nothing to run
fi

case "${pick_type,,}" in
  browser)
    current="$(get browser)"
    choice="$(menu_via_fuzzel 'Browser: ' -- "$(available browser "$current" brave-origin brave-origin-beta brave firefox chromium zen)")" || exec "$SCRIPT_DIR/hexciri-defaults"   # Esc = back to Defaults list
    if [[ -z $(available browser "$current" brave-origin brave-origin-beta brave firefox chromium zen | grep -F "$choice") && $choice != "$current" ]]; then
      exit 0
    fi
    setv browser "$choice"
    # file associations live in the single mime-defaults table — force-pin the
    # explicit choice (an explicit pick wins over whatever owns the slot).
    "$SCRIPT_DIR/hexciri-mime-defaults" apply browser >/dev/null 2>&1 || true
    ;;
  terminal)
    current="$(get terminal)"
    choice="$(menu_via_fuzzel 'Terminal: ' -- "$(available terminal "$current" kitty foot ghostty alacritty)")" || exec "$SCRIPT_DIR/hexciri-defaults"   # Esc = back to Defaults list
    [[ -n $choice ]] || exit 0
    setv terminal "$choice"
    ;;
  shell)
    current="$(get shell)"
    choice="$(menu_via_fuzzel 'Shell: ' -- "$(available shell "$current" fish bash)")" || exec "$SCRIPT_DIR/hexciri-defaults"   # Esc = back to Defaults list
    [[ -n $choice ]] || exit 0
    setv shell "$choice"
    # shell is the interactive terminal shell only; the login shell stays bash
    # (SSH/su/scripts stay POSIX-safe). kitty reads it from this default.
    if command -v kitty >/dev/null 2>&1; then
      if [[ $choice == fish ]]; then
        kitty +kitten edit-config main.conf --replace 'shell fish' --apply-config "shell fish" >/dev/null 2>&1 \
          || sed -i 's|^shell .*|shell fish|' "$HOME/.config/kitty/kitty.conf" 2>/dev/null || true
        echo "kitty terminals now open in fish"
      else
        sed -i 's|^shell .*|shell '"$choice"'|' "$HOME/.config/kitty/kitty.conf" 2>/dev/null \
          || printf 'shell %s\n' "$choice" >> "$HOME/.config/kitty/kitty.conf"
        echo "kitty terminals now open in $choice"
      fi
    fi
    ;;
  files)
    current="$(get files)"
    choice="$(menu_via_fuzzel 'Files: ' -- "$(available files "$current" dolphin nautilus strata thunar yazi)")" || exec "$SCRIPT_DIR/hexciri-defaults"   # Esc = back to Defaults list
    [[ -n $choice ]] || exit 0
    setv files "$choice"
    "$SCRIPT_DIR/hexciri-mime-defaults" apply files >/dev/null 2>&1 || true
    ;;
  images)
    current="$(get images)"
    choice="$(menu_via_fuzzel 'Images: ' -- "$(available images "$current" imv qimgv)")" || exec "$SCRIPT_DIR/hexciri-defaults"   # Esc = back to Defaults list
    [[ -n $choice ]] || exit 0
    setv images "$choice"
    # imv needs its displayable override deployed too — the mime-defaults
    # table owns that alongside the pinning.
    HEXCIRI_PATH="${HEXCIRI_PATH:-$HOME/.local/opt/hexciri}" "$SCRIPT_DIR/hexciri-mime-defaults" apply images >/dev/null 2>&1 || true
    ;;
  editor)
    current="$(get editor)"
    choice="$(menu_via_fuzzel 'Editor: ' -- "$(available editor "$current" zed nvim helix code)")" || exec "$SCRIPT_DIR/hexciri-defaults"   # Esc = back to Defaults list
    [[ -n $choice ]] || exit 0
    setv editor "$choice"
    ;;
  pdf)
    current="$(get pdf)"
    choice="$(menu_via_fuzzel 'PDF: ' -- "$(available pdf "$current" zathura mupdf evince okular)")" || exec "$SCRIPT_DIR/hexciri-defaults"   # Esc = back to Defaults list
    [[ -n $choice ]] || exit 0
    choice="${choice#✓ }"   # re-picking the current choice keeps the bare name
    setv pdf "$choice"
    "$SCRIPT_DIR/hexciri-mime-defaults" apply pdf >/dev/null 2>&1 || true
    ;;
  agent)
    current="$(get agent)"
    choice="$(menu_via_fuzzel 'Agent: ' -- "$(available agent "$current" opencode claude codex)")" || exec "$SCRIPT_DIR/hexciri-defaults"   # Esc = back to Defaults list
    [[ -n $choice ]] || exit 0
    setv agent "$choice"
    ;;
  *) exit 0 ;;
esac

echo "default ${pick_type,,}: $(get "${pick_type,,}")"