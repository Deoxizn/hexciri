#!/bin/bash
# hexciri:menu=session
# hexciri:summary=Session submenu: install/switch WM, remove a WM, or show the current combo
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Surface the current combo in the prompt so "what am I on?" doubles as
# confirmation that Install = hexciri-session-set (the deliberate swap tool).
combo="$("$SCRIPT_DIR/hexciri-session" combo 2>/dev/null || true)"
[[ -n $combo ]] && combo=" (now $combo)"

choice=$(
  printf '%s\n' 'Install / Switch >' 'Remove >' 'Current' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt="Session$combo: " --width=24 --lines=3
) || exec "$SCRIPT_DIR/hexciri-system"   # Esc = back to System menu
choice=${choice%' >'}

case "$choice" in
  # Install/Switch (hexciri-session-set) is the deliberate WM-swap path — it
  # picks a WM, installs it if missing, carries over monitors/env/input/autostart
  # and ships the hand-written keybinds. Remove is its complement and never
  # touches the active WM. Both re-exec into a visible terminal only for the
  # sudo work, so nothing pops up before you've made a choice. Current just
  # shows the combo, in a terminal.
  'Install / Switch') exec "$SCRIPT_DIR/hexciri-session-set" ;;
  Remove)  exec "$SCRIPT_DIR/hexciri-session-remove" ;;
  Current) exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$SCRIPT_DIR/hexciri-session" combo ;;
esac