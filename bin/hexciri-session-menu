#!/bin/bash
# hexciri:menu=session
# hexciri:summary=Session submenu: install or remove a WM (shell choices live in the picker)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choice=$(
  printf '%s\n' 'Install >' 'Remove >' 'Current' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Session: ' --width=24 --lines=3
) || exec "$SCRIPT_DIR/hexciri-system"   # Esc = back to System menu
choice=${choice%' >'}

case "$choice" in
  Install) exec "$SCRIPT_DIR/hexciri-session-set" ;;
  Remove)  exec "$SCRIPT_DIR/hexciri-session-remove" ;;
  Current) exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$SCRIPT_DIR/hexciri-session" combo ;;
esac