#!/bin/bash
# hexciri:summary=Set the system DNS provider (NetworkManager + systemd-resolved)
# hexciri:args=[Cloudflare|Google]
# hexciri:examples=hexciri-dns | hexciri-dns Cloudflare
set -euo pipefail

NM_DNS_CONF=/etc/NetworkManager/conf.d/20-hexciri-dns.conf

provider_from_arg() {
  case "$1" in
    Cloudflare | cloudflare) echo "Cloudflare" ;;
    Google | google)         echo "Google" ;;
    DHCP | dhcp)             echo "DHCP" ;;
    Custom | custom)         echo "Custom" ;;
    *)                       return 1 ;;
  esac
}

current_global_dns() {
  awk -F= '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*\[global-dns-domain-\*\][[:space:]]*$/ { in_default = 1; next }
    /^[[:space:]]*\[/ { in_default = 0 }
    in_default && /^[[:space:]]*servers[[:space:]]*=/ {
      value = $0
      sub(/^[^=]*=/, "", value)
      print value
      exit
    }
  ' "$NM_DNS_CONF" 2>/dev/null || true
}

current_provider() {
  local dns compact
  dns=$(current_global_dns)
  compact=$(printf '%s' "$dns" | tr -d '[:space:],')
  if [[ -z $compact ]]; then
    echo "DHCP"
  elif [[ $dns == *"cloudflare"* || $dns == *"1.1.1.1"* ]]; then
    echo "Cloudflare"
  elif [[ $dns == *"dns.google"* || $dns == *"8.8.8.8"* ]]; then
    echo "Google"
  else
    echo "Custom"
  fi
}

set_connection_dns() {
  local ipv4_dns="${1:-}" ipv6_dns="${2:-}" uuid type
  while IFS=: read -r uuid type; do
    [[ -n $uuid ]] || continue
    case "$type" in
      802-11-wireless|802-3-ethernet) ;;
      *) continue ;;
    esac
    if [[ -n $ipv4_dns || -n $ipv6_dns ]]; then
      nmcli connection modify "$uuid" \
        ipv4.ignore-auto-dns yes \
        ipv4.dns "$ipv4_dns" \
        ipv6.ignore-auto-dns yes \
        ipv6.dns "$ipv6_dns" >/dev/null
    else
      nmcli connection modify "$uuid" \
        ipv4.ignore-auto-dns no \
        ipv4.dns "" \
        ipv6.ignore-auto-dns no \
        ipv6.dns "" >/dev/null
    fi
  done < <(nmcli -t -f UUID,TYPE connection show 2>/dev/null)
}

reload_dns_stack() {
  nmcli general reload conf >/dev/null 2>&1 || true
  nmcli device reapply "$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i=="dev") {print $(i+1); exit}}')" >/dev/null 2>&1 || true
  systemctl reload systemd-resolved.service 2>/dev/null || systemctl restart systemd-resolved.service || true
  nmcli general reload dns-full >/dev/null 2>&1 || true
}

usage() { echo "Usage: hexciri-dns [DHCP|Cloudflare|Google|Custom]" >&2; exit 1; }

normalize_servers() {
  printf '%s\n' "$*" | tr ',\t\n' ' ' | xargs | tr ' ' ','
}

split_dns_servers() {
  local servers="$1" server clean
  ipv4_dns=""
  ipv6_dns=""
  for server in ${servers//,/ }; do
    clean=${server#dns+tls://}
    clean=${clean#dns+udp://}
    clean=${clean%%#*}
    [[ -n $clean ]] || continue
    if [[ $clean == *:* ]]; then
      ipv6_dns+="${ipv6_dns:+ }$clean"
    else
      ipv4_dns+="${ipv4_dns:+ }$clean"
    fi
  done
}

if (($# == 0)); then
  current_provider
  exit 0
fi
if (($# > 1)); then
  usage
fi
provider=$(provider_from_arg "$1") || usage

case "$provider" in
Cloudflare)
  install -d -m 0755 "$(dirname "$NM_DNS_CONF")"
  cat >"$NM_DNS_CONF" <<EOF
# Managed by hexciri-dns. Remove this file or run: sudo rm $NM_DNS_CONF to use DHCP DNS again.
[global-dns]

[global-dns-domain-*]
servers=1.1.1.1,1.0.0.1,2606:4700:4700::1111,2606:4700:4700::1001
EOF
  set_connection_dns "1.1.1.1 1.0.0.1" "2606:4700:4700::1111 2606:4700:4700::1001"
  tee /etc/systemd/resolved.conf >/dev/null <<'EOF'
[Resolve]
DNS=1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
DNSOverTLS=opportunistic
EOF
  ;;
Google)
  install -d -m 0755 "$(dirname "$NM_DNS_CONF")"
  cat >"$NM_DNS_CONF" <<EOF
# Managed by hexciri-dns. Remove this file or run: sudo rm $NM_DNS_CONF to use DHCP DNS again.
[global-dns]

[global-dns-domain-*]
servers=8.8.8.8,8.8.4.4,2001:4860:4860::8888,2001:4860:4860::8844
EOF
  set_connection_dns "8.8.8.8 8.8.4.4" "2001:4860:4860::8888 2001:4860:4860::8844"
  tee /etc/systemd/resolved.conf >/dev/null <<'EOF'
[Resolve]
DNS=8.8.8.8#dns.google 8.8.4.4#dns.google 2001:4860:4860::8888#dns.google 2001:4860:4860::8844#dns.google
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
DNSOverTLS=opportunistic
EOF
  ;;
DHCP)
  rm -f "$NM_DNS_CONF"
  set_connection_dns ""
  tee /etc/systemd/resolved.conf >/dev/null <<'EOF'
[Resolve]
DNSOverTLS=no
EOF
  ;;
Custom)
  echo "Enter your DNS servers (space-separated, e.g. '192.168.1.1 1.1.1.1'):"
  read -r dns_servers || dns_servers=""
  dns_servers=$(normalize_servers "$dns_servers")
  [[ -n $dns_servers ]] || { echo "Error: No DNS servers provided." >&2; exit 1; }
  split_dns_servers "$dns_servers"
  install -d -m 0755 "$(dirname "$NM_DNS_CONF")"
  cat >"$NM_DNS_CONF" <<EOF
# Managed by hexciri-dns. Remove this file or run: sudo rm $NM_DNS_CONF to use DHCP DNS again.
[global-dns]

[global-dns-domain-*]
servers=$dns_servers
EOF
  set_connection_dns "$ipv4_dns" "$ipv6_dns"
  tee /etc/systemd/resolved.conf >/dev/null <<EOF
[Resolve]
DNS=${dns_servers//,/ }
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
EOF
  ;;
esac

reload_dns_stack
echo "DNS set to $provider"