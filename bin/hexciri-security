#!/bin/bash
# hexciri:security=security-setup
# hexciri:summary=Security setup: fingerprint login, FIDO2 keys, SSH daemon, passwordless sudo
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bindir="${HEXCIRI_BIN_DIR:-}"
if [[ -z $bindir && -d $(dirname "$SCRIPT_DIR")/bin ]]; then bindir="$(dirname "$SCRIPT_DIR")/bin"; fi
bindir="${bindir:-$SCRIPT_DIR}"

menu=""
add() { menu+="$1"$'\n'; }

# Fingerprint only when the reader exists on this machine.
# Marked ✓ when greeter touch-login is explicitly enabled.
FP_FLAG=/etc/hexciri/fingerprint-enabled
if "$bindir/hexciri-hw-fingerprint" >/dev/null 2>&1; then
  if [[ -f $FP_FLAG ]]; then add 'Fingerprint ✓'; else add 'Fingerprint'; fi
fi
add 'Fido2'
add 'SSHD'
add 'Passwordless Sudo'

choice=$(
  printf '%s' "$menu" |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Security: ' --width=30 --lines="$(printf '%s\n' "$menu" | sed '/^$/d' | wc -l)"
) || exec "$SCRIPT_DIR/hexciri-system"

enter_term() { "$SCRIPT_DIR/hexciri-terminal" -e bash -c "$1"; }

case "$choice" in
  "Fingerprint"|"Fingerprint ✓")
    enter_term 'if ! command -v fprintd-enroll >/dev/null 2>&1; then echo "Installing fprintd (fingerprint support)..."; sudo pacman -S --noconfirm fprintd; fi; if command -v fprintd-enroll >/dev/null 2>&1; then fprintd-enroll; else echo "fprintd failed to install -- run: sudo pacman -S fprintd"; read -rp "Press Enter to close"; exit 0; fi; echo; read -rp "Enable touch-to-login at the greeter? (empty submits now, password still works) [y/N] " yn; if [[ $yn =~ ^[Yy]$ ]]; then sudo mkdir -p /etc/hexciri && sudo touch /etc/hexciri/fingerprint-enabled && sudo chmod 644 /etc/hexciri/fingerprint-enabled && (grep -Eq "^Fingerprint=" /usr/share/sddm/themes/hexciri/theme.conf 2>/dev/null && sudo sed -i -E "s/^Fingerprint=.*/Fingerprint=true/" /usr/share/sddm/themes/hexciri/theme.conf || printf "Fingerprint=true\n" | sudo tee -a /usr/share/sddm/themes/hexciri/theme.conf >/dev/null) && echo "touch-to-login ON (applies at next login)"; else sudo rm -f /etc/hexciri/fingerprint-enabled; if grep -Eq "^Fingerprint=" /usr/share/sddm/themes/hexciri/theme.conf 2>/dev/null; then sudo sed -i -E "s/^Fingerprint=.*/Fingerprint=false/" /usr/share/sddm/themes/hexciri/theme.conf; fi; echo "touch-to-login OFF"; fi; read -rp "Press Enter to close"'
    ;;
  "Fido2")
    enter_term 'echo "Plug in your FIDO2 key."; read -rp "It should register via your app. Configure: sudo systemctl enable fido2-token-gc; See arch-wiki FIDO2."; echo done'
    ;;
  "SSHD")
    enter_term 'if systemctl is-enabled sshd >/dev/null 2>&1; then sudo systemctl disable --now sshd && echo "ssh disabled"; else sudo systemctl enable --now sshd && echo "ssh enabled"; fi; read -rp "Press enter to close"'
    ;;
  "Passwordless Sudo")
    enter_term 'sudo tee /etc/sudoers.d/20-hexciri-$USER >/dev/null <<EOF
$USER ALL=(ALL) NOPASSWD: ALL
EOF
sudo chmod 440 /etc/sudoers.d/20-hexciri-$USER; echo "passwordless sudo enabled for $USER"; read -rp "Press enter to close"'
    ;;
  *) exec "$SCRIPT_DIR/hexciri-system" ;;
esac