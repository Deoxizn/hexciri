#!/bin/bash
# hexciri:menu=config-niri
# hexciri:summary=Edit niri config fragments (live scan — CachyOS and repo names both work)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bindir="${HEXCIRI_BIN_DIR:-}"
if [[ -z $bindir && -d $(dirname "$SCRIPT_DIR")/bin ]]; then bindir="$(dirname "$SCRIPT_DIR")/bin"; fi
bindir="${bindir:-$SCRIPT_DIR}"

niri_dir="${XDG_CONFIG_HOME:-$HOME/.config}/niri"

# Live scan, not a fixed table: CachyOS names its fragments differently
# (display/rules/layout) than the repo (monitors/window-rules/looknfeel).
# Offer whatever is actually on disk; config.kdl first.
rows=()
[[ -f $niri_dir/config.kdl ]] && rows+=("config.kdl")
while IFS= read -r f; do
  [[ $f == config.kdl ]] && continue
  rows+=("$f")
done < <(cd "$niri_dir" 2>/dev/null && ls cfg/*.kdl *.kdl 2>/dev/null | sort -u || true)
[[ ${#rows[@]} -gt 0 ]] || { echo "no niri config found in $niri_dir" >&2; exit 1; }

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  frag="$*"
else
  frag=$(
    printf '%s\n' "${rows[@]}" |
      "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Niri: ' --width=24 --lines=${#rows[@]}
  ) || exec "$SCRIPT_DIR/hexciri-config"   # Esc = back to config menu
fi
file=""
for r in "${rows[@]}"; do [[ $r == "$frag" ]] && file="$r"; done
if [[ -n $file ]]; then
  "$bindir/hexciri-edit-file" "$niri_dir/$file"
fi
