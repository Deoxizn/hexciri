#!/bin/bash
# hexciri:summary=GPU autodetect + setup: mesa/vulkan per vendor, nvidia-open 6xx (Turing+), 580xx (GTX 1xxx or older, from AUR)
# usage: hexciri-gpu [--kernel=stock|lts|omarchy|omarchy-bore] [--yes]
#   --kernel picks the default kernel (default: current-best for your card).
#   omarchy kernels are post-install personalization (System ▸ Kernel — they
#   ship as repo packages via the [omarchy] repo and update with pacman), and
#   are never the installer's default; legacy Maxwell/Pascal/Volta cards
#   (GTX 1xxx or older) get the 580xx legacy driver from the AUR, which builds
#   on stock and omarchy kernels alike (no LTS requirement).
set -euo pipefail

KERNEL_PICK=""
YES=false
while (($#)); do
  case "$1" in
    --kernel=*) KERNEL_PICK="${1#*=}"; shift ;;
    --kernel) KERNEL_PICK="${2:-}"; shift 2 ;;
    -y|--yes) YES=true; shift ;;
    --) shift ;;
    *) shift ;;
  esac
done
# accept short keys or full package names (linux-omarchy-bore -> omarchy-bore)
case "${KERNEL_PICK,,}" in
  ""|"auto") KERNEL_PICK="" ;;
  stock|linux) KERNEL_PICK=stock ;;
  lts|linux-lts) KERNEL_PICK=lts ;;
  omarchy|linux-omarchy) KERNEL_PICK=omarchy ;;
  omarchy-bore|linux-omarchy-bore) KERNEL_PICK=omarchy-bore ;;
esac
[[ -z $KERNEL_PICK || $KERNEL_PICK =~ ^(stock|lts|omarchy|omarchy-bore)$ ]] || { echo "hexciri-gpu: --kernel must be stock|lts|omarchy|omarchy-bore"; exit 1; }

info() { echo -e "\e[0;36m[hexciri:gpu]\e[0m $*"; }
ok()   { echo -e "\e[0;32m[hexciri:gpu]\e[0m $*"; }
err()  { echo -e "\e[0;31m[hexciri:gpu]\e[0m $*" >&2; }
confirm() { $YES && return 0; read -rp "$1 [y/N] " r </dev/tty; [[ $r =~ ^[Yy]$ ]]; }
reboot_now() { # installer sets HEXCIRI_NO_REBOOT=1 so it can finish first
  if [[ -n ${HEXCIRI_NO_REBOOT:-} ]]; then info "reboot required — finishing install first"; return 0; fi
  confirm "Reboot now?" && systemctl reboot
}

PCI_PATH="${HEXCIRI_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"
has_vendor() { # $1 = 0x10de etc, reads sysfs (no PCI wakeups)
  local d
  for d in "$PCI_PATH"/*; do
    [[ $(<"$d/vendor") == "$1" ]] || continue
    [[ $(<"$d/class") == 0x03* ]] && return 0
  done
  return 1
}
nvidia_id_ge() { # $1 = hex floor, true if any NVIDIA VGA/3D >= it
  local d
  for d in "$PCI_PATH"/*; do
    [[ $(<"$d/vendor") == "0x10de" ]] || continue
    [[ $(<"$d/class") == 0x03* ]] || continue
    (( $(<"$d/device") >= $1 )) && return 0
  done
  return 1
}
nvidia_legacy() { # Maxwell/Pascal/Volta: 0x1340..0x1e00 (GTX 1xxx or older)
  local d id
  for d in "$PCI_PATH"/*; do
    [[ $(<"$d/vendor") == "0x10de" ]] || continue
    [[ $(<"$d/class") == 0x03* ]] || continue
    id=$(<"$d/device")
    (( id >= 0x1340 && id < 0x1e00 )) && return 0
  done
  return 1
}

pkg() {
  local missing=()
  for p in "$@"; do pacman -Q "$p" &>/dev/null || missing+=("$p"); done
  ((${#missing[@]})) || return 0
  info "pacman: ${missing[*]}"
  sudo pacman -S --noconfirm --needed "${missing[@]}"
}

use_kernel() { # $1 = hexciri-kernel key; ensures installed + default
  info "kernel -> $1"
  hexciri-kernel run "$1"
}

set_default_entry() { # $1 = entry file name
  [[ -f /boot/loader/entries/$1 ]] || return 0
  if grep -q '^default ' /boot/loader/loader.conf 2>/dev/null; then
    sudo sed -i "s|^default .*|default $1|" /boot/loader/loader.conf
  else
    echo "default $1" | sudo tee -a /boot/loader/loader.conf >/dev/null
  fi
  echo "$1" | sudo tee /usr/share/hexciri/boot-default >/dev/null  # preserve across hexciri-sync
}

# ── shared Wayland/Niri bits for any NVIDIA card ──
nvidia_common() {
  info "NVIDIA Wayland plumbing (modeset, fbdev, early KMS, suspend)..."
  printf 'blacklist nouveau\noptions nouveau modeset=0\n' | sudo tee /etc/modprobe.d/hexciri-nvidia.conf >/dev/null
  printf 'options nvidia NVreg_PreserveVideoMemoryAllocations=1\n' | sudo tee /etc/modprobe.d/hexciri-nvidia-pm.conf >/dev/null
  if ! grep -q 'nvidia_drm' /etc/mkinitcpio.conf 2>/dev/null; then
    sudo cp -f /etc/mkinitcpio.conf "/etc/mkinitcpio.conf.bak.$(date +%s)"
    sudo sed -i 's/^MODULES=(\(.*\))/MODULES=(\1 nvidia nvidia_modeset nvidia_uvm nvidia_drm)/; s/  / /g' /etc/mkinitcpio.conf
  fi
  local changed=false
  for e in /boot/loader/entries/hexciri-*.conf; do
    [[ -f $e ]] || continue
    grep -q 'nvidia-drm.modeset=1' "$e" || { sudo sed -i 's/^options \(.*\)/options \1 nvidia-drm.modeset=1 nvidia-drm.fbdev=1/' "$e"; changed=true; }
  done
  $changed && sudo mkinitcpio -P || true
}

verify_nvidia_mod() { # confirm the -dkms module actually landed. Inside the
  # install chroot uname -r is the LIVE ISO kernel, so match on the modules dir.
  local okall=1
  for m in nvidia nvidia_modeset nvidia_drm nvidia_uvm; do
    compgen -G "/usr/lib/modules/*/updates/dkms/$m.ko*" >/dev/null \
      || { err "expected module $m missing"; okall=0; }
  done
  if (( okall )); then
    ok "nvidia kernel module(s) built"
    return 0
  fi
  err "nvidia kernel module NOT built — rebooting now lands on nouveau, which hard-locks after login on this generation"
  err "fix the build, then re-run: $(basename "$0")"
  return 1
}

# 580xx is EOL in the official repos (the 590 release dropped below Turing →
# 580xx left `extra` for the AUR). Build the AUR split in dependency order as a
# regular user (makepkg refuses root), then pacman-install each. The build user
# gets passwordless pacman so `makepkg -s` can pull missing deps, and the
# maintainer keys that sign the packages are imported first; if the keyserver is
# unreachable the build falls back to --skippgpcheck with a warning rather than
# bricking the install (the AUR tarball still arrives over TLS).
AUR_580XX_SPLIT=(nvidia-580xx-utils nvidia-580xx-dkms lib32-nvidia-580xx-utils opencl-nvidia-580xx lib32-opencl-nvidia-580xx)
AUR_580XX_KEYS=(E18447AC260021D31F3FF6C4C8A2A4774B8B63C4 E8B9AA39F054E30E8290D492C3C4820857F654FE)
aur_install_580xx() {
  local user dir p
  pkg git base-devel
  user="${HEXCIRI_USER:-}"
  [[ -n $user ]] || user="${SUDO_USER:-}"
  if [[ -z $user || $user == root ]]; then
    user="$(awk -F: '$3>=1000 && $3<2000 && $1!="nobody"{print $1; exit}' /etc/passwd)"
  fi
  [[ -n $user ]] || user="build"
  id "$user" &>/dev/null || useradd -m "$user"
  dir="/tmp/hexciri-580xx"
  rm -rf "$dir"; mkdir -p "$dir"; chown "$user:$user" "$dir"
  # makepkg -s installs deps via sudo pacman; scope that grant to pacman only
  printf '%s ALL=(root) NOPASSWD: /usr/bin/pacman\n' "$user" > /etc/sudoers.d/hexciri-aurbuild
  chmod 440 /etc/sudoers.d/hexciri-aurbuild
  sudo -u "$user" gpg --keyserver keyserver.ubuntu.com --recv-keys "${AUR_580XX_KEYS[@]}" >/dev/null 2>&1 || true
  for p in "${AUR_580XX_SPLIT[@]}"; do
    info "aur: building $p..."
    rm -rf "$dir/$p"
    sudo -u "$user" git clone -q "https://aur.archlinux.org/$p.git" "$dir/$p" \
      || { err "aur: could not clone $p"; rm -f /etc/sudoers.d/hexciri-aurbuild; return 1; }
    if ! ( cd "$dir/$p" && sudo -u "$user" makepkg -si --noconfirm ) 2>&1 \
         && ! ( cd "$dir/$p" && sudo -u "$user" makepkg -si --noconfirm --skippgpcheck ) 2>&1; then
      err "aur: $p failed to build"
      rm -f /etc/sudoers.d/hexciri-aurbuild
      return 1
    fi
  done
  rm -f /etc/sudoers.d/hexciri-aurbuild
  return 0
}

NVIDIA=false; LEGACY=false
has_vendor 0x10de && NVIDIA=true
nvidia_legacy && LEGACY=true

if $LEGACY; then
  info "legacy NVIDIA card detected (Maxwell/Pascal/Volta — GTX 1xxx or older)."
  # 580xx is the last driver line for these GPUs, but NVIDIA keeps new-kernel
  # compatibility fixes in it for its support lifetime — it builds on stock and
  # omarchy kernels, so no LTS pin/refusal. Respect the current boot default;
  # only when nothing is pinned does stock get picked (fresh-install default).
  if [[ -z $KERNEL_PICK ]]; then
    cur="$(awk '$1=="default"{print $2; exit}' /boot/loader/loader.conf 2>/dev/null || true)"
    case "$cur" in
      hexciri-linux-lts.conf)          KERNEL_PICK=lts ;;
      hexciri-linux-omarchy.conf)      KERNEL_PICK=omarchy ;;
      hexciri-linux-omarchy-bore.conf) KERNEL_PICK=omarchy-bore ;;
      hexciri-linux.conf)              KERNEL_PICK=stock ;;
      *) KERNEL_PICK=stock ;;
    esac
    info "kernel -> $KERNEL_PICK"
  fi
  confirm "Install 580xx legacy drivers (kernel: $KERNEL_PICK)?" || exit 0
  use_kernel "$KERNEL_PICK"
  headers=()
  for k in linux linux-lts linux-omarchy linux-omarchy-bore; do
    pacman -Q "$k" &>/dev/null && headers+=("$k-headers")
  done
  if ((${#headers[@]})); then pkg "${headers[@]}"; fi
  # 580xx is EOL in the official repos — build it from the AUR (the split
  # above). Runs fine inside the stage2 chroot: minimal PATH doesn't matter,
  # everything here is a sibling/absolute call.
  aur_install_580xx || exit 1
  nvidia_common
  verify_nvidia_mod || exit 1
  ok "legacy stack ready (580xx on $KERNEL_PICK). REBOOT required."
  reboot_now
  exit 0
fi

if $NVIDIA; then
  info "modern NVIDIA card detected (Turing+, GSP)."
  # Respect whatever hexciri kernel is already the boot default — never swap a
  # user's chosen kernel for stock on a re-run/update. Only when no --kernel
  # was passed AND no hexciri kernel is pinned does stock get picked (fresh).
  if [[ -z $KERNEL_PICK ]]; then
    cur="$(awk '$1=="default"{print $2; exit}' /boot/loader/loader.conf 2>/dev/null || true)"
    case "$cur" in
      hexciri-linux-lts.conf)          KERNEL_PICK=lts ;;
      hexciri-linux-omarchy.conf)      KERNEL_PICK=omarchy ;;
      hexciri-linux-omarchy-bore.conf) KERNEL_PICK=omarchy-bore ;;
      hexciri-linux.conf)              KERNEL_PICK=stock ;;
      *) : ;;
    esac
    if [[ -n $KERNEL_PICK ]]; then
      info "kernel -> $KERNEL_PICK (kept existing boot default)"
    else
      info "no hexciri kernel pinned — leaving boot kernel untouched"
    fi
  fi
  confirm "Install nvidia-open 6xx drivers (kernel: ${KERNEL_PICK:-unchanged})?" || exit 0
  if [[ -n $KERNEL_PICK ]]; then
    use_kernel "$KERNEL_PICK"
  fi
  headers=()
  for k in linux linux-lts linux-omarchy linux-omarchy-bore; do
    pacman -Q "$k" &>/dev/null && headers+=("$k-headers")
  done
  pkg "${headers[@]}" nvidia-open-dkms nvidia-utils lib32-nvidia-utils
  nvidia_common
  verify_nvidia_mod || exit 1
  ok "nvidia-open stack ready. REBOOT required."
  reboot_now
  exit 0
fi

# ── no NVIDIA: mesa/vulkan per vendor (also the base under hybrid laptops) ──
info "no NVIDIA card — mesa/vulkan stack."
pkgs=(mesa vulkan-icd-loader lib32-mesa lib32-vulkan-icd-loader)
has_vendor 0x8086 && pkgs+=(vulkan-intel lib32-vulkan-intel)
has_vendor 0x1002 && pkgs+=(vulkan-radeon lib32-vulkan-radeon)
pkg "${pkgs[@]}"
ok "graphics stack ready (no reboot needed)."
