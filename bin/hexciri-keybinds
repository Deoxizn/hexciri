#!/bin/bash
# hexciri:keybinds=searchable-list
# hexciri:summary=Per-WM keybinding cheatsheet — only binds actually emitted for the active WM
# Walks config/keybinds/intents.toml using the SAME bound-check rules as
# hexciri-keybinds-render, so this lists exactly what the active WM binds now.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
INTENTS="$SCRIPT_DIR/../config/keybinds/intents.toml"
WM="$("$SCRIPT_DIR/hexciri-session" wm)"

export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
output=$(python3 - "$INTENTS" "$WM" <<'EOF'
import sys
try:
    import tomllib
    from key_translate import hyp_dsp
except ImportError:
    sys.stderr.write("python3 too old or key_translate missing: tomllib unavailable\n")
    sys.exit(1)

INTENTS_FILE, WM = sys.argv[1], sys.argv[2]
cfg = tomllib.load(open(INTENTS_FILE, "rb"))
keys, intents = cfg["keys"], cfg["intents"]

def bound(intent):
    s = intents[intent]
    if s.get("type") == "spawn":
        return True
    action = s.get(WM, s.get("niri", "(See NOTE)"))
    if action is None:
        return False
    if action.endswith("via hexciri-compositor)"):
        return True
    if action.startswith("("):
        return False
    if WM == "hyprland":
        return hyp_dsp(action) is not None
    return True

rows = []
for combo in sorted(keys, key=lambda c: (len(c), c)):
    intent = keys[combo]
    if not bound(intent):
        continue
    desc = intents[intent].get("desc", intent)
    rows.append(f"{combo:<22} {desc}")

if not rows:
    print("No keybinds bound for active WM", end="", file=sys.stderr)
    sys.exit(1)
print("\n".join(rows))
EOF
) || exit 1

echo -n "$output" | "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt="Keybinds (${WM}): " --width=52 --lines=30