#!/bin/bash
# hexciri:keybinds=searchable-list
# hexciri:summary=Searchable keybinding reference — built from the intent schema for the active WM
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTENTS="$SCRIPT_DIR/../config/keybinds/intents.toml"
WM="$("$SCRIPT_DIR/hexciri-session" wm)"

output=$(python3 - "$INTENTS" "$WM" <<'EOF'
import sys

INTENTS_FILE, WM = sys.argv[1], sys.argv[2]
try:
    import tomllib
except ImportError:
    sys.stderr.write("python3 too old: tomllib unavailable\n")
    sys.exit(1)

with open(INTENTS_FILE, "rb") as f:
    cfg = tomllib.load(f)

keys, intents = cfg["keys"], cfg["intents"]
rows = []
for combo in sorted(keys, key=lambda c: (len(c.lower()), c.lower())):
    intent_name = keys[combo]
    spec = intents.get(intent_name)
    if spec is None:
        continue
    if spec.get("type") == "spawn":
        desc = spec["command"]
    else:
        desc = spec.get(WM, spec.get("niri", "(no mapping)"))
    rows.append(f"{combo} — {desc}")

if not rows:
    print("No keybinds found in intent schema", end="", file=sys.stderr)
    sys.exit(1)
print("\n".join(rows))
EOF
) || exit 1

echo -n "$output" | "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt="Keybinds: " --width=46 --lines=30