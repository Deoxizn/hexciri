#!/bin/bash
# hexciri:menu=config-state
# hexciri:summary=Edit hexciri state lists (keybinds, search provider)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bindir="${HEXCIRI_BIN_DIR:-}"
if [[ -z $bindir && -d $(dirname "$SCRIPT_DIR")/bin ]]; then bindir="$(dirname "$SCRIPT_DIR")/bin"; fi
bindir="${bindir:-$SCRIPT_DIR}"

# Shipped catalog = the repo checkout the command symlinks into (HEXCIRI_PATH
# overrides when run outside the repo, e.g. bootstrap seeding).
here="$(readlink -f "$SCRIPT_DIR" 2>/dev/null || echo "$SCRIPT_DIR")"
shipped_base="${HEXCIRI_PATH:-$(dirname "$here")}"

cfg_xdg="${XDG_CONFIG_HOME:-$HOME/.config}"

rows=(
  'Keybinds list'
  'Search provider'
)

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
  choice=$(
    printf '%s\n' "${rows[@]}" |
      "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='State files: ' --width=28 --lines=2
  ) || exec "$SCRIPT_DIR/hexciri-config"   # Esc = back to config menu
fi

case "$choice" in
  'Keybinds list')
    dir="$cfg_xdg/hexciri/keybinds"
    mkdir -p "$dir"
    list="$dir/descriptions.list"
    shipped="$shipped_base/config/keybinds/descriptions.list"
    if [[ ! -f $list ]]; then
      cp -f "$shipped" "$list" 2>/dev/null || { echo "hexciri-config: no descriptions list to seed from ($shipped)" >&2; exit 1; }
    fi
    "$bindir/hexciri-edit-file" "$list" ;;
  'Search provider')
    exec "$bindir/hexciri-search-provider" ;;
esac
