#!/bin/bash
# hexciri:summary=Point application/pdf at the PDF default (heals browser-stolen default, user-phase)
# Browsers register application/pdf in their MimeType and take the default on
# install/first-run. This pins it back to your PDF default (mupdf out of the
# box, whatever you picked in System > Default Apps > PDF afterwards) — but
# ONLY when a browser currently owns it or nothing handles it. Anything else
# already in the slot (a manual xdg pick, another reader) is a deliberate
# choice and stays. Idempotent and safe to run on every sync.
set -euo pipefail

BROWSER_PATTERN='(brave|chromium|chrome|firefox|falkon|palemoon|librewolf|vivaldi|edge)'

PDF_DEFAULT="$(cat "$HOME/.local/state/hexciri/defaults/pdf" 2>/dev/null || echo mupdf)"
[[ -n $PDF_DEFAULT ]] || PDF_DEFAULT=mupdf

# first existing desktop file for a reader, or nothing (never point xdg at a
# reader that isn't installed — e.g. a picked-then-removed one).
pdf_desktop() {
  local d
  case "$1" in
    mupdf) set -- mupdf.desktop ;;
    zathura) set -- org.pwmt.zathura.desktop zathura.desktop ;;
    evince) set -- org.gnome.Evince.desktop evince.desktop ;;
    okular) set -- org.kde.okular.desktop okular.desktop ;;
    *) return 1 ;;
  esac
  for d in "$@"; do
    [[ -f /usr/share/applications/$d || -f /usr/local/share/applications/$d || -f $HOME/.local/share/applications/$d ]] \
      && { printf '%s\n' "$d"; return 0; }
  done
  return 1
}

# if a browser owns the MIME, that's the "broken" state to heal; anything else
# in the slot is a user's deliberate choice and stays.
needs_healing() {
  local cur
  cur="$(xdg-mime query default application/pdf 2>/dev/null || true)"
  [[ -z $cur ]] && return 0
  [[ $cur =~ $BROWSER_PATTERN ]]
}

healed_any=0
if target="$(pdf_desktop "$PDF_DEFAULT" || true)"; [[ -n ${target:-} ]]; then
  if needs_healing; then
    xdg-mime default "$target" application/pdf 2>/dev/null || true
    healed_any=1
  fi
fi

[[ $healed_any == 1 ]] && echo "pdf default applied (browser-stolen PDF MIME healed)"
exit 0
