#!/bin/bash
# hexciri:summary=Cycle Hyprland tiling layouts (dwindle/scrolling/monocle)
# usage: hexciri-hyprland-layout [next|prev|<name>]  (default: next)
# Rotates through the compositor's tiling layouts: dwindle, scrolling and
# monocle are all built into current Hyprland (verified live). Master is
# deliberately OUT: nothing about it survives losing to the other three on
# this box. Bound to Mod+L on hyprland (Omarchy parity; the stock L
# session-lock is neutralized at deploy since hexciri-lock owns Ctrl+L).
#
# Mechanism: writes the layout into config/hexciri-layout.lua (owned file,
# required from hyprland.lua) and reloads. eval sets the global only and
# live workspaces follow slowly if at all; injected workspace rules never
# land on the lua parser (verified both). File + reload applies instantly
# to every workspace and survives relogin (unlike eval).
set -euo pipefail

LAYOUTS=(dwindle scrolling monocle)

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
MISC_FILE="$HYPR_DIR/config/misc.lua"

# Live layout state is a marked block in misc.lua (looknfeel-adjacent, never
# theme-owned). The cycler patches the layout value in place; deploy seeds
# the block when absent. One fewer file, same instant file+reload apply.

# uwsm-managed Hyprland omits HYPRLAND_INSTANCE_SIGNATURE from its own
# environ, so the Mod+L bind inherits a sig-less env and every hyprctl call
# dies with "not set!". Resolve from the runtime dir (newest first) when
# unset — same block as hexciri-compositor.
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  _hdir="/run/user/${UID:-$(id -u)}/hypr"
  if [[ -d $_hdir ]]; then
    _sig="$(ls -t "$_hdir" 2>/dev/null | head -n1 || true)"
    [[ -n $_sig ]] && export HYPRLAND_INSTANCE_SIGNATURE="$_sig"
  fi
  unset _hdir _sig
fi

# python3 (stdlib only), never jq: fresh/partial boxes may lack jq while
# python3 ships with the system (same rule as terminal-smart.sh).
current_layout() {
  local cur=""
  # Per-workspace-aware: the live tiled layout is the honest rotation base.
  cur="$(hyprctl activeworkspace -j 2>/dev/null | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("tiledLayout") or "")
except Exception: print("")' 2>/dev/null || true)"
  [[ -z $cur ]] && cur="$(hyprctl getoption general:layout -j 2>/dev/null | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("str") or "")
except Exception: print("")' 2>/dev/null || true)"
  if [[ -z $cur ]]; then
    cur="$(hyprctl getoption general:layout 2>/dev/null | grep -oE '"(dwindle|master|scrolling|monocle|[a-z]+)"' | head -1 | tr -d '"' || true)"
  fi
  printf '%s' "${cur:-dwindle}"
}

write_layout() { # <name> — patches the marked block in misc.lua
  LAY_NEW="$1" LAY_FILE="$MISC_FILE" python3 <<'PYEOF' || return 1
import os, re
p = os.environ["LAY_FILE"]
new = os.environ["LAY_NEW"]
start = "-- ── HEXCIRI layout ──"
t = open(p).read()
pat = re.compile(r'(?<=general = \{\n        layout = ")[a-z]+(?=",\n    \},\n\}\))')
assert start in t, "layout block missing (run hexciri-update self to seed it)"
t2, n = pat.subn(new, t, count=1)
assert n == 1, "layout value line not found"
open(p, "w").write(t2)
PYEOF
}

mode="${1:-next}"
cur="$(current_layout)"
idx=-1
for i in "${!LAYOUTS[@]}"; do
  [[ ${LAYOUTS[$i]} == "$cur" ]] && idx=$i
done

case "$mode" in
  next) next=${LAYOUTS[$(( (idx + 1) % ${#LAYOUTS[@]} ))]} ;;
  prev) next=${LAYOUTS[$(( (idx - 1 + ${#LAYOUTS[@]}) % ${#LAYOUTS[@]} ))]} ;;
  *)
    next=""
    for l in "${LAYOUTS[@]}"; do
      [[ $l == "$mode" ]] && next=$l
    done
    if [[ -z $next ]]; then
      echo "hexciri-hyprland-layout: unknown layout '$mode' (have: ${LAYOUTS[*]})" >&2
      exit 1
    fi
    ;;
esac

ensure_required() {
  [[ -f $MISC_FILE ]] || return 0
  grep -qxF -- "-- ── HEXCIRI layout ──" "$MISC_FILE" 2>/dev/null && return 0
  { printf '\n-- ── HEXCIRI layout ──\n'; printf 'hl.config({\n    general = {\n        layout = "dwindle",\n    },\n})\n'; printf -- '-- ── END HEXCIRI layout ──\n'; } >> "$MISC_FILE"
}

ensure_required
write_layout "$next"
hyprctl reload >/dev/null 2>&1 || exit 1
# Reload applies to every workspace, but give the compositor a beat before
# calling it a failure instead of notifying a lie.
got=""
for _ in 1 2 3 4 5 6; do
  got="$(current_layout)"
  [[ $got == "$next" ]] && break
  sleep 0.5
done
if [[ $got != "$next" ]]; then
  echo "hexciri-hyprland-layout: set $next but compositor reports $got" >&2
  exit 1
fi
notify-send "Layout" "$next" 2>/dev/null || true
echo "$next"
