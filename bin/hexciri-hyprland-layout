#!/bin/bash
# hexciri:summary=Cycle Hyprland tiling layouts (dwindle/scrolling/monocle)
# usage: hexciri-hyprland-layout [next|prev|<name>]  (default: next)
# Rotates through the compositor's tiling layouts: dwindle, scrolling and
# monocle are all built into current Hyprland (verified live — each eval
# applies with set:true, no plugin needed). Master is deliberately OUT:
# nothing about it survives losing to the other three on this box. Bound to
# Bound to Mod+L on hyprland (Omarchy parity; the stock L session-lock is
# neutralized at deploy since hexciri-lock owns Ctrl+L).
set -euo pipefail

# uwsm-managed Hyprland omits HYPRLAND_INSTANCE_SIGNATURE from its own
# environ, so the Mod+T bind inherits a sig-less env and every hyprctl call
# dies with "not set!". Resolve from the runtime dir (newest first) when
# unset — same block as hexciri-compositor.
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  _hdir="/run/user/${UID:-$(id -u)}/hypr"
  if [[ -d $_hdir ]]; then
    _sig="$(ls -t "$_hdir" 2>/dev/null | head -n1 || true)"
    [[ -n $_sig ]] && export HYPRLAND_INSTANCE_SIGNATURE="$_sig"
  fi
  unset _hdir _sig
fi

LAYOUTS=(dwindle scrolling monocle)

current_layout() {
  local cur=""
  if command -v jq >/dev/null 2>&1; then
    # Per-workspace-aware first: a workspace rule pinning a layout beats the
    # global option, so the effective layout is the honest rotation base.
    cur="$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.tiledLayout // empty' 2>/dev/null || true)"
    [[ -z $cur ]] && cur="$(hyprctl getoption general:layout -j 2>/dev/null | jq -r '.str // empty' 2>/dev/null || true)"
  fi
  if [[ -z $cur ]]; then
    cur="$(hyprctl getoption general:layout 2>/dev/null | grep -oE '"(dwindle|master|scrolling|monocle|[a-z]+)"' | head -1 | tr -d '"' || true)"
  fi
  printf '%s' "${cur:-dwindle}"
}

mode="${1:-next}"
cur="$(current_layout)"
idx=-1
for i in "${!LAYOUTS[@]}"; do
  [[ ${LAYOUTS[$i]} == "$cur" ]] && idx=$i
done

case "$mode" in
  next) next=${LAYOUTS[$(( (idx + 1) % ${#LAYOUTS[@]} ))]} ;;
  prev) next=${LAYOUTS[$(( (idx - 1 + ${#LAYOUTS[@]}) % ${#LAYOUTS[@]} ))]} ;;
  *)
    next=""
    for l in "${LAYOUTS[@]}"; do
      [[ $l == "$mode" ]] && next=$l
    done
    if [[ -z $next ]]; then
      echo "hexciri-hyprland-layout: unknown layout '$mode' (have: ${LAYOUTS[*]})" >&2
      exit 1
    fi
    ;;
esac

# Live-apply: this box runs the Lua config (non-legacy parser), where
# `hyprctl keyword` is a no-op ("use eval"). The same hl.config() call the
# config files make applies live through eval. Verify after set: on a
# compositor missing the target, getoption won't move — fail loudly instead
# of notifying a lie.
hyprctl eval "hl.config({ general = { layout = \"$next\" } })" >/dev/null 2>&1 || exit 1
got="$(current_layout)"
if [[ $got != "$next" ]]; then
  echo "hexciri-hyprland-layout: set $next but compositor reports $got" >&2
  exit 1
fi
notify-send "Layout" "$next" 2>/dev/null || true
echo "$next"
