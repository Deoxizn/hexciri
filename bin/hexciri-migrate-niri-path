#!/bin/bash
# hexciri:summary=Add ~/.local/bin to the niri config's PATH (pre-0.1.3 one-time migration)
# pre-0.1.3 installs hard-copied commands to /usr/local/bin (always on PATH) and shipped a
# niri config.kdl with no PATH line. v2 symlinks commands into ~/.local/bin instead,
# so a legacy config left behind makes every `spawn "hexciri-*"` keybind fail with
# "command not found". This injects the same PATH the stock config ships, only when
# it's missing, and backs the config up first. Idempotent; safe to run any time.
set -euo pipefail

CFG="${NIRI_CONFIG:-$HOME/.config/niri/config.kdl}"
# cfg/ layout (only config.kdl at top); fall back to the pre-cfg/ flat path.
if [[ -n ${NIRI_ENV_CONFIG:-} ]]; then
  ENV_CFG="$NIRI_ENV_CONFIG"
elif [[ -f $HOME/.config/niri/cfg/env.kdl ]]; then
  ENV_CFG="$HOME/.config/niri/cfg/env.kdl"
else
  ENV_CFG="$HOME/.config/niri/env.kdl"
fi
HEXCIRI_BIN="${HEXCIRI_BIN:-$HOME/.local/bin}"
STOCK_PATH="$HEXCIRI_BIN:/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl"

command -v niri >/dev/null 2>&1 || { echo "hexciri-migrate-niri-path: niri not installed — skipping"; exit 0; }
[[ -f $ENV_CFG ]] || [[ -f $CFG ]] || { echo "hexciri-migrate-niri-path: no niri config at $CFG ($ENV_CFG) — skipping"; exit 0; }

# Split layout: the PATH lives in the env.kdl fragment; patch that. Legacy
# monolith (no env.kdl): patch the environment block inside config.kdl.
if [[ -f $ENV_CFG ]]; then
  TARGET="$ENV_CFG"
  [[ -f $CFG && "$(grep -c '^environment' "$CFG" || true)" -gt 0 ]] && echo "hexciri-migrate-niri-path: note: legacy environment block found in $CFG — split layout uses env.kdl, ignoring" >&2 || true
else
  TARGET="$CFG"
fi

is_patched() {
  awk -v path="$STOCK_PATH" '
    /^environment[[:space:]]*\{[[:space:]]*$/ { in_env=1; next }
    in_env && /^[[:space:]]*\}/ { in_env=0; next }
    in_env && $0 ~ /PATH[[:space:]]*"/ && $0 ~ path { found=1 }
    END { exit found ? 0 : 1 }
  ' "$TARGET"
}

if is_patched; then
  echo "hexciri-migrate-niri-path: ~/.local/bin already on PATH in $TARGET — nothing to do"
  exit 0
fi

# Rewrite: drop any PATH line inside the environment block, then insert the stock
# PATH (which leads with ~/.local/bin) right after `environment {`.
TMP="${TARGET}.tmp.$$"
awk -v path="$STOCK_PATH" '
  /^environment[[:space:]]*\{[[:space:]]*$/ { in_env=1; print; print "    PATH \"" path "\""; next }
  in_env && /^[[:space:]]*\}/ { in_env=0; print; next }
  in_env && $1 == "PATH" { next }   # stale/legacy PATH line — replaced by the stock one
  { print }
' "$TARGET" > "$TMP"

if cmp -s "$TARGET" "$TMP"; then
  rm -f "$TMP"
  echo "hexciri-migrate-niri-path: no change needed for $TARGET"
  exit 0
fi

cp -f "$TARGET" "$TARGET.bak.$(date +%s)"
mv -f "$TMP" "$TARGET"
echo "hexciri-migrate-niri-path: injected ~/.local/bin PATH into $TARGET (backup saved)"

# Reload the compositor so the fix is live immediately (no-op outside a session)
"$HOME/.local/opt/hexciri/bin/hexciri-compositor" load-config >/dev/null 2>&1 \
  && echo "hexciri-migrate-niri-path: compositor config reloaded"