#!/bin/bash
# hexciri:themes-list=theme-browser
# hexciri:summary=Switch hexciri themes via a themed fuzzel menu with preview images
set -euo pipefail

# Resolve the repo root through the script file itself (which may be invoked
# via a ~/.local/bin symlink) — dirname of the resolved file is repo/bin, its
# parent is the repo. HEXCIRI_PATH feeds find_preview's repo themes lookup.
here="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
HEXCIRI_PATH="${HEXCIRI_PATH:-$(dirname "$(dirname "$here")")}"
bindir="${HEXCIRI_BIN_DIR:-$(dirname "$here")}"
SCRIPT_DIR="$(dirname "${BASH_SOURCE[0]}")"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hexciri/theme-selector/previews"
mkdir -p "$cache_dir"

current=$("$bindir/hexciri-theme-current" 2>/dev/null)

find_preview() {
  local name=$1 dir ext src base theme_path

  dir=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

  for ext in png jpg jpeg webp gif bmp; do
    [[ -e $cache_dir/$dir.$ext ]] && { printf '%s\n' "$cache_dir/$dir.$ext"; return; }
  done

  theme_path=""
  for base in "$HOME/.config/hexciri/themes" "$HEXCIRI_PATH/themes"; do
    [[ -d $base/$dir ]] && { theme_path=$base/$dir; break; }
  done
  [[ -n $theme_path ]] || return 0

  src=""
  for ext in png jpg jpeg webp gif bmp; do
    [[ -f $theme_path/preview.$ext ]] && { src=$theme_path/preview.$ext; break; }
  done

  if [[ -z $src && -d $theme_path/backgrounds ]]; then
    src=$(find -L "$theme_path/backgrounds" -maxdepth 1 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \) |
      sort | head -n 1)
  fi
  [[ -n $src ]] || return 0

  ext=${src##*.}
  ln -sfn "$src" "$cache_dir/$dir.${ext,,}"
  printf '%s\n' "$cache_dir/$dir.${ext,,}"
}

choice=$(
  "$bindir/hexciri-theme-list" |
    while read -r name; do
      marker=""
      [[ $name == "$current" ]] && marker="▶ "
      if preview=$(find_preview "$name") && [[ -n $preview ]]; then
        printf '%s%s\0icon\x1f%s\n' "$marker" "$name" "$preview"
      else
        printf '%s%s\n' "$marker" "$name"
      fi
    done |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --width=44 --lines=5 \
      --line-height=150 --horizontal-pad=12 --vertical-pad=6 \
      --hide-prompt
) || exec "$SCRIPT_DIR/hexciri-themes"

theme=$(printf '%s' "$choice" | sed -E 's/icon\x1f.*//')
theme=${theme#▶ }
[[ -n $theme ]] || exit 0

nohup "$bindir/hexciri-theme-set" "$theme" >/dev/null 2>&1 &