#!/bin/bash
# hexciri:summary=Kernel menu: stock linux/lts (any channel) + cachyos prebuilt kernels (per-CPU tier, direct fetch)
# No repo adoption for cachyos: packages install as local files via hexciri-cachyos,
# updates ride hexciri-update. systemd-boot entries only. Stock kernel kept as fallback.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bindir="${HEXCIRI_BIN_DIR:-}"
if [[ -z $bindir && -d $(dirname "$SCRIPT_DIR")/bin ]]; then bindir="$(dirname "$SCRIPT_DIR")/bin"; fi
bindir="${bindir:-$SCRIPT_DIR}"

declare -A KERNEL_PKGS=(
  [stock]="linux"
  [lts]="linux-lts"
  [cachyos]="linux-cachyos"
  [cachyos-bore]="linux-cachyos-bore"
  [cachyos-lts]="linux-cachyos-lts"
)

info() { echo -e "\e[0;36m[hexciri]\e[0m $*"; }
ok()   { echo -e "\e[0;32m[hexciri]\e[0m $*"; }
warn() { echo -e "\e[1;33m[hexciri]\e[0m $*" >&2; }
err()  { echo -e "\e[0;31m[hexciri]\e[0m $*" >&2; }

set_default_entry() { # $1 = systemd-boot entry file name
  if [[ -f /boot/loader/entries/$1 ]]; then
    if grep -q "^default " /boot/loader/loader.conf 2>/dev/null; then
      sudo sed -i "s|^default .*|default $1|" /boot/loader/loader.conf
    else
      echo "default $1" | sudo tee -a /boot/loader/loader.conf >/dev/null
    fi
    # record the pin so hexciri-sync preserves it across package transactions
    echo "$1" | sudo tee /usr/share/hexciri/boot-default >/dev/null
    ok "systemd-boot default -> $1 (stock kept as fallback)"
  else
    warn "entry $1 not there yet — hexciri-sync writes it on the next package transaction (or run: sudo hexciri-sync)"
  fi
}

do_kernel() {
  local key=$1 base=${KERNEL_PKGS[$1]:-}
  [[ -n $base ]] || { err "unknown kernel '$1'"; exit 1; }

  if pacman -Q "$base" &>/dev/null; then
    ok "$base already installed"
  else
    case "$key" in
      cachyos|cachyos-bore|cachyos-lts)
        # direct per-CPU fetch (hexciri-cachyos needs root for pacman -U)
        sudo "$bindir/hexciri-cachyos" install "$base"
        ;;
      *)
        info "installing $base + headers from configured repos..."
        sudo pacman -S --noconfirm "$base" "$base-headers"
        ;;
    esac
  fi

  # mkinitcpio preset drops vmlinuz/initramfs; hexciri-sync (PostTransaction)
  # or a manual run generates /boot/loader/entries/hexciri-$base.conf
  set_default_entry "hexciri-$base.conf"
}

do_status() {
  for k in stock lts cachyos cachyos-bore cachyos-lts; do
    if pacman -Q "${KERNEL_PKGS[$k]}" &>/dev/null; then
      echo "installed: $k (${KERNEL_PKGS[$k]} $(pacman -Q "${KERNEL_PKGS[$k]}" | cut -d' ' -f2))"
    fi
  done
  echo "default: $(grep '^default ' /boot/loader/loader.conf 2>/dev/null || echo '(none set)')"
  if command -v "$bindir/hexciri-cachyos" &>/dev/null; then
    echo "cachyos tier: $("$bindir/hexciri-cachyos" tier 2>/dev/null || echo 'n/a')"
  fi
}

if [[ ${1:-} == run ]]; then
  shift
  case ${1:-} in
    status) do_status ;;
    scheduler-run) exec "$SCRIPT_DIR/hexciri-scheduler" run ;;
    stock|lts|cachyos|cachyos-bore|cachyos-lts) do_kernel "$1" ;;
    *) err "unknown action '$1'"; exit 1 ;;
  esac
  exit 0
fi

# menu mode (fuzzel when available, numbered fallback)
run_via_terminal() { # <key> — do the action in a visible terminal, hold open for review
  local key=$1
  exec "$SCRIPT_DIR/hexciri-terminal" -e "$SCRIPT_DIR/hexciri-hold" "$0" run "$key"
}

if command -v hexciri-fuzzel &>/dev/null; then
  choice="$(printf '%s\n' 'Recommended — auto-detect scheduler' 'Stock — linux' 'LTS — linux-lts' 'CachyOS — linux-cachyos (EEVDF)' 'CachyOS BORE — linux-cachyos-bore' 'CachyOS LTS — linux-cachyos-lts' 'Status' | hexciri-fuzzel --dmenu --prompt='Kernel: ' --width=36 --lines=7)" || exec "$SCRIPT_DIR/hexciri-system"   # Esc = back to System menu
  case "$choice" in
    Recommended*) run_via_terminal scheduler-run ;;
    Stock*)  run_via_terminal stock ;;
    LTS*)    run_via_terminal lts ;;
    CachyOS\ BORE*) run_via_terminal cachyos-bore ;;
    CachyOS\ LTS*)  run_via_terminal cachyos-lts ;;
    CachyOS*) run_via_terminal cachyos ;;
    Status)  run_via_terminal status ;;
  esac
else
  do_status
fi