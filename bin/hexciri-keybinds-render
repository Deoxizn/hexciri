#!/bin/bash
# hexciri:summary=Render the keybind block for a WM from config/keybinds/intents.toml
# hexciri:args=[wm] — default: active WM (hexciri-session wm). Prints config block to stdout.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
INTENTS="$SCRIPT_DIR/../config/keybinds/intents.toml"
WM="${1:-$("$SCRIPT_DIR/hexciri-session" wm)}"

case "$WM" in
  niri|hyprland|sway|mango) ;;
  *) echo "hexciri-keybinds-render: unknown WM '$WM'" >&2; exit 1 ;;
esac

python3 - "$INTENTS" "$WM" <<'EOF'
import re
import sys
try:
    import shlex
    import tomllib
except ImportError:
    sys.stderr.write("python3 too old: shlex/tomllib unavailable\n"); sys.exit(1)

INTENTS_FILE, WM = sys.argv[1], sys.argv[2]
cfg = tomllib.load(open(INTENTS_FILE, "rb"))
keys, intents = cfg["keys"], cfg["intents"]

# ── per-WM syntax helpers ────────────────────────────────────────────────
def key_niri(c):
    return c.replace("Mod", "Mod")

def key_hyp_lua(c):
    # niri key names -> xkbcommon keysym names, joined with " + " per the 0.56
    # Lua API (e.g. hl.bind("SUPER + Q", …)). Names are the segment after
    # XKB_KEY_ (wiki Binds: "the name you should use is the segment after XKB_KEY_").
    m = {"Print":"Print","Return":"Return","grave":"grave","BracketLeft":"bracketleft",
         "BracketRight":"bracketright","Comma":"comma","Escape":"Escape","Space":"space",
         "Up":"Up","Down":"Down","Left":"Left","Right":"Right"}
    out = []
    for p in c.split("+"):
        p = m.get(p, p)
        if p == "Mod":
            out.append("SUPER")
        elif p in ("Ctrl","Shift","Alt"):
            out.append(p.upper())
        else:
            out.append(p)
    return " + ".join(out)

def lua_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'

def hyp_dsp(action):
    # legacy-hyprlang dispatcher token → native 0.56 Lua hl.dsp expression.
    # Returns None for "no sibling" notes (caller emits a `-- comment` instead).
    a = action.strip() if isinstance(action, str) else ""
    if a.startswith("(") or a.startswith("overview"):
        return None
    if a == "closeactive":
        return "hl.dsp.window.close()"
    m = re.match(r"^movefocus ([lrud])$", a)
    if m:
        return f"hl.dsp.focus({{ direction = '{m.group(1)}' }})"
    m = re.match(r"^movewindow ([lrud])$", a)
    if m:
        return f"hl.dsp.window.move({{ direction = '{m.group(1)}' }})"
    m = re.match(r"^movetoworkspace (\d+)$", a)
    if m:
        return f"hl.dsp.window.move({{ workspace = {m.group(1)}, follow = true }})"
    m = re.match(r"^movetoworkspacesilent name:(.+)$", a)
    if m:
        return f"hl.dsp.window.move({{ workspace = {lua_str(m.group(1))}, follow = false }})"
    m = re.match(r"^workspace (\d+)$", a)
    if m:
        return f"hl.dsp.focus({{ workspace = {m.group(1)} }})"
    m = re.match(r"^workspace name:(.+)$", a)
    if m:
        return f"hl.dsp.focus({{ workspace = {lua_str(m.group(1))} }})"
    m = re.match(r"^workspace (e[+-]\d+)$", a)
    if m:
        return f"hl.dsp.focus({{ workspace = {lua_str(m.group(1))} }})"
    if a == "togglefloating":
        return "hl.dsp.window.float({ action = \"toggle\" })"
    if a == "togglefloating maximize":
        return "hl.dsp.window.fullscreen({ mode = \"maximized\", action = \"toggle\" })"
    if a == "fullscreen":
        return "hl.dsp.window.fullscreen({ action = \"toggle\" })"
    if a == "resizeactive":
        return "hl.dsp.window.resize()"
    if a == "togglegroup":
        return "hl.dsp.group.toggle()"
    if a == "focusmode floating":
        return "hl.dsp.focus({ window = \"floating\" })"
    if a == "focusmode tiling":
        return "hl.dsp.focus({ window = \"tiled\" })"
    m = re.match(r"^swapwindow ([lr])$", a)
    if m:
        return f"hl.dsp.window.swap({{ direction = '{m.group(1)}' }})"
    # any other token (layout binds that have no Lua sibling yet) → visible NOTE
    return None

def key_sway(c):
    # niri -> sway keycode names
    m = {"Print":"Print","Return":"Return","grave":"grave","BracketLeft":"bracketleft",
         "BracketRight":"bracketright","Comma":"comma","Escape":"Escape","Space":"space"}
    parts = c.split("+")
    mods=""
    sub=""
    for p in parts:
        if p == "Mod": mods += "Mod4+"
        elif p == "Ctrl": mods += "Ctrl+"
        elif p == "Shift": mods += "Shift+"
        elif p == "Alt": mods += "Mod1+"
        else: sub = m.get(p, p)
    return f"{mods}{sub}"

def key_mango(c):
    # niri names -> mango: SUPER/CTRL/ALT/SHIFT mods (uppercase is fine — the
    # shipped config mixes case and mango matches case-insensitively), then the
    # KEY as an xkb keysym name EXACTLY as `wev` prints it. Letter and punctuation
    # keysyms are LOWERCASE: "C" would bind keysym C (shift+c), not the c key,
    # silently killing every letter binding. Mango's own default config uses
    # `SUPER,r`, `Alt,space`, `Return`, `Left`… so lowercase everything except
    # XF86* multimedia names (which keep their case).
    m = {"Mod": "SUPER", "Ctrl": "CTRL", "Alt": "ALT", "Shift": "SHIFT"}
    mods, key = [], ""
    for p in c.split("+"):
        p = m.get(p, p)
        if p in ("SUPER", "CTRL", "ALT", "SHIFT"):
            mods.append(p)
        else:
            key = p
    if not key.startswith("XF86"):
        key = key.lower()
    return ("+".join(mods) if mods else "NONE") + "," + key

lines = []
if WM in ("niri",):
    # Standalone fragment for config/niri/keybinds.kdl — the whole `binds {}`
    # block lives here, included by the entry config.kdl. niri MERGES binds
    # sections across includes, so this stays the single block.
    lines.append("// Keybinds — rendered from config/keybinds/intents.toml")
    lines.append("// Niri has NO default binds — this block defines ALL of them.")
    lines.append("// \"Mod\" = Super key. Regenerate with: hexciri-keybinds-render niri > config/niri/keybinds.kdl")
    lines.append("binds {")
    for combo in sorted(keys, key=lambda c: (len(c), c)):
        s = intents[keys[combo]]
        if s["type"] == "spawn":
            args = " ".join('"{}"'.format(a.replace('"', r'\"')) for a in shlex.split(s["command"]))
            lines.append(f"    {key_niri(combo)} {{ spawn {args}; }}")
        else:
            action = s.get(WM, s.get("niri"))
            lines.append(f"    {key_niri(combo)} {{ {action}; }}")
    lines.append("}")
elif WM == "hyprland":
    # Native 0.56 Lua fragment — required by hyprland.lua as "hypr.conf.keybinds".
    lines.append("-- Keybinds — rendered from config/keybinds/intents.toml (single source of truth).")
    lines.append("-- Included automatically via require(\"hypr.conf.keybinds\") in hyprland.lua.")
    lines.append("-- Regenerate with: hexciri-keybinds-render hyprland > config/hypr/conf/keybinds.lua")
    for combo in sorted(keys, key=lambda c: (len(c), c)):
        s = intents[keys[combo]]
        if s["type"] == "spawn":
            cmd = s["command"]
            bind_line = f"hl.bind({lua_str(key_hyp_lua(combo))}, hl.dsp.exec_cmd({lua_str(cmd)}))"
            lines.append(bind_line)
        else:
            action = s.get(WM, s.get("niri", "(See NOTE)"))
            if action.endswith("via hexciri-compositor)"):
                # the shim's screenshot op is the real sibling under hyprland
                lines.append(f"hl.bind({lua_str(key_hyp_lua(combo))}, hl.dsp.exec_cmd({lua_str('hexciri-compositor screenshot')}))")
                continue
            dsp = hyp_dsp(action)
            if dsp is None:
                lines.append(f"-- {combo} → {action}: no Lua sibling binding emitted")
                continue
            lines.append(f"hl.bind({lua_str(key_hyp_lua(combo))}, {dsp})")
elif WM == "sway":
    lines.append("# Keybinds — rendered from config/keybinds/intents.toml")
    lines.append("# Included via `include ~/.config/sway/conf.d/*`. Regenerate with:")
    lines.append("#   hexciri-keybinds-render sway > config/sway/conf.d/keybinds.conf")
    for combo in sorted(keys, key=lambda c: (len(c), c)):
        s = intents[keys[combo]]
        if s["type"] == "spawn":
            lines.append(f"bindsym {key_sway(combo)} exec {s['command']}")
        else:
            action = s.get(WM, s.get("niri", "(See NOTE)"))
            if action.endswith("via hexciri-compositor)"):
                lines.append(f"bindsym {key_sway(combo)} exec hexciri-compositor screenshot")
                continue
            if action.startswith("("):
                # placeholder like "(See NOTE)" — a comment, not a bind
                lines.append(f"# {combo} → {action}")
                continue
            lines.append(f"bindsym {key_sway(combo)} {action}")
elif WM == "mango":
    lines.append("# Keybinds — rendered from config/keybinds/intents.toml (experimental)")
    lines.append("# bind=[flags]MODS,KEY,COMMAND,PARAMS — dwl heritage: view X = show tag X,")
    lines.append("# tag X = send client to tag X (see mango skill; key names from wev).")
    lines.append("# Sourced by config.conf. Regenerate with:")
    lines.append("#   hexciri-keybinds-render mango > config/mango/keybinds.conf")
    for combo in sorted(keys, key=lambda c: (len(c), c)):
        s = intents[keys[combo]]
        if s["type"] == "spawn":
            # spawn has no pipe/&& support — route shell metachar commands to spawn_shell
            cmd = s["command"]
            if any(ch in cmd for ch in "|&<>\"'$()`"):
                lines.append(f"bind={key_mango(combo)},spawn_shell,{cmd}")
            else:
                lines.append(f"bind={key_mango(combo)},spawn,{cmd}")
        else:
            action = s.get(WM, s.get("niri", "(See NOTE)"))
            if action.endswith("via hexciri-compositor)"):
                lines.append(f"bind={key_mango(combo)},spawn_shell,hexciri-compositor screenshot")
                continue
            if action.startswith("("):
                # placeholder like "(See NOTE)" / "(grim via …)" — cannot bind a comment
                lines.append(f"# {combo} → {action}")
                continue
            act, _, params = action.partition(" ")
            if params:
                lines.append(f"bind={key_mango(combo)},{act},{params}")
            else:
                lines.append(f"bind={key_mango(combo)},{act}")

print("\n".join(lines))
EOF
exit 0