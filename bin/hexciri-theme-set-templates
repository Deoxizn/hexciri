#!/usr/bin/env python3
# hexciri-theme-set-templates — expand default/themed/*.tpl + generate app themes from colors.toml
# usage: hexciri-theme-set-templates [theme-dir]  (defaults to $HEXCIRI_CURRENT_THEME)
# generated files carry a GENERATED header; user drop-ins in hooks/theme-set.d run after.
import os, re, sys, json
import tomllib
from pathlib import Path

def hexc(key, data, fallbacks):
    for k in [key, *fallbacks]:
        v = data.get(k)
        if isinstance(v, str) and len(v.strip("#")) >= 6:
            return "#" + v.lstrip("#")[:6]
    return fallbacks[-1] if fallbacks and fallbacks[-1].startswith("#") else "#000000"

theme_dir = Path(sys.argv[1] if len(sys.argv) > 1 else os.environ.get("HEXCIRI_CURRENT_THEME", Path.home() / ".local/state/hexciri/current/theme"))
colors_path = theme_dir / "colors.toml"
if not colors_path.is_file():
    print(f"hexciri-templates: no colors.toml in {theme_dir}", file=sys.stderr)
    sys.exit(1)
data = tomllib.loads(colors_path.read_text())

C = {
  "mode": data.get("mode", "dark"),
  "accent": hexc("accent", data, ["#7c3aed"]),
  "background": hexc("background", data, ["#1a1a2e"]),
  "dark_background": hexc("dark_background", data, [hexc("dark_bg", data, ["#11111b"])]),
  "darker_background": hexc("darker_background", data, [hexc("darker_bg", data, ["#0e1012"])]),
  "lighter_background": hexc("lighter_background", data, [hexc("lighter_bg", data, ["#333639"])]),
  "foreground": hexc("foreground", data, ["#c0d0e0"]),
  "dark_foreground": hexc("dark_foreground", data, [hexc("muted", data, ["#586070"])]),
  "light_foreground": hexc("light_foreground", data, [hexc("foreground", data, ["#c0d0e0"])]),
  "bright_foreground": hexc("bright_foreground", data, ["#eeeeee"]),
  "selection": hexc("selection", data, ["#292e42"]),
  "selection_foreground": hexc("selection_foreground", data, [hexc("foreground", data, ["#c0d0e0"])]),
  "muted": hexc("muted", data, ["#586070"]),
  "red": hexc("red", data, ["#f7768e"]),
  "yellow": hexc("yellow", data, ["#e0af68"]),
  "orange": hexc("orange", data, ["#eb927b"]),
  "green": hexc("green", data, ["#9ece6a"]),
  "cyan": hexc("cyan", data, ["#7dcfff"]),
  "blue": hexc("blue", data, ["#7aa2f7"]),
  "magenta": hexc("magenta", data, ["#bb9af7"]),
  "brown": hexc("brown", data, ["#75493d"]),
  "bright_red": hexc("bright_red", data, [hexc("red", data, ["#ff7a93"])]),
  "bright_yellow": hexc("bright_yellow", data, [hexc("yellow", data, ["#ff9e64"])]),
  "bright_green": hexc("bright_green", data, [hexc("green", data, ["#b9f27c"])]),
  "bright_cyan": hexc("bright_cyan", data, [hexc("cyan", data, ["#0db9d7"])]),
  "bright_blue": hexc("bright_blue", data, [hexc("blue", data, ["#7da6ff"])]),
  "bright_magenta": hexc("bright_magenta", data, [hexc("magenta", data, ["#bb9af7"])]),
}

repo = Path(__file__).resolve().parent.parent
tpl_dir = Path(os.environ.get("HEXCIRI_PATH", "/usr/share/hexciri")) / "default" / "themed"
if not tpl_dir.is_dir():  # dev tree: script.py lives in <repo>/bin
    tpl_dir = repo / "default" / "themed"
C["selection_background"] = C["selection"]  # kitty.conf.tpl compat

# 1. generic {{key}} templates -> theme dir (strip .tpl); must be writable
# (hexciri-theme-set always passes the state copy, never /usr/share)
state_fallback = Path.home() / ".local" / "state" / "hexciri" / "current" / "theme"
if tpl_dir.is_dir():
    for tpl in sorted(tpl_dir.glob("*.tpl")):
        text = tpl.read_text()
        def sub(m):
            return C.get(m.group(1).strip(), m.group(0))
        out = re.sub(r"\{\{\s*([a-z_]+)\s*\}\}", sub, text)
        dest = theme_dir / tpl.name[:-4]
        try:
            dest.write_text(f"# GENERATED by hexciri-theme-set-templates — do not edit\n{out}")
        except PermissionError:
            state_fallback.mkdir(parents=True, exist_ok=True)
            dest = state_fallback / tpl.name[:-4]
            dest.write_text(f"# GENERATED by hexciri-theme-set-templates — do not edit\n{out}")
        print(f"hexciri-templates: {tpl.name} -> {dest}")

# 2. Strata custom theme (9 semantic tokens)
strata_dir = Path.home() / ".config" / "strata" / "themes"
strata_dir.mkdir(parents=True, exist_ok=True)
strata_toml = f"""# GENERATED by hexciri-theme-set-templates — do not edit
name = "Hexciri"
background = "{C['background']}"
surface = "{C['dark_background']}"
text = "{C['foreground']}"
accent = "{C['accent']}"
danger = "{C['red']}"
muted = "{C['muted']}"
highlight = "{C['selection']}"
border = "{C['lighter_background']}"
dim_text = "{C['dark_foreground']}"
"""
(strata_dir / "hexciri.toml").write_text(strata_toml)
print(f"hexciri-templates: strata -> {strata_dir / 'hexciri.toml'}")

# 3. fish colors (full thpm-parity set via conf.d; -g so it re-applies every shell)
fish_dir = Path.home() / ".config" / "fish" / "conf.d"
fish_dir.mkdir(parents=True, exist_ok=True)
fish_conf = f"""# GENERATED by hexciri-theme-set-templates — do not edit
set -g fish_color_normal {C['foreground'].lstrip('#')}
set -g fish_color_command {C['blue'].lstrip('#')}
set -g fish_color_keyword {C['magenta'].lstrip('#')}
set -g fish_color_quote {C['green'].lstrip('#')}
set -g fish_color_redirection {C['cyan'].lstrip('#')}
set -g fish_color_end {C['yellow'].lstrip('#')}
set -g fish_color_error {C['red'].lstrip('#')}
set -g fish_color_param {C['foreground'].lstrip('#')}
set -g fish_color_comment {C['muted'].lstrip('#')}
set -g fish_color_selection {C['bright_foreground'].lstrip('#')} --background={C['selection'].lstrip('#')}
set -g fish_color_search_match {C['bright_foreground'].lstrip('#')} --background={C['selection'].lstrip('#')}
set -g fish_color_operator {C['cyan'].lstrip('#')}
set -g fish_color_escape {C['magenta'].lstrip('#')}
set -g fish_color_autosuggestion {C['muted'].lstrip('#')}
set -g fish_color_cancel {C['red'].lstrip('#')}
set -g fish_pager_color_progress {C['muted'].lstrip('#')}
set -g fish_pager_color_prefix {C['blue'].lstrip('#')} --bold
set -g fish_pager_color_completion {C['foreground'].lstrip('#')}
set -g fish_pager_color_description {C['muted'].lstrip('#')}
set -g fish_pager_color_selected_background --background={C['selection'].lstrip('#')}
"""
(fish_dir / "hexciri-colors.fish").write_text(fish_conf)
print(f"hexciri-templates: fish -> {fish_dir / 'hexciri-colors.fish'}")

# 4. Zed minimal theme + select it (full style dict is a later dive; core keys now, hookable)
zed_dir = Path.home() / ".config" / "zed" / "themes"
zed_dir.mkdir(parents=True, exist_ok=True)
appearance = "light" if C["mode"] == "light" else "dark"
zed_theme = {"$schema": "https://zed.dev/schema/themes/v0.1.0.json", "name": "Hexciri",
  "author": "hexciri-theme-set-templates",
  "themes": [{"name": "Hexciri", "appearance": appearance, "style": {
    "background": C["background"], "editor.background": C["background"],
    "editor.foreground": C["foreground"], "text": C["foreground"],
    "text.muted": C["muted"], "border": C["muted"],
    "element.selected": C["selection"], "element.hover": C["selection"],
    "editor.highlighted_line.background": C["selection"],
    "editor.active_line.background": C["selection"],
    "terminal.background": C["background"], "terminal.foreground": C["foreground"],
    "terminal.ansi.black": C["dark_background"], "terminal.ansi.red": C["red"],
    "terminal.ansi.green": C["green"], "terminal.ansi.yellow": C["yellow"],
    "terminal.ansi.blue": C["blue"], "terminal.ansi.magenta": C["magenta"],
    "terminal.ansi.cyan": C["cyan"], "terminal.ansi.white": C["foreground"],
    "terminal.ansi.bright_black": C["muted"], "terminal.ansi.bright_red": C["bright_red"],
    "terminal.ansi.bright_green": C["bright_green"], "terminal.ansi.bright_yellow": C["bright_yellow"],
    "terminal.ansi.bright_blue": C["bright_blue"], "terminal.ansi.bright_magenta": C["bright_magenta"],
    "terminal.ansi.bright_cyan": C["bright_cyan"], "terminal.ansi.bright_white": C["bright_foreground"],
  }}]}
(zed_dir / "hexciri.json").write_text(json.dumps(zed_theme, indent=2) + "\n")
print(f"hexciri-templates: zed -> {zed_dir / 'hexciri.json'}")
settings = Path.home() / ".config" / "zed" / "settings.json"
try:
    s = json.loads(settings.read_text()) if settings.is_file() else {}
    if s.get("theme") != "Hexciri":
        s["theme"] = "Hexciri"
        settings.write_text(json.dumps(s, indent=2) + "\n")
        print("hexciri-templates: zed settings theme -> Hexciri")
except Exception as e:
    print(f"hexciri-templates: zed settings skipped ({e})")

# 5. fuzzel deploy (generated fuzzel.ini in theme dir -> ~/.config/fuzzel/fuzzel.ini)
fuzzel_src = theme_dir / "fuzzel.ini"
if fuzzel_src.is_file():
    fz = Path.home() / ".config" / "fuzzel" / "fuzzel.ini"
    fz.parent.mkdir(parents=True, exist_ok=True)
    fz.write_text(fuzzel_src.read_text())
    print(f"hexciri-templates: fuzzel -> {fz}")

# 6. GTK css-compat (thpm-parity: theme variables imported by gtk.css 3.0/4.0)
gtk_css = f"""/* GENERATED by hexciri-theme-set-templates — do not edit */
@define-color accent_color {C['accent']};
@define-color accent_bg_color {C['accent']};
@define-color accent_fg_color {C['selection_foreground']};
@define-color destructive_color {C['red']};
@define-color destructive_bg_color {C['red']};
@define-color destructive_fg_color {C['bright_foreground']};
@define-color success_color {C['green']};
@define-color warning_color {C['yellow']};
@define-color error_color {C['red']};
@define-color window_bg_color {C['background']};
@define-color window_fg_color {C['foreground']};
@define-color view_bg_color {C['dark_background']};
@define-color view_fg_color {C['foreground']};
@define-color headerbar_bg_color {C['darker_background']};
@define-color headerbar_fg_color {C['bright_foreground']};
@define-color headerbar_border_color {C['lighter_background']};
@define-color headerbar_backdrop_color {C['dark_background']};
@define-color sidebar_bg_color {C['darker_background']};
@define-color sidebar_fg_color {C['foreground']};
@define-color sidebar_backdrop_color {C['dark_background']};
@define-color sidebar_border_color {C['lighter_background']};
@define-color secondary_sidebar_bg_color {C['dark_background']};
@define-color secondary_sidebar_fg_color {C['foreground']};
@define-color card_bg_color {C['lighter_background']};
@define-color card_fg_color {C['foreground']};
@define-color dialog_bg_color {C['background']};
@define-color dialog_fg_color {C['foreground']};
@define-color popover_bg_color {C['lighter_background']};
@define-color popover_fg_color {C['foreground']};
@define-color shade_color {C['darker_background']};
@define-color scrollbar_outline_color {C['dark_background']};

/* GTK 3 compatibility aliases. */
@define-color theme_bg_color {C['background']};
@define-color theme_fg_color {C['foreground']};
@define-color theme_base_color {C['dark_background']};
@define-color theme_text_color {C['foreground']};
@define-color theme_selected_bg_color {C['selection']};
@define-color theme_selected_fg_color {C['selection_foreground']};
@define-color insensitive_bg_color {C['darker_background']};
@define-color insensitive_fg_color {C['muted']};
@define-color borders {C['lighter_background']};

selection {{
  background-color: {C['selection']};
  color: {C['selection_foreground']};
}}
"""
for gtk_ver in ("gtk-3.0", "gtk-4.0"):
    cfg_dir = Path.home() / ".config" / gtk_ver
    cfg_dir.mkdir(parents=True, exist_ok=True)
    (cfg_dir / "hexciri-gtk.css").write_text(gtk_css)
    gtk_css_main = cfg_dir / "gtk.css"
    user_css = gtk_css_main.read_text() if gtk_css_main.is_file() else ""
    if user_css and "hexciri-gtk.css" not in user_css:
        gtk_css_main.write_text(user_css.rstrip() + '\n@import url("hexciri-gtk.css");\n')
    else:
        gtk_css_main.write_text('/* GENERATED by hexciri-theme-set-templates — do not edit */\n@import url("hexciri-gtk.css");\n')
    print(f"hexciri-templates: gtk {gtk_ver} -> {cfg_dir / 'hexciri-gtk.css'}")

# 8. spicetify theme (thpm-parity). Dormant until ~/.config/spicetify exists;
#    after first `spicetify config current_theme hexciri && spicetify apply`,
#    every theme set re-colors Spotify.
spicetify_cfg = Path.home() / ".config" / "spicetify"
if spicetify_cfg.is_dir():
    sp_themedir = spicetify_cfg / "Themes" / "hexciri"
    sp_themedir.mkdir(parents=True, exist_ok=True)
    noc = lambda k: C[k].lstrip("#")
    sp_color_ini = f"""# GENERATED by hexciri-theme-set-templates — do not edit
[Base]
main = {noc('background')}
sidebar = {noc('dark_background')}
player = {noc('darker_background')}
card = {noc('lighter_background')}
shadow = {noc('darker_background')}
selected-row = {noc('selection')}
button = {noc('green')}
button-active = {noc('bright_green')}
text = {noc('foreground')}
subtext = {noc('muted')}
notification = {noc('blue')}
notification-error = {noc('red')}
"""
    (sp_themedir / "color.ini").write_text(sp_color_ini)
    (sp_themedir / "user.css").write_text("""/* GENERATED by hexciri-theme-set-templates — do not edit (omarchy-parity overlay) */
:root,
.encore-dark-theme,
.encore-base-set,
.encore-inverted-light-set {
    --background-highlight: rgba(var(--spice-rgb-highlight), 0.25) !important;
}
.main-nowPlayingBar-container {
    background-color: var(--background-base);
    border-radius: 0.5rem;
    padding: 0.5rem;
    color: var(--spice-text);
}
.main-entityHeader-backgroundColor {
    display: none !important;
}
.main-actionBarBackground-background {
    display: none !important;
}
.main-home-homeHeader {
    display: none !important;
}
.main-topBar-background,
.main-home-filterChipsSection {
    background-color: var(--spice-main) !important;
}
""")
    print(f"hexciri-templates: spicetify -> {sp_themedir / 'color.ini'} (+user.css)")

# 9. wake running kitty windows (config reload re-reads the themed include; the @
#    socket only exists inside a kitty window, so also SIGUSR1 — works from any
#    launcher context like fuzzel/nohup)
import subprocess
kitty_conf = theme_dir / "kitty.conf"
if kitty_conf.is_file():
    subprocess.run(["kitty", "@", "set-colors", str(kitty_conf)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["pkill", "-USR1", "kitty"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

print("hexciri-templates: done (brave: follows GTK dark, hookable; opencode: tui theme=system follows kitty)")
