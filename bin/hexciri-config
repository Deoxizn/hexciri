#!/bin/bash
# hexciri:menu=config
# hexciri:summary=Edit hexciri config files
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bindir="${HEXCIRI_BIN_DIR:-}"
if [[ -z $bindir && -d $(dirname "$SCRIPT_DIR")/bin ]]; then bindir="$(dirname "$SCRIPT_DIR")/bin"; fi
bindir="${bindir:-$SCRIPT_DIR}"

# Shipped catalog = the repo checkout the command symlinks into (HEXCIRI_PATH
# overrides when run outside the repo, e.g. bootstrap seeding).
here="$(readlink -f "$SCRIPT_DIR" 2>/dev/null || echo "$SCRIPT_DIR")"
shipped_base="${HEXCIRI_PATH:-$(dirname "$here")}"

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
choice=$(
  printf '%s\n' \
    'Niri config' \
    'Noctalia config' \
    'Fastfetch config' \
    'Palettes' \
    'Extra themes list' \
    'Omarchy themes list' \
    'Hooks' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Config: ' --width=26 --lines=7
) || exec "$SCRIPT_DIR/hexciri-menu"
fi

case "$choice" in
  'Niri config')        "$bindir/hexciri-edit-file" "${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl" ;;
  'Noctalia config')    "$bindir/hexciri-edit-file" "${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/config.toml" ;;
  'Fastfetch config')   "$bindir/hexciri-edit-file" "${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/config.jsonc" ;;
  'Palettes')           "$bindir/hexciri-edit-file" "${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/palettes/" ;;
  'Extra themes list')
    dir="${XDG_CONFIG_HOME:-$HOME/.config}/hexciri/theme-sources"
    mkdir -p "$dir"
    list="$dir/extra.list"
    shipped="$shipped_base/theme-sources/extra.list"
    [[ -f $list ]] || cp -f "$shipped" "$list" 2>/dev/null || true
    "$bindir/hexciri-edit-file" "$list" ;;
  'Omarchy themes list')
    dir="${XDG_CONFIG_HOME:-$HOME/.config}/hexciri/theme-sources"
    mkdir -p "$dir"
    list="$dir/omarchy.list"
    shipped="$shipped_base/theme-sources/omarchy.list"
    [[ -f $list ]] || cp -f "$shipped" "$list" 2>/dev/null || true
    "$bindir/hexciri-edit-file" "$list" ;;
  'Hooks')              "$bindir/hexciri-edit-file" "${XDG_CONFIG_HOME:-$HOME/.config}/hexciri/hooks/" ;;
esac