#!/bin/bash
# hexciri:menu=config-search
# hexciri:summary=Choose the default web search provider for hexciri-fuzzel search
# Usage: hexciri-search-provider            pick from the builtin providers
#        hexciri-search-provider NAME       set the default directly
#
# Providers are a rolling hardcoded table inside bin/hexciri-fuzzel (read here
# via its hidden `providers` subcommand). The chosen default is persisted to
# ~/.local/state/hexciri/search-provider; no user-editable config file exists.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" 2>/dev/null && pwd || dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
bindir="${HEXCIRI_BIN_DIR:-$SCRIPT_DIR}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hexciri/search-provider"

default="$(cat "$STATE" 2>/dev/null || true)"
[[ -n $default ]] || default="google"

# one pass over `hexciri-fuzzel providers` → parallel name/label arrays
names=(); labels=()
while IFS=$'\t' read -r name label _url; do
  [[ -n $name ]] || continue
  names+=("$name"); labels+=("$label")
done < <("$bindir/hexciri-fuzzel" providers 2>/dev/null || true)

(( ${#names[@]} > 0 )) || { echo "hexciri-search-provider: hexciri-fuzzel listed no providers" >&2; exit 1; }

idx_of() { # NAME → index in names[] or empty
  local n i
  for i in "${!names[@]}"; do [[ ${names[$i]} == "$1" ]] && { printf '%s' "$i"; return; }; done
  return 1
}

pick="${1:-}"
if [[ -z $pick ]]; then
  rows=()
  for i in "${!names[@]}"; do
    star=" "; [[ ${names[$i]} == "$default" ]] && star="*"
    rows+=("${names[$i]}|$star ${labels[$i]}")
  done
  pick=$(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -t'|' -k2 |
    "$bindir/hexciri-fuzzel" --dmenu --prompt='Search provider: ' \
      --width=50 --lines=12 --nth-delimiter='|' --with-nth=2 --accept-nth=1 2>/dev/null) || exit 0
fi

[[ -n $pick ]] || exit 0
i="$(idx_of "$pick")" || { echo "hexciri-search-provider: unknown provider '$pick'" >&2; exit 1; }

mkdir -p "$(dirname "$STATE")"
printf '%s' "$pick" > "$STATE"

notify-send "Search provider" "Default web search is now ${labels[$i]} (Mod+Shift+S)" 2>/dev/null || true