#!/bin/bash
# hexciri:summary=Compositor shim — niri/hyprland IPC with a generic fallback
# hexciri-compositor <op> [args]
#
# Every hexciri tool calls this instead of `niri msg …` / `hyprctl …`. Ops that
# a compositor has no action for fall back to the generic backend (grim/slurp,
# setsid). $WM resolves once via hexciri-session (niri|hyprland).
#
# Ops: wm screenshot screenshot-screen windows-json window-id-for focus-window
#      float-window power-off-monitors quit load-config spawn focused-output
#      outputs-json lock
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# uwsm-managed Hyprland omits HYPRLAND_INSTANCE_SIGNATURE from its own
# environ, so binds inherit a sig-less env and every hyprctl call dies with
# "not set!" — silently here (stderr is swallowed). Resolve from the runtime
# dir (newest first) when unset, so binds, menu and ssh all reach the live
# compositor.
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  _hdir="/run/user/${UID:-$(id -u)}/hypr"
  if [[ -d $_hdir ]]; then
    _sig="$(ls -t "$_hdir" 2>/dev/null | head -n1 || true)"
    [[ -n $_sig ]] && export HYPRLAND_INSTANCE_SIGNATURE="$_sig"
  fi
  unset _hdir _sig
fi
WM="$("$SCRIPT_DIR/hexciri-session" wm)"
op="${1:-}"

case "$op" in
  wm)
    echo "$WM"
    exit 0
    ;;

  windows-json)
    case "$WM" in
      niri)     niri msg --json windows 2>/dev/null || echo '[]';;
      hyprland) hyprctl clients -j 2>/dev/null || echo '[]';;
      *)        echo '[]';;
    esac
    exit 0
    ;;

  window-id-for)
    if (($# < 2)); then echo ""; exit 0; fi
    case "$WM" in
      niri)     niri msg --json windows 2>/dev/null | jq -r --arg p "$2" '.[] | select((.app_id|test($p;"i")) or (.title|test($p;"i"))) | .id' 2>/dev/null | head -n1 ;;
      hyprland) hyprctl clients -j 2>/dev/null | jq -r --arg p "$2" '.[] | select((.class|test($p;"i")) or (.title|test($p;"i"))) | .address' 2>/dev/null | head -n1 ;;
      *)        echo "" ;;
    esac
    exit 0
    ;;

  focus-window)
    if (($# < 2)); then exit 0; fi
    case "$WM" in
      niri)     niri msg action focus-window --id "$2" 2>/dev/null || true ;;
      # Hyprland 0.56: the legacy `hyprctl dispatch focuswindow address:...`
      # serializes to invalid Lua (hl.dispatch(focuswindow address:0x...)) and
      # dies silently under the `|| true` — the window never gets focused.
      # Use the real API instead: the window selector is "address:0x...", and
      # focusing a window that lives on another workspace follows it there.
      hyprland) hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:$2\" }))" 2>/dev/null || true ;;
      *)        true ;;
    esac
    exit 0
    ;;

  float-window)
    # Float a window by id. Niri floats the webcam overlay via a config rule
    # (no per-window toggle), so niri is a no-op; hyprland needs the explicit
    # dispatch. window-id-for already returns hyprland addresses.
    if (($# < 2)); then exit 0; fi
    case "$WM" in
      # Hyprland 0.56: legacy `hyprctl dispatch togglefloating address:...`
      # serializes to invalid Lua and dies silently. The Lua dispatcher takes
      # the same "address:0x..." selector and toggles THAT window (not the
      # focused one) — verified live.
      hyprland) hyprctl eval "hl.dispatch(hl.dsp.window.float({ action = \"toggle\", window = \"address:$2\" }))" >/dev/null 2>&1 || true ;;
    esac
    exit 0
    ;;

  screenshot)
    case "$WM" in
      niri)     niri msg action screenshot 2>/dev/null || true ;;
      hyprland) mkdir -p "${SHOT_DIR:-$HOME/Pictures/Screenshots}" 2>/dev/null || true
                grim -g "$(slurp)" "${SHOT_DIR:-$HOME/Pictures/Screenshots}/$(date +'%Y-%m-%d_%H-%M-%S').png" 2>/dev/null || true ;;
      *)        grim -g "$(slurp)" "${SHOT_DIR:-$HOME/Pictures/Screenshots}/$(date +'%Y-%m-%d_%H-%M-%S').png" 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  screenshot-screen)
    case "$WM" in
      niri)     niri msg action screenshot-screen 2>/dev/null || true ;;
      hyprland) mkdir -p "${SHOT_DIR:-$HOME/Pictures/Screenshots}" 2>/dev/null || true
                grim "${SHOT_DIR:-$HOME/Pictures/Screenshots}/$(date +'%Y-%m-%d_%H-%M-%S').png" 2>/dev/null || true ;;
      *)        grim "${SHOT_DIR:-$HOME/Pictures/Screenshots}/$(date +'%Y-%m-%d_%H-%M-%S').png" 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  focused-output)
    case "$WM" in
      niri)     niri msg focused-output 2>/dev/null | sed -n 's/^Output .* (\(.*\))$/\1/p' | head -1 ;;
      hyprland) hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -1 ;;
      *)        echo "" ;;
    esac
    exit 0
    ;;

  outputs-json)
    case "$WM" in
      niri)     niri msg --json outputs 2>/dev/null || echo '{}' ;;
      hyprland) hyprctl monitors -j 2>/dev/null || echo '[]' ;;
      *)        echo '{}' ;;
    esac
    exit 0
    ;;

  power-off-monitors)
    case "$WM" in
      niri)     niri msg action power-off-monitors 2>/dev/null || true ;;
      # Hyprland 0.56: `hyprctl dispatch dpms off` is broken — it serializes to
      # invalid unquoted Lua (hl.dispatch(dpms off)) and errors silently under
      # the `|| true`. Route through `hyprctl eval` with the real API call.
      # Pass a TABLE: hl.dsp.dpms() maps a string/number argument to TOGGLE
      # (tableToggleAction only reads "action" from a table), so dpms('off')
      # silently toggled the panels back on every other lock-loop tick.
      hyprland) hyprctl eval 'hl.dispatch(hl.dsp.dpms({ action = "disable" }))' 2>/dev/null || true ;;
      *)        true ;;
    esac
    exit 0
    ;;

  quit)
    case "$WM" in
      niri)     niri msg action quit 2>/dev/null || true ;;
      # uwsm-managed sessions (UWSM vars in the bind env) must end via
      # `uwsm stop`: plain compositor exit kills only the compositor
      # while the session unit lingers, so logout goes nowhere. Elsewhere
      # exiting the compositor is the right call.
      hyprland)
        if command -v uwsm >/dev/null 2>&1 && [[ -n ${UWSM_FINALIZE_VARNAMES:-} ]]; then
          uwsm stop >/dev/null 2>&1 || true
        else
          # Hyprland 0.56: legacy `hyprctl dispatch exit` serializes to
          # invalid Lua and silently does nothing. The shipped example
          # config uses hl.dsp.exit() for the same thing.
          hyprctl eval 'hl.dispatch(hl.dsp.exit())' 2>/dev/null || true
        fi ;;
      *)        loginctl terminate-session "${XDG_SESSION_ID:-}" 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  load-config)
    case "$WM" in
      niri)     niri msg action load-config-file 2>/dev/null || true ;;
      hyprland) hyprctl reload 2>/dev/null || true ;;
      *)        true ;;
    esac
    exit 0
    ;;

  lock)
    case "$("$SCRIPT_DIR/hexciri-session" shell)" in
      noctalia) noctalia msg session lock 2>/dev/null || true ;;
      *)        swaylock 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  spawn)
    if (($# < 2)); then exit 1; fi
    cmd="${2} ${3-}"
    case "$WM" in
      niri)     niri msg action spawn -- "$cmd" 2>/dev/null || true ;;
      # Hyprland 0.56: legacy `hyprctl dispatch exec -- ...` serializes to
      # invalid Lua and dies silently (the setsid fallback used to carry
      # every spawn). exec_cmd runs the string through a shell exactly like
      # the legacy exec did, and the Lua long-bracket string leaves the
      # command's own quotes untouched. Falls back to a detached shell if
      # the compositor call fails.
      hyprland) hyprctl eval "hl.dispatch(hl.dsp.exec_cmd([====[$cmd]====]))" 2>/dev/null || setsid bash -c "$cmd" &>/dev/null & disown 2>/dev/null || true ;;
      *)        setsid "$cmd" &>/dev/null & disown 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  *)
    echo "hexciri-compositor: unknown op '$op'" >&2
    exit 1
    ;;
esac