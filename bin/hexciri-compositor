#!/bin/bash
# hexciri:summary=Compositor shim — one dispatch for every WM/IPC call (native → generic fallback)
# hexciri-compositor <op> [args]
#
# Every hexciri tool calls this instead of `niri msg …`. Each op tries the
# native WM backend first (niri/hyprland/sway/mango), then falls back to the
# generic backend (grim/slurp, loginctl, setsid). $WM resolves once via
# hexciri-session — tools never learn about WMs.
#
# Ops: wm screenshot screenshot-screen windows-json window-id-for focus-window
#      power-off-monitors quit load-config spawn focused-output outputs-json lock
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WM="$("$SCRIPT_DIR/hexciri-session" wm)"
op="${1:-}"

case "$op" in
  wm)
    echo "$WM"
    exit 0
    ;;

  windows-json)
    case "$WM" in
      niri)     niri msg --json windows 2>/dev/null || echo '[]';;
      hyprland) hyprctl -j clients 2>/dev/null | jq '[.[] | {app_id:.class, title:.title, id:.address}]' 2>/dev/null || echo '[]';;
      sway)     swaymsg -t get_tree -j 2>/dev/null | jq '[.. | objects | select(.type=="con") | {app_id:.app_id, title:.name, id:.id}]' 2>/dev/null || echo '[]';;
      *)        echo '[]';;
    esac
    exit 0
    ;;

  window-id-for)
    if (($# < 2)); then echo ""; exit 0; fi
    case "$WM" in
      niri)     niri msg --json windows 2>/dev/null | jq -r --arg p "$2" '.[] | select((.app_id|test($p;"i")) or (.title|test($p;"i"))) | .id' 2>/dev/null | head -n1 ;;
      hyprland) hyprctl -j clients 2>/dev/null | jq -r --arg p "$2" '.[] | select((.class|test($p;"i")) or (.title|test($p;"i"))) | .address' 2>/dev/null | head -n1 ;;
      sway)     swaymsg -t get_tree -j 2>/dev/null | jq -r --arg p "$2" '[.. | objects | select(.type=="con") | select((.app_id // "" | test($p;"i")) or (.name // "" | test($p;"i"))) | .id] | first' 2>/dev/null ;;
      *)        echo "" ;;
    esac
    exit 0
    ;;

  focus-window)
    if (($# < 2)); then exit 0; fi
    case "$WM" in
      niri)     niri msg action focus-window --id "$2" 2>/dev/null || true ;;
      hyprland) hyprctl dispatch focuswindow "address:$2" 2>/dev/null || true ;;
      sway)     swaymsg "[con_id=$2]" focus 2>/dev/null || true ;;
      *)        true ;;
    esac
    exit 0
    ;;

  screenshot)
    case "$WM" in
      niri)     niri msg action screenshot 2>/dev/null || true ;;
      *)        grim -g "$(slurp)" "${SHOT_DIR:-$HOME/Pictures/Screenshots}/$(date +'%Y-%m-%d_%H-%M-%S').png" 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  screenshot-screen)
    case "$WM" in
      niri)     niri msg action screenshot-screen 2>/dev/null || true ;;
      *)        grim "${SHOT_DIR:-$HOME/Pictures/Screenshots}/$(date +'%Y-%m-%d_%H-%M-%S').png" 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  focused-output)
    case "$WM" in
      niri)     niri msg focused-output 2>/dev/null | sed -n 's/^Output .* (\(.*\))$/\1/p' | head -1 ;;
      hyprland) hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -1 ;;
      sway)     swaymsg -t get_outputs -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -1 ;;
      *)        echo "" ;;
    esac
    exit 0
    ;;

  outputs-json)
    case "$WM" in
      niri)     niri msg --json outputs 2>/dev/null || echo '{}' ;;
      hyprland) hyprctl -j monitors 2>/dev/null | jq 'reduce .[] as $o ({}; .[$o.name] = {current_mode: 0, modes: [{width: $o.width, height: $o.height}]})' 2>/dev/null || echo '{}' ;;
      sway)     swaymsg -t get_outputs -j 2>/dev/null | jq 'reduce .[] as $o ({}; .[$o.name] = {current_mode: $o.current_mode, modes: [{width: $o.current_mode.width, height: $o.current_mode.height}]})' 2>/dev/null || echo '{}' ;;
      *)        echo '{}' ;;
    esac
    exit 0
    ;;

  power-off-monitors)
    case "$WM" in
      niri)     niri msg action power-off-monitors 2>/dev/null || true ;;
      hyprland) hyprctl dispatch dpms off 2>/dev/null || true ;;
      sway)     swaymsg output '*' dpms off 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  quit)
    case "$WM" in
      niri)     niri msg action quit 2>/dev/null || true ;;
      hyprland) hyprctl dispatch exit 2>/dev/null || true ;;
      sway)     swaymsg exit 2>/dev/null || true ;;
      *)        loginctl terminate-session "${XDG_SESSION_ID:-}" 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  load-config)
    case "$WM" in
      niri)     niri msg action load-config-file 2>/dev/null || true ;;
      hyprland) hyprctl reload 2>/dev/null || true ;;
      sway)     swaymsg reload 2>/dev/null || true ;;
      *)        pkill -HUP -f "$WM" 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  lock)
    case "$("$SCRIPT_DIR/hexciri-session" shell)" in
      noctalia) noctalia msg session lock 2>/dev/null || true ;;
      *)        case "$WM" in
                  hyprland) hyprlock 2>/dev/null || true ;;
                  *)        swaylock 2>/dev/null || true ;;
                esac ;;
    esac
    exit 0
    ;;

  spawn)
    if (($# < 2)); then exit 1; fi
    cmd="${2} ${3-}"
    case "$WM" in
      niri)     niri msg action spawn -- "$cmd" 2>/dev/null || true ;;
      hyprland) hyprctl dispatch exec -- "$cmd" 2>/dev/null || true ;;
      sway)     swaymsg exec "$cmd" 2>/dev/null || true ;;
      *)        setsid "$cmd" &>/dev/null & disown 2>/dev/null || true ;;
    esac
    exit 0
    ;;

  *)
    echo "hexciri-compositor: unknown op '$op'" >&2
    exit 1
    ;;
esac