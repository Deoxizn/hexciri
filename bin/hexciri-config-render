#!/bin/bash
# hexciri:summary=Render env/input/autostart fragments for a WM from the niri source of truth
# hexciri:args=[concern] [wm] [--source=PATH] — concern: env|input|autostart; wm: niri|hyprland|sway|mango (default: active WM). Prints the target block to stdout.
# hexciri:requires-sudo=false
#
# The env/input/autostart carry-over (design docs/design-wm-shell-choice.md §6/§7):
# these three concerns are authored once as niri fragments (config/niri/<concern>.kdl —
# env.kdl, input.kdl, autostart.kdl) and rendered per-WM by this tool. Keybinds have
# their own renderer (hexciri-keybinds-render); monitors carry whole-file (session-set).
#
# Source resolution (design §7: the installed config is the machine's reality, not the
# repo template): the live ~/.config/niri/<concern>.kdl wins (per-machine input
# tuning, shell=none commented autostart lines), falling back to the repo fragment.
# Use --source=PATH to force a specific source file.
#
#   hexciri-config-render env    hyprland    # Lua hl.env(...) lines
#   hexciri-config-render input  sway        # sway input type:* blocks
#   hexciri-config-render autostart mango    # exec-once=... lines
#   hexciri-config-render env                # render for the active WM
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO="${HEXCIRI_PATH:-$HOME/.local/opt/hexciri}"
[[ -d $REPO ]] || REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

CONCERN="${1:-}"
WM="${2:-$("$SCRIPT_DIR/hexciri-session" wm 2>/dev/null || echo niri)}"
SOURCE=""
for a in "$@"; do
  case "$a" in --source=*) SOURCE="${a#--source=}" ;; esac
done

case "$CONCERN" in env|input|autostart) ;; *) echo "hexciri-config-render: concern '$CONCERN' (env|input|autostart)" >&2; exit 1 ;; esac
case "$WM" in niri|hyprland|sway|mango) ;; *) echo "hexciri-config-render: unknown WM '$WM'" >&2; exit 1 ;; esac

if [[ -z $SOURCE ]]; then
  if [[ -f $XDG_CONFIG_HOME/niri/$CONCERN.kdl ]]; then
    SOURCE="$XDG_CONFIG_HOME/niri/$CONCERN.kdl"
  else
    SOURCE="$REPO/config/niri/$CONCERN.kdl"
  fi
fi
[[ -f $SOURCE ]] || { echo "hexciri-config-render: source not found: $SOURCE" >&2; exit 1; }

python3 - "$CONCERN" "$WM" "$SOURCE" <<'EOF'
import re, sys

CONCERN, WM, SOURCE = sys.argv[1], sys.argv[2], sys.argv[3]
raw = open(SOURCE).read()

def uncomment_all(text):
    # niri KDL comments are // to end of line; keep structure, drop inline comments.
    out = []
    for ln in text.splitlines():
        if "//" in ln:
            ln = ln.split("//", 1)[0]
        out.append(ln)
    return "\n".join(out)

# ── per-concern parsers (return lists of (value[, hint]) tuples) ──────────
def parse_env(txt):
    """(KEY, value) for active lines inside environment { }."""
    body = txt.split("environment {", 1)
    if len(body) < 2:
        return []
    block = body[1].split("}", 1)[0]
    out = []
    for ln in uncomment_all(block).splitlines():
        m = re.match(r'\s*([A-Za-z_][A-Za-z0-9_]*)\s+"((?:[^"\\]|\\.)*)"', ln)
        if m:
            out.append((m.group(1), m.group(2).replace('\\"', '"')))
    return out

def parse_input(txt):
    """Active (uncommented) input settings, flattened with their owning section."""
    body = txt.split("input {", 1)
    if len(body) < 2:
        return {}
    block = body[1].rsplit("}", 1)[0]
    # track section context by braces
    section = None          # keyboard|touchpad|mouse|xkb|None
    in_section = False
    stack = []
    ctx = []
    for ln in uncomment_all(block).splitlines():
        ln = ln.strip()
        if not ln:
            continue
        for tok in re.findall(r'[A-Za-z_][A-Za-z0-9_-]*|\{|\}|"(?:[^"\\]|\\.)*"', ln):
            if tok == "{":
                if stack:
                    stack.append(stack[-1])
                continue
            if tok == "}":
                if stack:
                    stack.pop()
                continue
            stack.append(tok) if not stack else None
        # simpler: rebuild section from brace nesting per line
    # fall back to a pragmatic line-scoped parser: iterate with depth
    section = None
    depth = 0
    cur = "root"
    # We rewind: map { } nesting to a small path per line.
    lines = []
    path = []
    for ln in uncomment_all(block).splitlines():
        s = ln.strip()
        if not s:
            continue
        opens = s.count("{")
        closes = s.count("}")
        name = ""
        for tok in re.findall(r'\b(output|keyboard|touchpad|mouse|xkb|input|workspace)\b', path and path[-1] or ""):
            name = tok
        # identify a section header line:  word { ... }
        hdr = re.match(r'^([A-Za-z_][A-Za-z0-9_-]*)\s*\{', s)
        if hdr:
            path.append(hdr.group(1))
            # statement may also carry value on same line
            rest = s[hdr.end():]
            if rest.strip():
                lines.append((hdr.group(1), rest.strip()))
            # consume opened brace of header
            opens = max(0, s.count("{") - 1) if hdr else opens
        for _ in range(closes):
            if path:
                path.pop()
        if opens and not hdr:
            # bare { with no name (e.g. continuation) — ignore
            pass
        if not hdr and (opens == 0 and closes == 0):
            ctxtok = path[-1] if path else "root"
            lines.append((ctxtok, s))
    # parse statements:  key [value]  inside context ctx
    sets = {}
    for ctx, stmt in lines:
        toks = stmt.split()
        key = toks[0]
        if key in ("layout", "options", "tap-button-map", "click-method", "scroll-factor", "focus-follows-mouse-delay"):
            if len(toks) >= 2:
                sets[f"{ctx} {key}".strip()] = toks[1].strip('"')
            else:
                sets[f"{ctx} {key}".strip()] = True
        elif key in ("tap", "natural-scroll", "numlock", "focus-follows-mouse", "disabled-while-typing"):
            sets[f"{ctx} {key}".strip()] = True
    return sets

def parse_autostart(txt):
    """(cmd, is_shell) for active spawn-at-startup lines (commented ones skipped)."""
    out = []
    for ln in txt.splitlines():
        if ln.lstrip().startswith("//"):
            continue
        m = re.match(r'\s*spawn(-sh)?-at-startup\s+"((?:[^"\\]|\\.)*)"', ln)
        if m:
            out.append((m.group(2), bool(m.group(1))))
    return out

# ── helpers per target ─────────────────────────────────────────────────────
def jquote(s):
    return '"' + s.replace('\\', '\\\\').replace('"', '\\"') + '"'

def spawn_lua(cmd, shell=False):
    if shell:
        # compound commands ($(), &&, |) need an explicit shell — same pattern
        # as the stellarchy reference autostart (hl.exec_cmd("bash -c '...'")).
        return 'hl.exec_cmd(' + jquote("bash -c '" + cmd.replace("'", "'\\''") + "'") + ')'
    return 'hl.exec_cmd(' + jquote(cmd) + ')'

# ── render ─────────────────────────────────────────────────────────────────
CMS = {"niri": "//", "hyprland": "--", "sway": "#", "mango": "#"}[WM]
print(f"{CMS} hexciri — {CONCERN} rendered for {WM}")
print(f"{CMS} source: {SOURCE} (niri fragment; regenerate with: hexciri-config-render {CONCERN} {WM})")

if CONCERN == "env":
    entries = parse_env(raw)
    desk = {"niri": "niri", "hyprland": "Hyprland", "sway": "sway", "mango": "MangoWM"}[WM]
    if WM == "niri":
        print()
        print("environment {")
        for k, v in entries:
            print(f'    {k} {jquote(v)}')
        print("}")
    elif WM == "hyprland":
        print("-- XDG_CURRENT_DESKTOP follows the target WM; the rest carry the Wayland stack")
        print("-- verbatim from the niri env fragment.")
        for k, v in entries:
            if k == "XDG_CURRENT_DESKTOP":
                v = desk
            print(f'hl.env({jquote(k)}, {jquote(v)})')
    elif WM == "sway":
        print("# Sway has NO env directive — values are provided to every spawned app via")
        print("# ~/.config/environment.d/10-hexciri.conf (KEY=VALUE) by the writer, and the")
        print("# sway session command imports it. Listed here for reference / docs.")
        for k, v in entries:
            if k == "XDG_CURRENT_DESKTOP":
                v = desk
            print(f"# {k}={v}")
    elif WM == "mango":
        print("# env= resets on every config reload — mango re-asserts it from this file.")
        for k, v in entries:
            if k == "XDG_CURRENT_DESKTOP":
                v = desk
            print(f"env={k},{v}")

elif CONCERN == "input":
    sets = parse_input(raw)
    def has(*keys):
        for k in keys:
            if k in sets:
                return sets[k]
        return None
    layout   = has("keyboard layout", "xkb layout")
    options  = has("keyboard options", "xkb options")
    numlock  = has("keyboard numlock", "xkb numlock")
    tp_tap   = has("touchpad tap")
    tp_nat   = has("touchpad natural-scroll")
    tp_dwt   = has("touchpad disabled-while-typing")
    tp_sf    = has("touchpad scroll-factor", "scroll-factor")
    tp_map   = has("touchpad tap-button-map")
    tp_click = has("touchpad click-method")
    mo_nat   = has("mouse natural-scroll")
    ffm      = has("focus-follows-mouse")
    ffm_d    = has("focus-follows-mouse-delay")

    if WM == "niri":
        print()
        print("input {")
        print("    keyboard {")
        print("        xkb {")
        if layout:
            print(f'            layout {jquote(str(layout))}')
        if options:
            print(f'            options {jquote(str(options))}')
        print("        }")
        if numlock:
            print("        numlock")
        print("    }")
        print()
        print("    touchpad {")
        if tp_tap:
            print("        tap")
        if tp_nat:
            print("        natural-scroll")
        if tp_sf:
            print(f"        scroll-factor {tp_sf}")
        if tp_map:
            print(f'        tap-button-map {jquote(str(tp_map))}')
        if tp_click:
            print(f'        click-method {jquote(str(tp_click))}')
        print("    }")
        print()
        print("    mouse {")
        if mo_nat:
            print("        natural-scroll")
        print("    }")
        if ffm:
            print("    focus-follows-mouse")
        if ffm_d:
            print(f"    focus-follows-mouse-delay {ffm_d}")
        print("}")

    elif WM == "hyprland":
        print("-- Confirmed 0.56 Lua keys; niri-only semantics that Hyprland lacks are")
        print("-- surfaced as NOTE comments, never silently dropped (policy §7).")
        out = []
        if layout:
            out.append(f'        kb_layout = {jquote(str(layout))}')
        if options:
            out.append(f'        kb_options = {jquote(str(options))}')
        if numlock:
            out.append('        numlock_by_default = true')
        if tp_nat:
            out.append('        touchpad = { natural_scroll = true, disable_while_typing = true }')
        elif tp_dwt:
            out.append('        touchpad = { disable_while_typing = true }')
        if tp_sf:
            out.append(f'        scroll_factor = {float(tp_sf) if tp_sf else 1}')
        if ffm:
            out.append('        follow_mouse = 1')
        if tp_tap:
            out.append('        -- NOTE: niri `tap` is the Hyprland default; no toggle needed.')
        if tp_map or tp_click:
            out.append('        -- NOTE: tap-button-map / click-method have no hyprland input{}')
            out.append('        --       sibling — set a per-device rule (hyprctl devices) if needed.')
        # Lua table entries are comma-separated; join with commas but never
        # leave one dangling on a comment line (a trailing comma there would
        # become part of the comment and break the next entry).
        body = ",\n".join(out)
        body = re.sub(r"^(\s*--.*),$", r"\1", body, flags=re.M)
        print('hl.config({ input = {')
        print("\n".join(["    " + l for l in body.splitlines()]))
        print('} })')

    elif WM == "sway":
        print()
        if layout:
            print("input type:keyboard {")
            print(f"    xkb_layout {layout}")
            if options:
                print(f"    xkb_options {options}")
            print("}")
        if numlock:
            print("input type:keyboard xkb_numlock enable")
        if tp_tap or tp_nat or tp_sf or tp_map or tp_click or tp_dwt:
            print("input type:touchpad {")
            if tp_tap:
                print("    tap enabled")
            if tp_nat:
                print("    natural_scroll enabled")
            if tp_dwt:
                print("    dwt enabled")
            if tp_sf:
                print(f"    scroll_factor {tp_sf}")
            if tp_map:
                mapv = {"left-right-middle": "lrm", "left-middle-right": "lmr"}.get(str(tp_map), "lrm")
                print(f"    tap_button_map {mapv}")
            if tp_click:
                clickv = {"button-areas": "button_areas", "clickfinger": "clickfinger"}.get(str(tp_click), "button_areas")
                print(f"    click_method {clickv}")
            print("}")
        if mo_nat:
            print("input type:pointer natural_scroll enabled")
        if ffm:
            print("focus_follows_mouse yes")
        if ffm_d:
            print(f"focus_follows_mouse_delay {ffm_d}")

    elif WM == "mango":
        print("# mango input globals are flat config.conf keys.")
        if numlock:
            print("numlockon=1")
        if layout:
            print(f"xkb_rules_layout={layout}")
        if options:
            print(f"xkb_rules_options={options}")
        if tp_tap:
            print("tap_to_click=1")
        if tp_nat:
            print("trackpad_natural_scrolling=1")
        if tp_dwt:
            print("trackpad_disable_while_typing=1")
        if tp_sf:
            print(f"trackpad_scroll_factor={float(tp_sf)}")
        if mo_nat:
            print("mouse_natural_scrolling=1")
        if ffm:
            print("sloppyfocus=1")
        if tp_map:
            mapv = {"left-right-middle": "0", "left-middle-right": "1"}.get(str(tp_map), "0")
            print(f"# NOTE: niri tap-button-map {tp_map} → button_map={mapv} (0=lrm, 1=lmr)")
        if tp_click:
            print(f"# NOTE: niri click-method {tp_click} → set trackpad_click_method (0/1) to taste")

elif CONCERN == "autostart":
    cmds = parse_autostart(raw)
    if WM == "niri":
        print()
        for cmd, shell in cmds:
            print(f'spawn{"-sh" if shell else ""}-at-startup {jquote(cmd)}')
    elif WM == "hyprland":
        print()
        print("hl.on(\"hyprland.start\", function()")
        for cmd, shell in cmds:
            print(f"    {spawn_lua(cmd, shell)}")
        print("end)")
    elif WM == "sway":
        print()
        for cmd, shell in cmds:
            print(f"exec {cmd}")
    elif WM == "mango":
        print("# exec-once runs once at startup (exec= would re-run on every reload)")
        for cmd, shell in cmds:
            if shell or any(ch in cmd for ch in "|&<>\"'$()`"):
                # mango avoids shell on native spawns — wrap compound commands
                # in an explicit `sh -c '…'` so pipes/redirs always work.
                wrapped = "sh -c '" + cmd.replace("'", "'\\''") + "'"
                print(f"exec-once={wrapped}")
            else:
                print(f"exec-once={cmd}")

print()
EOF
exit 0