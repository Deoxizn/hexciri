#!/bin/bash
# hexciri-niri-monitors: auto-append niri `output` blocks for connected outputs.
#
# Runs at every login via spawn-at-startup in config.kdl. The installer's user
# phase runs inside the chroot, where there is no niri socket and no /sys/class/
# drm — so install-time monitor detection silently produced no output blocks on
# fresh installs. This script runs in a live session (niri up) and closes the gap:
# idempotent — it only appends per-output blocks when the config has none yet.
set -euo pipefail

cfg="${NIRI_CFG:-$HOME/.config/niri/config.kdl}"
[[ -f $cfg ]] || { echo "no niri config: $cfg" >&2; exit 0; }

if grep -q '^output ' "$cfg"; then
  exit 0 # already has output block(s); leave user config alone
fi

sock="$(ls "/run/user/$(id -u)"/niri.*.sock 2>/dev/null | head -1)"
[[ -n $sock ]] || { echo "no niri socket (not in a session?)" >&2; exit 0; }

nm="" mode="" vrr="" ph="" wm="" hm="" wpx="" hpx="" scale="" line="" section=""
while read -r line; do
  case "$line" in
    Output*) nm="$(sed -n 's/.*(\([^()]*\)).*/\1/p' <<<"$line")" ;;
    *"Current mode:"*)
      mode="$(sed -n 's/.*Current mode: \([0-9]*x[0-9]*\) @ \([0-9.]*\).*/\1@\2/p' <<<"$line")" ;;
    *"Variable refresh rate: supported"*) vrr=1 ;;
    *"Variable refresh rate: not supported"*) vrr=0 ;;
    *"Physical size:"*)
      ph="$(sed -n 's/.*Physical size: \([0-9]*\)x\([0-9]*\).*/\1 \2/p' <<<"$line")"
      wm="${ph% *}"; hm="${ph#* }"
      wpx="${mode%%x*}"; hpx="${mode%@*}"; hpx="${hpx#*x}"
      scale=1
      if (( wpx > 0 && hpx > 0 && wm > 0 && hm > 0 )); then
        scale="$(awk -v W="$wpx" -v H="$hpx" -v WM="$wm" -v HM="$hm" \
          'BEGIN{ ppi=sqrt(W*W+H*H)*25.4/sqrt(WM*WM+HM*HM); s=ppi/160; if(s<1)s=1; if(s>2)s=2;
                  printf "%.2f", int(s*4+0.5)/4 }')"
      fi
      if [[ -n $nm && -n $mode ]] && ! grep -q "^output \"$nm\"" "$cfg"; then
        section+="output \"$nm\" {\n    mode \"$mode\"\n    scale $scale"
        (( vrr == 1 )) && section+="\n    variable-refresh-rate"
        section+="\n}\n\n"
      fi
      vrr=0; nm="" mode="" vrr="" ph="" wm="" hm="" wpx="" hpx=""
      ;;
  esac
done < <(NIRI_SOCKET="$sock" niri msg outputs 2>/dev/null)

if [[ -n $section ]]; then
  printf '\n# Auto-appended by hexciri-niri-monitors from live niri outputs\n%b' "$section" >> "$cfg"
  echo "appended output block(s) to $cfg"
  NIRI_SOCKET="$sock" niri msg action load-config-file 2>/dev/null || true
fi