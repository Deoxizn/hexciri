#!/bin/bash
# hexciri:summary=Re-apply hexciri system state after package transactions (alpm hook + manual)
# Package upgrades routinely clobber hexciri's bits:
#   * kernels install + mkinitcpio builds the initramfs, but systemd-boot gets no
#     new entry — the box keeps booting the old default (see: linux-omarchy-bore)
#   * sddm heals /etc/pam.d/sddm, losing pam_gnome_keyring + pam_fprintd
#   * avahi/hwloc/v4l-utils/qt6ct restore their stock .desktop files, so the
#     NoDisplay curation reverts and the menu cruft returns
# Runs as root via /usr/share/libalpm/hooks/hexciri-sync.hook (PostTransaction)
# or manually. Idempotent; safe to run any time.
#
# FIX POLICY: every bug fix ships BOTH here — covering existing machines via a
# plain system update — AND in install.sh (see its matching header), covering
# fresh installs. Sync this file whenever you touch one or the other.
set -euo pipefail

log() { echo "hexciri-sync: $*"; }

# ── 2. self-update: this script is a symlink into the repo checkout, so a slow
# ── repo means a stale hook. A package update is the user's 'it just works'
# ── moment — don't make them run a manual step to bring the framework forward.
# ── Pull the checkout first (non-fatal: dirty/unreachable degrades to the local
# ── code), then re-apply the hook file from the pulled tree so newer hook
# ── targets ride along immediately. When running as root (alpm hook) the repo
# ── is user-owned, so pull as its owner to avoid root-owned files. Step 2b then
# ── re-execs from the freshly-pulled tree so THIS invocation runs newest code. ──
REPO=""
[[ -n ${HEXCIRI_REPO:-} ]] && REPO="$HEXCIRI_REPO"
# Resolve the repo independent of the invoking context. `-L` on $0 alone is
# unreliable (bash often presents the resolved path, and `sudo hexciri-sync`
# passes just the name), so fall back to `command -v` against PATH — that finds
# the /usr/local/bin -> repo/bin/hexciri-sync symlink even for root, whose HOME
# (~/.local/opt/hexciri) would otherwise be used and come up empty.
if [[ -z $REPO ]]; then
  for p in "$0" "$(command -v "${0##*/}" 2>/dev/null || true)"; do
    [[ -n $p ]] || continue
    real="$(readlink -f "$p" 2>/dev/null || true)"
    [[ -n $real ]] || continue
    cand="$(cd "$(dirname "$real")/.." 2>/dev/null && pwd || true)"
    [[ -n $cand && -f $cand/bin/hexciri-sync ]] && { REPO="$cand"; break; }
  done
fi
[[ -n $REPO ]] || REPO="${HEXCIRI_REPO:-$HOME/.local/opt/hexciri}"
[[ -d $REPO ]] || REPO=""
export HEXCIRI_REPO="$REPO"
if [[ -d $REPO/.git ]]; then
  head_before="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
  if [[ $EUID -eq 0 ]]; then
    owner="$(stat -c %U "$REPO" 2>/dev/null || echo root)"
    if command -v runuser >/dev/null && [[ $owner != root ]]; then
      runuser -u "$owner" -- git -C "$REPO" pull --ff-only >/dev/null 2>&1 || \
        log "warning: repo pull skipped/failed (dirty tree or offline?) — continuing with local code"
    else
      git -C "$REPO" pull --ff-only >/dev/null 2>&1 || true
    fi
  else
    git -C "$REPO" pull --ff-only >/dev/null 2>&1 || true
  fi
  if [[ -f $REPO/default/alpm/hexciri-sync.hook ]] && ! cmp -s "$REPO/default/alpm/hexciri-sync.hook" /usr/share/libalpm/hooks/hexciri-sync.hook 2>/dev/null; then
    install -m644 "$REPO/default/alpm/hexciri-sync.hook" /usr/share/libalpm/hooks/hexciri-sync.hook 2>/dev/null && \
      log "re-applied alpm hook from repo (newer targets active from the next transaction)"
  fi

  # ── 2b. one-shot self-heal: this process ran the PRE-pull bytes of this script
  # ── (the pull could not also be its own upgrade). Re-exec from the JUST-pulled
  # ── checkout ONLY when the pull actually advanced HEAD, so every step below —
  # ── hook re-apply, plugin update_cmd migration, and anything future fixes add
  # ── here — runs the NEWEST code within THIS same transaction, not the next one.
  # ── An unchanged HEAD (repo already current) just proceeds with the copy that
  # ── is running; nothing to re-exec. HXC_SYNC_RERUN guards the descending pass
  # ── (its pull is a fast-forward no-op, so it matches and moves on). ──
  if [[ ${HXC_SYNC_RERUN:-0} == 0 ]] && [[ -x $REPO/bin/hexciri-sync ]]; then
    head_after="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
    if [[ -n $head_before && -n $head_after && $head_before != $head_after ]]; then
      export HXC_SYNC_RERUN=1
      log "re-execing with pulled framework (new commits applied)"
      exec "$REPO/bin/hexciri-sync" "$@"
    fi
  fi
fi

# ── 3a. noctalia arch-updater plugin: migrate a stale update_cmd to the renamed
# ── updater (hexciri-update-run → hexciri-update). Runs as root; the plugin's
# ── settings.toml lives in the repo owner's state dir. The pre-rename shim
# ── keeps the old name working, so this is tidy-up, not load-bearing. ──
noct_home=""
if [[ -n $REPO ]]; then
  noct_owner="$(stat -c %U "$REPO" 2>/dev/null || true)"
  [[ -n $noct_owner ]] && noct_home="$(getent passwd "$noct_owner" 2>/dev/null | cut -d: -f6 || true)"
fi
[[ -n $noct_home ]] && [[ -f $noct_home/.local/state/noctalia/settings.toml ]] && \
  grep -q 'update_cmd = "hexciri-update-run"' "$noct_home/.local/state/noctalia/settings.toml" && \
  sed -i 's|update_cmd = "hexciri-update-run"|update_cmd = "hexciri-update"|' \
    "$noct_home/.local/state/noctalia/settings.toml" && \
  log "arch-updater plugin: update_cmd migrated to hexciri-update"

# ── 3a2. noctalia config.toml: install.sh never deployed the repo default, so a
# ── fresh box ran noctalia with factory defaults (no hexciri bar layout, empty
# ── workspaces not hidden). Seed it from the repo if missing — a user-edited
# ── file is never clobbered. Runs as root (alpm hook); the config is owned by
# ── the repo owner like the settings.toml migration above. ──
if [[ -n $REPO && -f $REPO/config/noctalia/config.toml && -n $noct_owner && -n $noct_home ]]; then
  ncfg="$noct_home/.config/noctalia/config.toml"
  if [[ ! -f $ncfg ]]; then
    mkdir -p "$noct_home/.config/noctalia"
    nog="$(stat -c %G "$noct_home" 2>/dev/null || echo users)"
    install -o "$noct_owner" -g "$nog" -m 644 "$REPO/config/noctalia/config.toml" "$ncfg" && \
      log "seeded noctalia config (repo default was missing on this box)"
  fi
fi

# ── 3a3. gnome-keyring: fingerprint-first login (pam_fprintd) has no password,
# ── so the login keyring can never auto-unlock → "unlock your keyring" popups
# ── (Brave/Chromium) every boot. Seed a passwordless login keyring, but ONLY
# ── where none exists yet — non-destructive, and with no keyring there is no
# ── daemon holding secrets, so it is safe from the alpm-hook (root) context. ──
if [[ -n $noct_owner && -n $noct_home && -n $REPO && -x $REPO/bin/hexciri-gkr-init.sh ]]; then
  runuser -u "$noct_owner" -- env HOME="$noct_home" "$REPO/bin/hexciri-gkr-init.sh" 2>/dev/null || true
fi

# ── 3a4. ~/.local/bin link sweep: every hexciri-* command in the repo gets a
# ── symlink in the owner's ~/.local/bin (same as install.sh's linking step).
# ── Idempotent; ensures new/renamed commands on already-installed boxes. ──
if [[ -n $REPO && -d $REPO/bin && -n $noct_owner && -n $noct_home ]]; then
  localbin="$noct_home/.local/bin"
  mkdir -p "$localbin"
  for f in "$REPO"/bin/*; do
    [[ -f $f && -x $f ]] || continue
    name="$(basename "$f")"
    ln -sfn "$REPO/bin/$name" "$localbin/$name"
  done
  log "~/.local/bin link sweep done"
fi

# ── 3a5. curated repo packages: re-assert the set install.sh ships, so a
# ── package that was removed (or never landed on a box that installed before
# ── it was added) comes back on the next system update. Shares lib/packages
# ── with install.sh — the same list drives both, so they can't drift. AUR
# ── builds (brave/yay/maplemono) are excluded deliberately: sync runs inside
# ── the pacman lock as root and cannot build AUR packages. ──
if [[ -n $REPO && -f $REPO/lib/packages ]]; then
  missing_pkgs=()
  while IFS= read -r p; do
    [[ -n $p && $p != \#* ]] || continue
    pacman -Q "$p" >/dev/null 2>&1 || missing_pkgs+=("$p")
  done < "$REPO/lib/packages"
  if ((${#missing_pkgs[@]})); then
    if pgrep -x pacman >/dev/null 2>&1; then
      log "curated packages missing ($(IFS=','; echo "${missing_pkgs[*]}")) — pacman holds the lock (hook run); run 'sudo hexciri-sync' after the transaction to restore"
    else
      pacman -S --noconfirm --needed "${missing_pkgs[@]}" >/dev/null 2>&1 && \
        log "installed missing curated packages: ${missing_pkgs[*]}" || \
        log "WARNING: failed to install ${missing_pkgs[*]}"
    fi
  fi
fi

# ── 3a5b. imv image MIME heal: a box installed before the imv default, or where
# ── a browser grabbed image/* (Brave ships its own association), opens images
# ── in the browser despite the state saying imv. Re-runs the same helper
# ── install.sh uses (as the repo owner — sync runs as root), but it only acts
# ── when a browser/no handler owns the MIME, so a deliberate pick survives. ──
if [[ -n $REPO && -x $REPO/bin/hexciri-imv-defaults && -n $noct_owner && -n $noct_home ]]; then
  runuser -u "$noct_owner" -- env HOME="$noct_home" HEXCIRI_PATH="$REPO" \
    "$REPO/bin/hexciri-imv-defaults" >/dev/null 2>&1 || true
fi

# ── 3a6. kitty: harden allow_remote_control ('yes' → 'socket-only'). 'yes'
# ── exposes the control socket to any process with display access; the repo
# ── default changed in 1454112, but a box installed before it keeps 'yes'.
# ── Idempotent; a hardened file is left alone; user edits otherwise survive. ──
if [[ -n $noct_home && -f $noct_home/.config/kitty/kitty.conf ]] \
   && grep -q 'allow_remote_control yes' "$noct_home/.config/kitty/kitty.conf"; then
  sed -i 's|allow_remote_control yes|allow_remote_control socket-only|' \
    "$noct_home/.config/kitty/kitty.conf" && \
    log "kitty: remote control hardened to socket-only (pre-1454112 config migrated)"
fi

# ── 1. systemd-boot: regenerate one hexciri-<kernel>.conf per installed kernel ──
if [[ -d /boot/loader ]]; then
  before="$( (cat /boot/loader/loader.conf 2>/dev/null; for f in /boot/loader/entries/hexciri-*.conf; do [[ -e $f ]] && { echo "== $f"; cat "$f"; }; done) | md5sum )"
  ROOTUUID="$(findmnt -no UUID / 2>/dev/null || true)"
  ROOTOPTS="root=UUID=$ROOTUUID rw quiet"
  MICRO="$(ls /boot/*-ucode.img 2>/dev/null | head -n 1 | xargs basename 2>/dev/null || true)"
  if [[ -z $ROOTUUID ]]; then
    log "warning: no root UUID resolvable, skipping loader entries"
  elif compgen -G '/boot/vmlinuz-*' >/dev/null; then
    rm -f /boot/loader/entries/hexciri-*.conf
    for img in /boot/vmlinuz-*; do
      k="${img#/boot/vmlinuz-}"
      {
        echo "title   Hexciri ($k)"
        echo "linux   /vmlinuz-$k"
        [[ -n $MICRO ]] && echo "initrd  /$MICRO"
        echo "initrd  /initramfs-$k.img"
        echo "options $ROOTOPTS"
      } > "/boot/loader/entries/hexciri-$k.conf"
    done
    # default = newest kernel by initramfs mtime, UNLESS the user pinned one via
    # hexciri-kernel/hexciri-gpu (recorded in /usr/share/hexciri/boot-default) —
    # that choice wins as long as its entry still exists. A pinned default is how
    # a deliberate bore/LTS pick survives a later stock-kernel rebuild (which
    # would otherwise steal the default by having the freshest mtime).
    default=""
    if [[ -r /usr/share/hexciri/boot-default ]]; then
      pin="$(cat /usr/share/hexciri/boot-default 2>/dev/null || true)"
      [[ -f /boot/loader/entries/$pin ]] && default="$pin"
    fi
    if [[ -z $default ]]; then
      newest="$(ls -1t /boot/initramfs-*.img 2>/dev/null | head -n 1 | xargs basename 2>/dev/null | sed 's/^initramfs-//; s/\.img$//' || echo linux)"
      default="hexciri-$newest.conf"
    fi
    # console-mode max = highest GOP resolution = smallest/most readable text.
    # systemd-boot's default can pick a low-res console mode that renders an
    # ~1 inch tall font on high-density panels. A user-set `console-mode` in the
    # current loader.conf wins (their override survives regeneration); otherwise
    # we stamp max.
    cmode="$(awk '$1=="console-mode"{print $2; exit}' /boot/loader/loader.conf 2>/dev/null)"
    [[ -n $cmode ]] || cmode="max"
    echo -e "default $default\ntimeout 3\nconsole-mode $cmode" > /boot/loader/loader.conf
    after="$( (cat /boot/loader/loader.conf 2>/dev/null; for f in /boot/loader/entries/hexciri-*.conf; do [[ -e $f ]] && { echo "== $f"; cat "$f"; }; done) | md5sum )"
    [[ $before != $after ]] && log "systemd-boot entries regenerated (default: $default)" || true
  fi
fi

# ── 3. SDDM greeter: pin the X11 greeter. Boxes that ran the 09-09 Wayland
# ── experiment have DisplayServer=wayland + GreeterEnvironment in the conf and
# ── a stray weston compositor — revert both; sddm's default X11 greeter is the
# ── supported baseline. ──
_hexciri_conf=/etc/sddm.conf.d/10-hexciri-theme.conf
if [[ -f $_hexciri_conf ]] && grep -q '^DisplayServer=wayland' "$_hexciri_conf"; then
  printf '[Theme]\nCurrent=hexciri\n' > "$_hexciri_conf" && \
    log "sddm: reverted 10-hexciri-theme.conf to X11 greeter ([Theme] Current=hexciri)"
fi
if pacman -Q weston >/dev/null 2>&1; then
  pacman -R --noconfirm weston >/dev/null 2>&1 && \
    log "removed weston (Wayland greeter compositor no longer used)" || \
    log "warning: weston still installed"
fi

# ── 3b. SDDM + system-auth PAM: restore gnome-keyring (sddm) and put fprintd
# ── first in system-auth (covers sddm/sudo/su/login in one place; sddm's own
# ── file must NOT duplicate it or the greeter prompts twice) ──
if [[ -f /etc/pam.d/system-auth ]] && ! grep -Ev '^\s*#' /etc/pam.d/system-auth | grep -q 'pam_fprintd.so'; then
  cp -f /etc/pam.d/system-auth "/etc/pam.d/system-auth.bak.$(date +%s)" 2>/dev/null || true
  sed -i '0,/^auth/p;s//auth       sufficient                  pam_fprintd.so\n&/' /etc/pam.d/system-auth
  log "restored system-auth (fingerprint-first, covers sddm/sudo/su/login)"
fi
if [[ -f /etc/pam.d/sddm ]] && ! grep -Ev '^\s*#' /etc/pam.d/sddm | grep -q 'pam_gnome_keyring.so'; then
  cp -f /etc/pam.d/sddm "/etc/pam.d/sddm.bak.$(date +%s)" 2>/dev/null || true
  # the gnome-keyring/kwallet lines go right after 'auth include system-login'
  sed -i '/^auth *include *system-login/a -auth       optional    pam_gnome_keyring.so\n-auth       optional    pam_kwallet5.so' /etc/pam.d/sddm
  sed -i '/^password *include *system-login/a -password   optional    pam_gnome_keyring.so    use_authtok' /etc/pam.d/sddm
  sed -i '/^session *include *system-login/a -session    optional    pam_gnome_keyring.so    auto_start\n-session    optional    pam_kwallet5.so         auto_start' /etc/pam.d/sddm
  log "restored sddm PAM (gnome-keyring)"
fi

# ── 3c. niri-only: hexciri no longer ships hyprland/sway/mango sessions — drop
# ── the leftover login-gate entries AND user config dirs a pre-purge box
# ── accumulated (sddm would still offer/start them otherwise). Packages are
# ── left installed deliberately; the user removes those by hand (pacman -Rns)
# ── when ready. A WM actually running right now is left untouched. ──
for _other in hyprland sway mango; do
  for _sessdir in /usr/share/wayland-sessions /usr/local/share/wayland-sessions; do
    if [[ -f "$_sessdir/$_other.desktop" ]]; then
      rm -f "$_sessdir/$_other.desktop"
      log "purged leftover session entry $_sessdir/$_other.desktop"
    fi
  done
done
if [[ -n $noct_home ]]; then
  for _wm in hypr sway mango; do
    _cfg="$noct_home/.config/$_wm"
    [[ -e $_cfg ]] || continue
    case "$_wm" in
      hypr)  _bin=Hyprland ;;
      sway)  _bin=sway ;;
      mango) _bin=mango ;;
    esac
    if pgrep -x "$_bin" >/dev/null 2>&1; then
      log "skipping '$_wm' config purge: $_bin is running right now"
      continue
    fi
    rm -rf "$_cfg"
    log "purged leftover '$_wm' config: $_cfg"
  done
fi

# ── 3b. gnome-keyring pin + socket race. 50.0 crashes (SIGABRT on concurrent
# ── Secret Service OpenSession/PKCS11), which is why it's parked at 48.0 via
# ── IgnorePkg. The version pin alone doesn't stop the run: the
# ── gnome-keyring-daemon.socket unit ships enabled at GLOBAL scope
# ── (/etc/systemd/user/sockets.target.wants/), so socket activation can start
# ── the daemon BEFORE PAM runs and pam_gnome_keyring's auto_start loses the
# ── race → locked login keyring + unlock popup. Disabling the socket globally
# ── re-asserts that PAM auto_start stays the sole starter. Re-asserted here so
# ── any gnome-keyring/sddm transaction undoing it is corrected.
systemctl --global disable gnome-keyring-daemon.socket gnome-keyring-daemon.service 2>/dev/null || true
if ! grep -Eq '^IgnorePkg[[:space:]]*=.*gnome-keyring' /etc/pacman.conf; then
  # must live under [options]; appending at EOF lands in the last repo section
  sed -i '/^\[options\]/a IgnorePkg = gnome-keyring' /etc/pacman.conf
  log "pin gnome-keyring via IgnorePkg (50.0 has an unfixed crash)"
fi
if pacman -Q gnome-keyring 2>/dev/null | grep -qE '[ :]50\.'; then
  gkr_pkg=/var/cache/pacman/pkg/gnome-keyring-1:48.0-1-x86_64.pkg.tar.zst
  if [[ ! -f $gkr_pkg ]] && ! curl -fsSLo "$gkr_pkg" "https://archive.archlinux.org/packages/g/gnome-keyring/gnome-keyring-1%3A48.0-1-x86_64.pkg.tar.zst"; then
    log "WARNING: gnome-keyring 50.0 installed (crashy) and the 48.0 archive could not be fetched; downgrade manually:"
    log "  pacman -U $gkr_pkg"
  elif ! pgrep -x pacman >/dev/null; then
    pacman -U --noconfirm "$gkr_pkg"
    log "downgraded gnome-keyring to 48.0 (50.0 crashes; parked until upstream fixes it)"
  else
    log "WARNING: gnome-keyring 50.0 landed in this transaction; queuing the 48.0 downgrade for right after pacman exits"
    # We're inside an alpm hook, so pacman holds the lock — a nested pacman -U would
    # deadlock. Schedule the re-run ourselves instead of making the user do it:
    # prefer a transient systemd timer, fall back to a detached wait-loop.
    if command -v systemd-run >/dev/null 2>&1 && systemd-run --no-block --unit=hexciri-gkr-retry --on-active=1m /usr/local/bin/hexciri-sync >/dev/null 2>&1; then
      log "downgrade queued (transient timer hexciri-gkr-retry, fires in ~1min)"
    else
      setsid nohup bash -c 'while pgrep -x pacman >/dev/null 2>&1; do sleep 2; done; /usr/local/bin/hexciri-sync' >/dev/null 2>&1 &
      log "downgrade queued (detached retry, runs once pacman exits)"
    fi
  fi
fi

# ── 4. hardening: re-assert ufw (deny-in/allow-out + ssh) and the sshd
# ── key-only drop-in. ufw is a plain service, so a package update can't
# ── drop the rules, but a reinstall of /etc/ssh (or a removed drop-in) can
# ── silently re-open password auth. Firewall first: if ufw is disabled the
# ── box is wide open, so re-enable without --now conflict (idempotent).
if command -v ufw >/dev/null 2>&1; then
  systemctl is-enabled --quiet ufw.service || { systemctl enable ufw.service >/dev/null 2>&1 && log "ufw service enabled (was disabled)" || true; }
  if systemctl is-active --quiet ufw.service; then
    ufw --force enable >/dev/null 2>&1 || true
  else
    systemctl start ufw.service >/dev/null 2>&1 && log "ufw started"
  fi
  ufw default deny incoming >/dev/null 2>&1 || true
  ufw default allow outgoing >/dev/null 2>&1 || true
  ufw allow ssh >/dev/null 2>&1 || true
  # LocalSend (53317): allow from anywhere, not a hardcoded subnet — this box
  # moves between networks, and a stale subnet silently breaks transfers while
  # discovery (UDP broadcast) keeps working. ufw re-adds idempotently.
  ufw allow proto tcp to any port 53317 >/dev/null 2>&1 || true
  ufw allow proto udp to any port 53317 >/dev/null 2>&1 || true
fi
mkdir -p /etc/ssh/sshd_config.d
if [[ ! -f /etc/ssh/sshd_config.d/99-hardening.conf ]]; then
  cat > /etc/ssh/sshd_config.d/99-hardening.conf <<'SSHEOF'
# hexciri: sshd hardening — key-only auth, no root password login
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
PubkeyAuthentication yes
MaxAuthTries 3
SSHEOF
  log "restored sshd hardening drop-in (key-only, no root password)"
  sshd -t 2>/dev/null && systemctl restart sshd 2>/dev/null || \
    log "WARNING: sshd -t failed — hardening drop-in written but not activated"
fi

# ── 4a. network file sharing: Samba (smb/nmb) enabled out of the box;
# ── a pkg removal/update won't disable a unit, but re-assert is cheap and
# ── idempotent. NFS needs no services — mounts are user-configured. ──
systemctl enable smb.service >/dev/null 2>&1 || true
systemctl enable nmb.service >/dev/null 2>&1 || true

# ── 5. app-menu curation: re-hide utility entries the packages re-show ──
for f in avahi-discover.desktop bssh.desktop bvnc.desktop lstopo.desktop \
         qv4l2.desktop qvidcap.desktop qt6ct.desktop; do
  d="/usr/share/applications/$f"
  [[ -f $d ]] && ! grep -q '^NoDisplay=true' "$d" && printf 'NoDisplay=true\n' >> "$d" && log "hid $f"
done

# ── 6. per-PC makepkg tuning (jobs + CPU tier): write quietly on upgrades too,
# ── so machines that installed before 1.5 get it with a plain system update ──
if [[ -f $REPO/lib/makepkg-tuning.sh ]]; then
  # shellcheck disable=SC1091
  . "$REPO/lib/makepkg-tuning.sh"
  tbefore="$(md5sum /etc/makepkg.conf.d/hexciri-tuning.conf 2>/dev/null || true)"
  hexciri_apply_makepkg_tuning || true
  tafter="$(md5sum /etc/makepkg.conf.d/hexciri-tuning.conf 2>/dev/null || true)"
  [[ $tbefore != $tafter ]] && log "per-PC makepkg tuning applied ($(nproc) threads)" || true
else
  log "per-PC makepkg tuning skipped (repo checkout missing lib/makepkg-tuning.sh)"
fi

exit 0