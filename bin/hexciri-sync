#!/bin/bash
# hexciri:summary=Re-apply hexciri system state after package transactions (alpm hook + manual)
# Package upgrades routinely clobber hexciri's bits:
#   * avahi/hwloc/v4l-utils/qt6ct restore their stock .desktop files, so the
#     NoDisplay curation reverts and the menu cruft returns
# Runs as root via /usr/share/libalpm/hooks/hexciri-sync.hook (PostTransaction)
# or manually. Idempotent; safe to run any time.
#
# FIX POLICY: every bug fix ships BOTH here — covering existing machines via a
# plain system update — AND in install.sh (see its matching header), covering
# fresh installs. Sync this file whenever you touch one or the other.
set -euo pipefail

log() { echo "hexciri-sync: $*"; }

# ── 2. self-update: this script is a symlink into the repo checkout, so a slow
# ── repo means a stale hook. A package update is the user's 'it just works'
# ── moment — don't make them run a manual step to bring the framework forward.
# ── Pull the checkout first (non-fatal: dirty/unreachable degrades to the local
# ── code), then re-apply the hook file from the pulled tree so newer hook
# ── targets ride along immediately. When running as root (alpm hook) the repo
# ── is user-owned, so pull as its owner to avoid root-owned files. Step 2b then
# ── re-execs from the freshly-pulled tree so THIS invocation runs newest code. ──
REPO=""
[[ -n ${HEXCIRI_REPO:-} ]] && REPO="$HEXCIRI_REPO"
# Resolve the repo independent of the invoking context. `-L` on $0 alone is
# unreliable (bash often presents the resolved path, and `sudo hexciri-sync`
# passes just the name), so fall back to `command -v` against PATH — that finds
# the /usr/local/bin -> repo/bin/hexciri-sync symlink even for root, whose HOME
# (~/.local/opt/hexciri) would otherwise be used and come up empty.
if [[ -z $REPO ]]; then
  for p in "$0" "$(command -v "${0##*/}" 2>/dev/null || true)"; do
    [[ -n $p ]] || continue
    real="$(readlink -f "$p" 2>/dev/null || true)"
    [[ -n $real ]] || continue
    cand="$(cd "$(dirname "$real")/.." 2>/dev/null && pwd || true)"
    [[ -n $cand && -f $cand/bin/hexciri-sync ]] && { REPO="$cand"; break; }
  done
fi
[[ -n $REPO ]] || REPO="${HEXCIRI_REPO:-$HOME/.local/opt/hexciri}"
[[ -d $REPO ]] || REPO=""
export HEXCIRI_REPO="$REPO"
if [[ -d $REPO/.git ]]; then
  head_before="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
  if [[ $EUID -eq 0 ]]; then
    owner="$(stat -c %U "$REPO" 2>/dev/null || echo root)"
    if command -v runuser >/dev/null && [[ $owner != root ]]; then
      runuser -u "$owner" -- git -C "$REPO" pull --ff-only >/dev/null 2>&1 || \
        log "warning: repo pull skipped/failed (dirty tree or offline?) — continuing with local code"
    else
      git -C "$REPO" pull --ff-only >/dev/null 2>&1 || true
    fi
  else
    git -C "$REPO" pull --ff-only >/dev/null 2>&1 || true
  fi
  if [[ -f $REPO/default/alpm/hexciri-sync.hook ]] && ! cmp -s "$REPO/default/alpm/hexciri-sync.hook" /usr/share/libalpm/hooks/hexciri-sync.hook 2>/dev/null; then
    install -m644 "$REPO/default/alpm/hexciri-sync.hook" /usr/share/libalpm/hooks/hexciri-sync.hook 2>/dev/null && \
      log "re-applied alpm hook from repo (newer targets active from the next transaction)"
  fi

  # ── 2b. one-shot self-heal: this process ran the PRE-pull bytes of this script
  # ── (the pull could not also be its own upgrade). Re-exec from the JUST-pulled
  # ── checkout ONLY when the pull actually advanced HEAD, so every step below —
  # ── hook re-apply, plugin update_cmd migration, and anything future fixes add
  # ── here — runs the NEWEST code within THIS same transaction, not the next one.
  # ── An unchanged HEAD (repo already current) just proceeds with the copy that
  # ── is running; nothing to re-exec. HXC_SYNC_RERUN guards the descending pass
  # ── (its pull is a fast-forward no-op, so it matches and moves on). ──
  if [[ ${HXC_SYNC_RERUN:-0} == 0 ]] && [[ -x $REPO/bin/hexciri-sync ]]; then
    head_after="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
    if [[ -n $head_before && -n $head_after && $head_before != $head_after ]]; then
      export HXC_SYNC_RERUN=1
      log "re-execing with pulled framework (new commits applied)"
      exec "$REPO/bin/hexciri-sync" "$@"
    fi
  fi
fi

# ── 3a. noctalia arch-updater plugin: migrate a stale update_cmd to the renamed
# ── updater (hexciri-update-run → hexciri-update). Runs as root; the plugin's
# ── settings.toml lives in the repo owner's state dir. The pre-rename shim
# ── keeps the old name working, so this is tidy-up, not load-bearing. ──
noct_home=""
if [[ -n $REPO ]]; then
  noct_owner="$(stat -c %U "$REPO" 2>/dev/null || true)"
  [[ -n $noct_owner ]] && noct_home="$(getent passwd "$noct_owner" 2>/dev/null | cut -d: -f6 || true)"
fi
[[ -n $noct_home ]] && [[ -f $noct_home/.local/state/noctalia/settings.toml ]] && \
  grep -q 'update_cmd = "hexciri-update-run"' "$noct_home/.local/state/noctalia/settings.toml" && \
  sed -i 's|update_cmd = "hexciri-update-run"|update_cmd = "hexciri-update"|' \
    "$noct_home/.local/state/noctalia/settings.toml" && \
  log "arch-updater plugin: update_cmd migrated to hexciri-update"

# ── noctalia bar config + plugin settings live in hexciri-update
# ── (sync_noctalia: user context, adopt-once with stock backup). ──

# ── 3a4. ~/.local/bin link sweep: every hexciri-* command in the repo gets a
# ── symlink in the owner's ~/.local/bin (same as install.sh's linking step).
# ── Idempotent; ensures new/renamed commands on already-installed boxes. ──
if [[ -n $REPO && -d $REPO/bin && -n $noct_owner && -n $noct_home ]]; then
  localbin="$noct_home/.local/bin"
  mkdir -p "$localbin"
  changed=0
  for f in "$REPO"/bin/*; do
    [[ -f $f && -x $f ]] || continue
    name="$(basename "$f")"
    if [[ ! -L "$localbin/$name" || "$(readlink "$localbin/$name")" != "$REPO/bin/$name" ]]; then
      ln -sfn "$REPO/bin/$name" "$localbin/$name" && changed=1
    fi
  done
  [[ $changed == 1 ]] && log "~/.local/bin links refreshed"
fi

# ── hook entry point: the alpm hook execs /usr/local/bin/hexciri-sync (root
# ── has no user PATH). Keep that one symlink pointed at this checkout; it is
# ── hexciri's own entry point, not distro management. ──
if [[ -n $REPO && -x $REPO/bin/hexciri-sync ]]; then
  ln -sfn "$REPO/bin/hexciri-sync" /usr/local/bin/hexciri-sync 2>/dev/null || true
fi

# ── packages: hexciri does not manage the OS app set. No curated wants, no
# ── removals, no AUR installs — install/remove your own apps; sync only
# ── re-applies configs, hides and hardening. (App swaps are one-time manual
# ── pacman/yay runs, not standing machinery.) ──

# ── boot entries + boot default are CachyOS's (kernel, bootloader, default).
# ── hexciri used to regenerate systemd-boot entries here; cut — owning the
# ── boot path on someone else's OS is exactly what this layer doesn't do. ──

# ── display manager, login/PAM auth stack, secrets/keyring, file sharing,
# ── MIME/app defaults, terminal hardening and dead-WM cleanup are the OS's
# ── (or the user's by hand). hexciri manages none of it: not its menu,
# ── not its theme, not its keybinds. ──

# ── 4. hardening: re-assert ufw (deny-in/allow-out + ssh) and the sshd
# ── key-only drop-in. ufw is a plain service, so a package update can't
# ── drop the rules, but a reinstall of /etc/ssh (or a removed drop-in) can
# ── silently re-open password auth. Firewall first: if ufw is disabled the
# ── box is wide open, so re-enable without --now conflict (idempotent).
if command -v ufw >/dev/null 2>&1; then
  systemctl is-enabled --quiet ufw.service || { systemctl enable ufw.service >/dev/null 2>&1 && log "ufw service enabled (was disabled)" || true; }
  if systemctl is-active --quiet ufw.service; then
    ufw --force enable >/dev/null 2>&1 || true
  else
    systemctl start ufw.service >/dev/null 2>&1 && log "ufw started"
  fi
  ufw default deny incoming >/dev/null 2>&1 || true
  ufw default allow outgoing >/dev/null 2>&1 || true
  ufw allow ssh >/dev/null 2>&1 || true
  # LocalSend (53317): allow from anywhere, not a hardcoded subnet — this box
  # moves between networks, and a stale subnet silently breaks transfers while
  # discovery (UDP broadcast) keeps working. ufw re-adds idempotently.
  ufw allow proto tcp to any port 53317 comment 'LocalSend' >/dev/null 2>&1 || true
  ufw allow proto udp to any port 53317 comment 'LocalSend' >/dev/null 2>&1 || true
fi
mkdir -p /etc/ssh/sshd_config.d
if [[ ! -f /etc/ssh/sshd_config.d/99-hardening.conf ]]; then
  cat > /etc/ssh/sshd_config.d/99-hardening.conf <<'SSHEOF'
# hexciri: sshd hardening — key-only auth, no root password login
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
PubkeyAuthentication yes
MaxAuthTries 3
SSHEOF
  log "restored sshd hardening drop-in (key-only, no root password)"
  sshd -t 2>/dev/null && systemctl restart sshd 2>/dev/null || \
    log "WARNING: sshd -t failed — hardening drop-in written but not activated"
fi

# ── 5. app-menu curation: re-hide utility entries the packages re-show ──
for f in avahi-discover.desktop avahi-zeroconf-browser.desktop bssh.desktop \
         bvnc.desktop btop.desktop lstopo.desktop \
         qv4l2.desktop qvidcap.desktop qt6ct.desktop; do
  d="/usr/share/applications/$f"
  [[ -f $d ]] || continue
  # Effective hide = NoDisplay=true inside [Desktop Entry] (a blind EOF append
  # would hide only a trailing [Desktop Action ...] group, if any).
  if awk 'BEGIN{in_entry=0} /^\[/{in_entry=($0=="[Desktop Entry]")} in_entry && /^NoDisplay=true$/{found=1} END{exit !found}' "$d"; then
    continue
  fi
  sed -i '/^NoDisplay=true$/d' "$d"
  sed -i '0,/^\[Desktop Entry\]$/s//[Desktop Entry]\nNoDisplay=true/' "$d" \
    && log "hid $f"
done

# ── 5b. nautilus is the default file manager again (Strata era over): undo
# ── the old hiding — strip NoDisplay=true this loop used to stamp into the
# ── system entry, so the launcher reappears without reinstalling nautilus. ──
if [[ -f /usr/share/applications/org.gnome.Nautilus.desktop ]] && \
   grep -q '^NoDisplay=true$' /usr/share/applications/org.gnome.Nautilus.desktop; then
  sed -i '/^NoDisplay=true$/d' /usr/share/applications/org.gnome.Nautilus.desktop \
    && log "unhid org.gnome.Nautilus.desktop (Strata-era NoDisplay removed)"
fi
# ── deleting /etc/sddm.conf.d/10-hexciri-theme.conf restores prior behavior.
# ── Fingerprint auto-submit is stamped per-box (reader → true, else false) so
# ── readerless boxes never red-flash an empty submit.
if [[ -n $REPO && -d $REPO/branding/sddm ]]; then
  tdir=/usr/share/sddm/themes/hexciri
  if [[ ! -f $tdir/Main.qml ]] || ! cmp -s "$REPO/branding/sddm/Main.qml" "$tdir/Main.qml" 2>/dev/null; then
    mkdir -p "$tdir"
    # Copy everything EXCEPT theme.conf: the deployed copy accumulates live
    # keys (Fingerprint, PreferredSession, theme-follow Background/*), and a
    # blind cp would wipe them back to the repo's bare [General] on every
    # Main.qml refresh — exactly how a themed login reverted to static.
    # theme.conf is seeded once when absent; keys are stamped below.
    for _bf in "$REPO"/branding/sddm/*; do
      [[ $(basename "$_bf") == theme.conf ]] && continue
      cp -rf "$_bf" "$tdir/" || true
    done
    unset _bf
    [[ -f $tdir/theme.conf ]] || cp -f "$REPO/branding/sddm/theme.conf" "$tdir/theme.conf" 2>/dev/null || true
    log "sddm theme deployed"
  fi
  fp=false
  if grep -ril finger /sys/bus/usb/devices/*/product 2>/dev/null | grep -q .; then fp=true; fi
  if ! grep -Eq "^Fingerprint=$fp\$" "$tdir/theme.conf" 2>/dev/null; then
    if grep -Eq '^Fingerprint=' "$tdir/theme.conf" 2>/dev/null; then
      sed -i -E "s/^Fingerprint=.*/Fingerprint=$fp/" "$tdir/theme.conf"
    else
      printf 'Fingerprint=%s\n' "$fp" >> "$tdir/theme.conf"
    fi
    log "sddm theme Fingerprint=$fp"
  fi
  # PreferredSession=<niri|hyprland> stamps the box's pinned WM into the
  # theme so the greeter defaults to it (Main.qml prefers it over the last
  # session). Source is the repo owner's ~/.config/hexciri/wm pin, falling
  # back to the single installed compositor; dual-WM boxes without a pin
  # leave the key out and the greeter uses SDDM's remembered session.
  ps=""
  if [[ -n ${noct_home:-} && -f $noct_home/.config/hexciri/wm ]]; then
    ps="$(tr -d '[:space:]' <"$noct_home/.config/hexciri/wm" 2>/dev/null || true)"
  fi
  case "${ps,,}" in
    hypr|hyprland) ps=hyprland ;;
    niri) ps=niri ;;
    *)
      ps=""
      if command -v Hyprland >/dev/null 2>&1 && ! command -v niri >/dev/null 2>&1; then ps=hyprland; fi
      if command -v niri >/dev/null 2>&1 && ! command -v Hyprland >/dev/null 2>&1; then ps=niri; fi
      ;;
  esac
  if [[ -n $ps ]]; then
    if ! grep -Eq "^PreferredSession=$ps\$" "$tdir/theme.conf" 2>/dev/null; then
      if grep -Eq '^PreferredSession=' "$tdir/theme.conf" 2>/dev/null; then
        sed -i -E "s/^PreferredSession=.*/PreferredSession=$ps/" "$tdir/theme.conf"
      else
        printf 'PreferredSession=%s\n' "$ps" >> "$tdir/theme.conf"
      fi
      log "sddm theme PreferredSession=$ps"
    fi
  fi
  drop=/etc/sddm.conf.d/10-hexciri-theme.conf
  if [[ ! -f $drop ]] || ! grep -Eq '^Current=hexciri$' "$drop" 2>/dev/null; then
    mkdir -p /etc/sddm.conf.d
    printf '[Theme]\nCurrent=hexciri\n' > "$drop" && log "sddm greeter → hexciri theme"
  fi
fi

# ── login-greeter appearance sync authorization (one-time per user): on
# ── greetd boxes the login page is noctalia-greeter and every theme-set
# ── pushes the new look via `noctalia msg greeter-sync`
# ── (hooks/theme-set.d/90-greeter-sync.sh). That sync needs admin auth per
# ── call unless this narrow polkit rule exists — enabling once (additive,
# ── never removes other accounts) makes all future syncs promptless.
# ── Root-only (writes the polkit rule); the user-context pass skips.
# ── FIX POLICY: mirrored in install.sh for fresh boxes. ──
if [[ $EUID -eq 0 ]] && command -v noctalia-greeter >/dev/null 2>&1 && [[ -n ${noct_owner:-} && $noct_owner != root ]]; then
  if noctalia-greeter passwordless-sync status "$noct_owner" >/dev/null 2>&1; then
    : # already allowed — steady state is silent
  elif noctalia-greeter passwordless-sync enable "$noct_owner" >/dev/null 2>&1; then
    log "greeter sync authorized passwordless for $noct_owner"
  else
    log "greeter sync stays admin-prompted for $noct_owner (enable by hand: sudo noctalia-greeter passwordless-sync enable $noct_owner)"
  fi
fi

# ── SDDM theme-follow privilege path: the theme hook stages wallpaper +
# ── palette per theme-set and installs them via the constrained helper below
# ── (pkexec action org.hexciri.sddm-apply). Root-only (writes libexec,
# ── polkit action + rule); the user-context pass skips — the root pass owns
# ── it. Refreshes when the repo advances (cmp-guarded, silent steady state):
# ── the helper copy (root-owned trusted prefix — the repo copy is NEVER run
# ── privileged), its polkit action, and the site-local rule that makes
# ── active local sessions promptless (defaults stay auth_admin).
if [[ $EUID -eq 0 && -n $REPO && -d $REPO/branding/sddm ]]; then
  HELPER_SRC="$REPO/bin/hexciri-sddm-apply" HELPER_DST=/usr/local/libexec/hexciri-sddm-apply
  if [[ -f $HELPER_SRC ]]; then
    if [[ ! -f $HELPER_DST ]] || ! cmp -s "$HELPER_SRC" "$HELPER_DST" 2>/dev/null; then
      mkdir -p "$(dirname "$HELPER_DST")"
      install -m755 "$HELPER_SRC" "$HELPER_DST" 2>/dev/null && log "sddm follow helper installed ($HELPER_DST)"
      chmod 755 "$HELPER_DST" 2>/dev/null || true
    fi
  fi
  POLICY_SRC="$REPO/default/polkit/org.hexciri.sddm-apply.policy"
  POLICY_DST=/usr/share/polkit-1/actions/org.hexciri.sddm-apply.policy
  if [[ -f $POLICY_SRC ]]; then
    if [[ ! -f $POLICY_DST ]] || ! cmp -s "$POLICY_SRC" "$POLICY_DST" 2>/dev/null; then
      install -m644 "$POLICY_SRC" "$POLICY_DST" 2>/dev/null && log "sddm follow polkit action installed"
    fi
  fi
  RULES_DST=/etc/polkit-1/rules.d/49-hexciri-sddm.rules
  RULES_WANT="$(cat <<'RULEEOF'
polkit.addRule(function (action, subject) {
  if (
    action.id == "org.hexciri.sddm-apply" &&
    action.lookup("program") == "/usr/local/libexec/hexciri-sddm-apply" &&
    action.lookup("user") == "root" &&
    subject.local &&
    subject.active
  ) {
    return polkit.Result.YES;
  }
});
RULEEOF
)"
  if [[ ! -f $RULES_DST ]] || [[ $(cat "$RULES_DST" 2>/dev/null) != "$RULES_WANT" ]]; then
    printf '%s\n' "$RULES_WANT" > "$RULES_DST" 2>/dev/null && chmod 644 "$RULES_DST" 2>/dev/null && \
      log "sddm follow promptless for active local sessions ($RULES_DST)" || \
      log "WARNING: could not write $RULES_DST (sddm follow will prompt for admin auth)"
  fi
  unset HELPER_SRC HELPER_DST POLICY_SRC POLICY_DST RULES_DST RULES_WANT
fi

# ── 6. xwayland-satellite pin (upstream #468): 0.8.2 regressed popup
# ── positioning (commit 3273a0f) — X11 dropdowns (Steam menus, etc.) spawn
# ── offset and lose hover on niri. Hold at last-good 0.8.1 until a fixed
# ── 0.8.3+ lands in the repos, then drop this block. File edit only: this
# ── also runs inside the alpm PostTransaction hook, where the pacman db lock
# ── is held, so it must never run pacman here. The downgrade itself lives in
# ── install.sh and hexciri-update (both run outside transactions).
# ── FIX POLICY: mirrored in install.sh; downgrade mirrored there + update. ──
if [[ -f /etc/pacman.conf ]]; then
  if grep -Eq '^IgnorePkg.*xwayland-satellite' /etc/pacman.conf 2>/dev/null; then
    : # already held
  elif grep -Eq '^IgnorePkg[[:space:]]*=' /etc/pacman.conf 2>/dev/null; then
    sed -Ei 's/^(IgnorePkg[^#]*)(#.*)?$/\1 xwayland-satellite \2/' /etc/pacman.conf 2>/dev/null \
      && log "pacman: held xwayland-satellite (IgnorePkg)" || \
      log "WARNING: could not hold xwayland-satellite in /etc/pacman.conf"
  elif grep -Eq '^#IgnorePkg[[:space:]]*=' /etc/pacman.conf 2>/dev/null; then
    sed -Ei '0,/^#IgnorePkg[[:space:]]*=.*/s//IgnorePkg = xwayland-satellite/' /etc/pacman.conf 2>/dev/null \
      && log "pacman: held xwayland-satellite (IgnorePkg)" || \
      log "WARNING: could not hold xwayland-satellite in /etc/pacman.conf"
  else
    printf '\nIgnorePkg = xwayland-satellite\n' >> /etc/pacman.conf 2>/dev/null \
      && log "pacman: held xwayland-satellite (IgnorePkg)" || \
      log "WARNING: could not hold xwayland-satellite in /etc/pacman.conf"
  fi
fi

exit 0