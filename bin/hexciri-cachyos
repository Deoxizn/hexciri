#!/bin/bash
# hexciri:summary=CachyOS prebuilt-kernel delivery: per-CPU tier detect + direct fetch install/update
# usage: hexciri-cachyos [tier|install <pkg>|status]
#   tier    print this CPU's cachyos repo tier: znver4|v4|v3|generic (read-only)
#   install <pkg>  fetch + pacman -U the newest <pkg> (+headers) for the detected tier.
#                  <pkg> = linux-cachyos | linux-cachyos-bore | linux-cachyos-lts
#   status  show installed cachyos kernels and whether a newer build exists
# Direct fetch, no repo adoption: packages install as local files, so pacman -Syu
# never updates them — hexciri-update re-runs `install` for installed kernels.
# Sig: cachyos packages are signed; we import + local-sign the cachyos key once.
set -euo pipefail

MIRROR="https://mirror.cachyos.org/repo"

err()  { echo -e "\e[0;31m[hexciri:cachyos]\e[0m $*" >&2; }
info() { echo -e "\e[0;36m[hexciri:cachyos]\e[0m $*"; }

# ── tier detection: glibc's loader reports this exact CPU's x86-64-v3/v4
#    capability (the same source pacman/pacman-key use); AMD v4-capable =
#    Zen 4/5 → znver4 (AVX-512 on AMD exists only on Zen4+, so "v4 + AuthenticAMD"
#    uniquely identifies it). ──
detect_tier() {
  local ld=/lib/ld-linux-x86-64.so.2
  local v3=false v4=false amd=false
  $ld --help 2>/dev/null | grep -q 'x86-64-v3 (supported,' && v3=true
  $ld --help 2>/dev/null | grep -q 'x86-64-v4 (supported,' && v4=true
  grep -q '^vendor_id\s*:\s*AuthenticAMD' /proc/cpuinfo && amd=true
  if $v4 && $amd; then echo "znver4"
  elif $v4; then echo "v4"
  elif $v3; then echo "v3"
  else echo "generic"; fi
}

tier_dir() { # $1 tier -> "dirname archsuffix"
  case $1 in
    znver4) echo "x86_64_v4/cachyos-znver4 x86_64_v4" ;;
    v4)     echo "x86_64_v4/cachyos-v4     x86_64_v4" ;;
    v3)     echo "x86_64_v3/cachyos-v3     x86_64_v3" ;;
    *)      echo "x86_64/cachyos           x86_64" ;;
  esac
}

ensure_key() { # import + local-sign the cachyos signing key (idempotent)
  if ! pacman-key --list-keys F3B607488DB35A47 >/dev/null 2>&1; then
    info "importing cachyos signing key..."
    sudo pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com
    sudo pacman-key --lsign-key F3B607488DB35A47
  fi
}

latest() { # $1 pkg (linux-cachyos[-bore|-lts]) -> full URL of newest build
  local tier dir arch
  tier="$(detect_tier)"; read -r dir arch <<< "$(tier_dir "$tier")"
  # date-sorted (newest build first); base package filename starts with the
  # version (a digit) so `-bore`/`-lts`/`-headers` variants never match it
  curl -fsSL "$MIRROR/$dir/?C=M&O=D" 2>/dev/null \
    | grep -oE "href=\"$1-[0-9][^\"]*\.pkg\.tar\.zst\"" \
    | head -n 1 | sed 's/^href="//; s/"$//' \
    | sed "s#^#$MIRROR/$dir/#"
}

latest_headers() { # $1 pkg -> URL of the matching -headers build
  latest "$1" | sed -E "s#/$1-([0-9])#/$1-headers-\1#"
}

installed_ver() { pacman -Q "$1" 2>/dev/null | awk '{print $2}' || true; }
url_ver() { echo "$1" | sed -E "s#^.*/$1-([0-9][^/]*)-x86_64[^/]*\.pkg\.tar\.zst\$#\1#"; }

do_install() { # $1 pkg: fetch + pacman -U newest build + headers
  local pkg=$1 url hurl t/partst
  case "$pkg" in
    linux-cachyos|linux-cachyos-bore|linux-cachyos-lts) ;;
    *) err "unknown kernel package '$pkg'"; exit 1 ;;
  esac
  [[ $(id -u) -eq 0 ]] || { err "install needs root — run with sudo/hexciri-kernel"; exit 1; }
  info "tier: $(detect_tier)"
  ensure_key
  url="$(latest "$pkg")" || { err "could not resolve newest $pkg (offline?)"; exit 1; }
  hurl="$(latest_headers "$pkg")"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  info "downloading $url"
  curl -fLo "$tmp/$(basename "$url")" "$url"
  curl -fLo "$tmp/$(basename "$url").sig" "$url.sig" 2>/dev/null || true
  info "downloading ${hurl}"
  curl -fLo "$tmp/$(basename "$hurl")" "$hurl"
  curl -fLo "$tmp/$(basename "$hurl").sig" "$hurl.sig" 2>/dev/null || true
  pacman -U --noconfirm "$tmp/$(basename "$url")" "$tmp/$(basename "$hurl")"
  info "$pkg $(url_ver "$url") installed (systemd-boot entry generated by hexciri-sync)"
}

do_status() {
  local any=false pkg
  for pkg in linux-cachyos linux-cachyos-bore linux-cachyos-lts; do
    local cur="" newest=""
    cur="$(installed_ver "$pkg")"
    [[ -n $cur ]] || continue
    any=true
    newest="$(latest "$pkg" 2>/dev/null || true)"
    newest_ver="$(url_ver "$newest" 2>/dev/null || true)"
    if [[ -n $newest_ver && $newest_ver != "$cur" ]]; then
      info "$pkg $cur installed — newer $newest_ver available (hexciri-update will fetch it)"
    else
      info "$pkg $cur installed — up to date"
    fi
  done
  $any || info "no cachyos kernel installed (menu: System ▸ Kernel)"
  info "tier: $(detect_tier)"
}

case "${1:-status}" in
  tier) detect_tier ;;
  install)
    [[ -n ${2:-} ]] || { err "install needs a package: linux-cachyos|linux-cachyos-bore|linux-cachyos-lts"; exit 1; }
    do_install "$2"
    ;;
  status) do_status ;;
  *) err "unknown action '${1:-}' (tier|install|status)"; exit 1 ;;
esac