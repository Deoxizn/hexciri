#!/bin/bash
# hexciri:summary=Measure live disk read and write speed (dd-based)
# hexciri:args=[target-dir]
set -euo pipefail

target_dir="${1:-${XDG_CACHE_HOME:-$HOME/.cache}/hexciri}"
mkdir -p "$target_dir"

size_mb=256
block_mb=4
file="$target_dir/hexciri-disk-speedtest.tmp"
src=/dev/shm/hexciri-speedtest-src

cleanup() {
  rm -f "$file" "$src" 2>/dev/null || true
}
trap cleanup EXIT

if [[ ! -w $target_dir ]]; then
  echo "Cannot write to $target_dir" >&2
  exit 1
fi

dd_rate() { # <args...> — dd to a device sink, print the resulting MB/s
  dd "$@" 2>&1 >/dev/null |
    grep -oE '[0-9]+(\.[0-9]+)? (MB|MiB)/s' |
    tail -n1 | awk '{print $1}'
}

echo "writing $size_mb MiB to $target_dir ..."
# Incompressible source from RAM so nothing between dd and the flash can shrink it.
dd if=/dev/urandom of="$src" bs=${block_mb}M count=$((size_mb / block_mb)) status=none

write_rate=$(dd_rate if="$src" of="$file" bs=${block_mb}M oflag=direct conv=notrunc)
echo "write: ${write_rate:-?} MiB/s"

echo "dropping caches (needs sudo) ..."
sudo sh -c 'sync; echo 3 > /proc/sys/vm/drop_caches' 2>/dev/null || echo "  (skipped — cached read will overstate)"

read_rate=$(dd_rate if="$file" of=/dev/null bs=${block_mb}M iflag=direct)
echo "read: ${read_rate:-?} MiB/s"