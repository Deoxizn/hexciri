#!/bin/bash
# hexciri:menu=system
# hexciri:summary=System submenu: config, apps, fonts, network, security, kernel, maintenance.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choice=$(
  printf '%s\n' \
    'Config >' \
    'Default Apps >' \
    'Fonts' \
    'Kernel >' \
    'Maintenance >' \
    'Windows product key' \
    'Reset defaults' \
    'Network >' \
    'Security >' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='System: ' --width=26 --lines=9
) || exec "$SCRIPT_DIR/hexciri-menu"   # Esc = back to root menu
choice=${choice%' >'}

case "$choice" in
  "Config")       exec "$SCRIPT_DIR/hexciri-config" ;;
  "Default Apps") exec "$SCRIPT_DIR/hexciri-defaults" ;;
  "Fonts")        exec "$SCRIPT_DIR/hexciri-font" ;;
  "Kernel")       exec "$SCRIPT_DIR/hexciri-kernel" ;;
  "Maintenance")  exec "$SCRIPT_DIR/hexciri-maintenance" ;;
  "Windows product key") exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$SCRIPT_DIR/hexciri-windows-key" ;;
  "Reset defaults") exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$SCRIPT_DIR/hexciri-reinstall" ;;
  "Network")      exec "$SCRIPT_DIR/hexciri-network" ;;
  "Security")     exec "$SCRIPT_DIR/hexciri-security" ;;
esac
