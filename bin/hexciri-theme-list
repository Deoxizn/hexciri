#!/bin/bash
# hexciri:summary=List available themes
set -euo pipefail
HEXCIRI_PATH="${HEXCIRI_PATH:-/usr/share/hexciri}"
{
  find "$HOME/.config/hexciri/themes/" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) \
    -exec test -f '{}/colors.toml' \; -printf '%f\n' 2>/dev/null || true
  find "$HEXCIRI_PATH/themes/" -mindepth 1 -maxdepth 1 -type d \
    -exec test -f '{}/colors.toml' \; -printf '%f\n' 2>/dev/null || true
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
