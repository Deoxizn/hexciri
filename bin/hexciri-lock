#!/bin/bash
# hexciri:lock=session-lock
# hexciri:summary=Lock screen + power off monitors after 20s if still locked
# hexciri-lock — lock screen + power off monitors after 20s
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

"$SCRIPT_DIR/hexciri-compositor" lock

# Power off monitors after 20s if still locked (Noctalia owns idle timeouts)
sleep 20
case "$("$SCRIPT_DIR/hexciri-session" wm)" in hyprland) hyprctl dispatch dpms off 2>/dev/null;; *) true;; esac
