#!/bin/bash
# hexciri:summary=Spotify+Spicetify bring-up: point spicetify at the bundle, backup+apply, set hexciri theme
# hexciri:args=— one-shot; idempotent (safe to re-run after any theme change)
#
# Fresh Spotify installs are never themed until spicetify (a) knows the real
# bundle path, (b) has patched that bundle, and (c) has a current_theme set.
# The hexciri template hook only GENERATES the theme — it deliberately does not
# apply. So the first apply, path pointing, and backup happen HERE, once.
# Re-run any time after reinstalling Spotify or wiping ~/.config/spicetify.
set -euo pipefail

spc=$(command -v spicetify || true)
[[ -n $spc ]] || { echo "spicetify-cli not installed (yay -S spicetify-cli)" >&2; exit 1; }

# Resolve the real app bundle. The AUR spotify package ships /opt/spotify with
# 777 dirs so a normal-user apply can rewrite the apps; official RPM-style and
# snap/flatpak layouts differ. First match wins.
SP_DIR=""
for d in /opt/spotify /usr/share/spotify "$HOME/snap/spotify/current/usr/share/spotify"; do
  [[ -d $d && -f $d/spotify ]] && { SP_DIR="$d"; break; }
done
[[ -n $SP_DIR ]] || { echo "spotify bundle not found (install spotify first)" >&2; exit 1; }

cur=$(spicetify config spotify_path 2>/dev/null | awk '{printf "%s", $2}' | sed 's:/*$::')
[[ $cur == "$SP_DIR" ]] || { spicetify config spotify_path "$SP_DIR" >/dev/null 2>&1; echo "spotify_path → $SP_DIR"; }

prefs="$HOME/.config/spotify/prefs"
mkdir -p "$(dirname "$prefs")"
[[ -f $prefs ]] || : > "$prefs"
spicetify config prefs_path "$prefs" >/dev/null 2>&1 || true

# Patch the bundle (backup + apply in one go). Root-owned 644 files on some
# layouts need sudo for the first pass; non-interactive sudo only, so a menu/
# hook context never hangs on a password prompt.
if ! spicetify backup apply >/dev/null 2>&1; then
  if sudo -n spicetify backup apply >/dev/null 2>&1; then
    echo "backup+apply done (via sudo)"
  else
    echo "backup+apply needs a root pass — run 'sudo spicetify backup apply' once" >&2
  fi
fi

# The hexciri theme exists once hexciri-theme-set has generated it (any theme
# set does). Theme it if present, otherwise still leave spicetify applied so a
# future theme set finds the bundle patched.
if [[ -d $HOME/.config/spicetify/Themes/hexciri ]]; then
  spicetify config current_theme hexciri >/dev/null 2>&1 || true
fi
spicetify apply >/dev/null 2>&1 || \
  echo "spicetify apply had a problem (Spotify running? try 'spicetify doctor')" >&2

echo "done — restart Spotify to pick up the patched bundle."