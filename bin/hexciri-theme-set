#!/bin/bash
# hexciri:summary=Apply a hexciri theme (slim: colors.toml + background + hook, no Hyprland/shell IPC)
# hexciri:args=<theme-name>
set -euo pipefail

[[ -n ${1:-} ]] || { echo "Usage: hexciri-theme-set <theme-name>"; exit 1; }
THEME_INPUT="$1"
THEME_NAME="$(printf '%s' "$THEME_INPUT" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')"
here="$(readlink -f "$0" 2>/dev/null || echo "$0")"
HEXCIRI_PATH="${HEXCIRI_PATH:-$(dirname "$(dirname "$here")")}"

resolve_dir() {
  for base in "$HOME/.config/hexciri/themes/$THEME_NAME" "$HEXCIRI_PATH/themes/$THEME_NAME"; do
    [[ -d $base ]] && { printf '%s' "$base"; return 0; }
  done
  return 1
}

SRC_DIR="$(resolve_dir)" || { echo "theme not found: $THEME_INPUT" >&2; exit 1; }
[[ -f $SRC_DIR/colors.toml ]] || { echo "theme has no colors.toml: $SRC_DIR" >&2; exit 1; }

STATE_BASE="$HOME/.local/state/hexciri/current"
NEXT_DIR="$STATE_BASE/next-theme"
DEST_LINK="$STATE_BASE/theme"
mkdir -p "$STATE_BASE"

# Preserve user wallpaper links across the swap: theme-set only replaces
# theme-owned files, so zz-user-* symlinks (store + extra dirs) survive
# theme changes without a re-scan of the (possibly slow NFS) sources.
PRESERVE="$STATE_BASE/.zz-user-snap"
: > "$PRESERVE"
if [[ -d $DEST_LINK/backgrounds ]]; then
  while IFS= read -r -d '' lk; do
    tgt="$(readlink "$lk")"                     # works for dangling links too
    [[ -n $tgt ]] && printf '%s\0%s\0' "$lk" "$tgt" >> "$PRESERVE"
  done < <(find "$DEST_LINK/backgrounds" -maxdepth 1 -name 'zz-user-*' -print0)
fi

rm -rf "$NEXT_DIR"
cp -rL "$SRC_DIR" "$NEXT_DIR"
rm -rf "$DEST_LINK"
cp -rL "$NEXT_DIR" "$DEST_LINK"
printf '%s' "$THEME_NAME" > "$STATE_BASE/theme.name"

# restore preserved zz-user-* links (dangling as-is, so NFS mounts resolve later)
if [[ -s $PRESERVE ]]; then
  while IFS= read -r -d '' lk && IFS= read -r -d '' tgt; do
    [[ -e $lk || -L $lk ]] || ln -s "$tgt" "$lk" 2>/dev/null || true
  done < "$PRESERVE"
fi
rm -f "$PRESERVE"

# background: first image in backgrounds/, prefer name match, skip user links
BG_LINK="$STATE_BASE/background"
if [[ -d $DEST_LINK/backgrounds ]]; then
  pick="$(find -L "$DEST_LINK/backgrounds" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -not -name 'zz-user-*' | sort | head -n 1)"
  if [[ -z $pick ]]; then
    echo "hexciri-theme-set: no background found, keeping current"
  else
    ln -nsf "$pick" "$BG_LINK"
  fi
fi

export HEXCIRI_CURRENT_THEME="$DEST_LINK"
export HEXCIRI_THEME_NAME="$THEME_NAME"
REPO_BIN="$(cd "$(dirname "$0")" && pwd)"
if [[ -x $REPO_BIN/hexciri-theme-set-templates ]]; then
  "$REPO_BIN/hexciri-theme-set-templates" "$DEST_LINK"
elif command -v hexciri-theme-set-templates &>/dev/null; then
  hexciri-theme-set-templates "$DEST_LINK"
fi
hexciri-hook theme-set "$THEME_NAME"
echo "theme set: $THEME_NAME"
