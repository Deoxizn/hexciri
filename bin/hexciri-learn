#!/bin/bash
# hexciri:menu=learn
# hexciri:summary=Learn submenu — official docs for the tools actually installed on your system.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Docs for what this machine ships, gated on what is actually installed.
# Remove a package → its row disappears (e.g. opencode preinstalled not wanted).
# The WM row follows the installed WM, the terminal row follows the installed
# terminal — swapping one just swaps which docs the menu shows.
declare -a entries=()

add() { # add <label> <url> <binary-or-''> — '' means always show (framework itself)
  local label="$1" url="$2" bin="${3:-}"
  if [[ -z $bin ]] || command -v "$bin" &>/dev/null; then
    entries+=("$label|$url")
  fi
}

add "Hexciri" "https://hexciri.dirty.pizza" ""
add "Noctalia docs" "https://docs.noctalia.dev/noctalia/" noctalia

# WM row — whichever WM is installed shows its docs.
add "Niri wiki" "https://github.com/YaLTeR/niri/wiki" niri
add "Hyprland wiki" "https://wiki.hyprland.org" Hyprland
add "Sway wiki" "https://github.com/swaywm/sway/wiki" sway

# Terminal row — kitty is the shipped default; a swap to alacritty/foot just
# changes which docs show.
add "kitty docs" "https://sw.kovidgoyal.net/kitty/" kitty
add "Alacritty docs" "https://alacritty.org/" alacritty
add "foot docs" "https://codeberg.org/dnkl/foot" foot

add "fish docs" "https://fishshell.com/docs/current/" fish
add "Zed docs" "https://zed.dev/docs" zeditor
add "OpenCode docs" "https://opencode.ai/docs" opencode
add "Arch wiki" "https://wiki.archlinux.org/title/Main_page" ""
add "Starship docs" "https://starship.rs" starship

choice=$(
  printf '%s\n' "${entries[@]}" | sed 's/|.*//' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Learn: ' --width=28 --lines=${#entries[@]}
) || exec "$SCRIPT_DIR/hexciri-menu"   # Esc = back to root menu

# resolve the picked title back to its URL, then open it as a webapp
for e in "${entries[@]}"; do
  if [[ "${e%%|*}" == "$choice" ]]; then
    exec "$SCRIPT_DIR/hexciri-launch-webapp" "${e#*|}"
  fi
done
exec "$SCRIPT_DIR/hexciri-launch-webapp" "$choice"  # unreachable fallback