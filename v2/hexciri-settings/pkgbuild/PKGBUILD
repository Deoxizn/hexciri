pkgname=hexciri-settings
pkgver=1.6.5
pkgrel=1
pkgdesc='Settings for Hexciri: change Wi-Fi, sound, displays, keyboard, appearance, and more without editing config files'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-imageformats' 'hyprland' 'squashfs-tools')
optdepends=(
  'networkmanager: Wi-Fi'
  'bluez-utils: Bluetooth'
  'libpulse: sound devices and volume (pactl)'
  'power-profiles-daemon: power modes'
  'brightnessctl: laptop screen brightness'
  'ttf-jetbrains-mono-nerd: icons'
)
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/hexciri-settings "$pkgdir/usr/bin/hexciri-settings"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/hexciri-settings.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hexciri-settings.svg"
  install -Dm644 "$startdir/hexciri-settings.desktop" "$pkgdir/usr/share/applications/hexciri-settings.desktop"
}
