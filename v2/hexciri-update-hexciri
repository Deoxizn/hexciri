#!/bin/bash
# hexciri-update-hexciri: sync Hexciri nyx and re-run the installer when it changed.
# Called by hexciri-update (the dev-checkout step is a no-op on an installed
# machine: HEXCIRI_PATH is /usr/share/hexciri, not a git checkout, so it can
# never pull Hexciri updates). Also runnable standalone: hexciri update hexciri
#
# Git sync, like v1 (2026-11-24, Devi: "shouldn't that just be a git
# clone/sync like in hexciri v1?"). v1's docs/install.sh did exactly this:
# `git clone https://github.com/Deoxizn/hexciri.git ~/.local/opt/hexciri`
# once, then `git pull --ff-only` on every run, no auth, public repo.
# v2 uses a separate checkout so it never clobbers the v1 checkout:
#   ~/.local/opt/hexciri-nyx, branch nyx
# The old tarball download (codeload, curl -=O=- bar, 43 MB every update
# just to check a sha) is now only the fallback, when git is missing or
# the fetch/clone fails. No snapshot, no GRUB/btrfs.
#
# Yes, the installer DOES re-run inside an update, but only when the
# installer itself changed, and it is not a fresh bootstrap: it does not
# re-install EndeavourOS, wipe anything, or start over. It is an
# idempotent re-apply, and it is INCREMENTAL now (2026-11-24, Devi:
# every update re-forked Omarchy from scratch): the installer reuses
# its cached fork (~/.cache/hexciri/fork-cache) unless the fork
# fingerprint changed (fork code, pinned upstream commit, or a repo
# file copied into the fork). A minor installer change (update
# output, keyring, trim) re-runs the installer but does NOT re-fork:
# no 94 MB download, no 488-bin copy, no 874-file rewrite. A full
# re-fork happens only on a fork change, or with --force / --refork.
# When the installer sha matches and the installed tree is not
# drifting, it skips the re-install entirely and the update goes
# straight to the system packages.
# The git fetch to check that is tiny, so an unchanged update no longer
# downloads 43 MB first.
# Light sync (2026-11-24, Devi: v1 just cloned git and left the system
# alone): if the installer changed but all four fingerprints match the
# installed ones, the installed fork is already correct -- the installer
# is NOT re-run at all. install.sh --light-sync just updates the marker
# and the repo bins. A change to output wording / health only changes
# none of the four, so it light-syncs instead of re-running the
# installer and touching packages/theme.
# Minimal re-apply (2026-11-24, Devi: the full installer re-ran on
# every update even when 99.9% of it never changed): when exactly one
# group changed, run only that group, not the whole installer:
#   * only patch differs    -> install.sh --re-apply (fork + placement
#     + Settings/Nyxiri/theme-hooks/theme-link + health, no packages,
#     GPU, SDDM, theme, PAM, trim). The 85b425b WidgetButton case.
#   * only provision differs -> install.sh --re-apply-provision
#     (system-config steps + health, no packages, fork, placement).
#     E.g. a keyring PAM or SDDM fingerprint step change.
# Anything else (upstream or system changed, patch+provision both
# changed, fingerprint markers missing) runs the full installer, as
# before. A re-apply failure falls through to the full installer,
# never to a half-updated machine.
#
# Output (2026-11-24, Devi): one themed section, like every other update
# step, then one short status line, then the next section. Screen shows:
#   Updating Hexciri            <- themed header, active theme green
#   Hexciri is up to date (ef56f34)
# or, when the installer changed:
#   Updating Hexciri
#   Updating Hexciri to ef56f34...
#   Hexciri updated to ef56f34
# No full 64-char shas, no checkout paths, no duplicate git old->new +
# synced + sha lines on screen. Full detail (checkout path, full
# commits, full installer shas, tarball size, drift reason) goes to
# /tmp/hexciri-update-hexciri.log, or to the screen as well with
# HEXCIRI_UPDATE_VERBOSE=1. Real errors still print clearly.
#
# Usage: hexciri-update-hexciri [--force]
#   --force re-runs the installer even when the sha marker matches.

set -euo pipefail
export GIT_TERMINAL_PROMPT=0

REPO_URL="https://github.com/Deoxizn/hexciri.git"
BRANCH="nyx"
CHECKOUT="${HEXCIRI_NYX_CHECKOUT:-$HOME/.local/opt/hexciri-nyx}"
TARBALL_URL="https://codeload.github.com/Deoxizn/hexciri/tar.gz/refs/heads/nyx"
EXPECTED_TOP_DIR="hexciri-nyx"
MARKER="/usr/share/hexciri/.installer-sha"
FORCE=0
if [[ ${1:-} == "--force" ]]; then
  FORCE=1
fi

# Detail log: full shas, paths and reasons live here, not on screen.
DETAIL_LOG="${HEXCIRI_UPDATE_DETAIL_LOG:-/tmp/hexciri-update-hexciri.log}"
{ printf 'Hexciri self-update %s\n' "$(date -Is 2>/dev/null || date)"; } > "$DETAIL_LOG" 2>/dev/null || DETAIL_LOG=/dev/null

die() { printf 'ERROR: %s\n' "$1" >&2; exit 1; }
# bootstrap.lua integrity (2026-11-24, second breakage): existence is
# NOT enough, a 0-byte/truncated copy passes every -f check and still
# bricks the next boot. Same check as the installer (package.path +
# HEXCIRI_PATH, >=500 bytes; upstream is 921, patched 1399).
bootstrap_ok() {
  local _f="$1" _n
  [ -f "$_f" ] || return 1
  [ -s "$_f" ] || return 1
  _n="$(wc -c < "$_f" 2>/dev/null | tr -d ' ')"
  [ "${_n:-0}" -ge 500 ] || return 1
  grep -q 'package.path' "$_f" 2>/dev/null || return 1
  grep -q 'HEXCIRI_PATH' "$_f" 2>/dev/null || return 1
  return 0
}
# hexciri.lua integrity (2026-11-24, third breakage): same class as
# bootstrap.lua, existence is NOT enough. Hyprland requires
# default.hypr.hexciri at hyprland.lua:17; a 0-byte or truncated copy
# passes -s and still trips emergency mode. Same check as the installer.
hyprlua_ok() {
  local _f="$1" _n
  [ -f "$_f" ] || return 1
  [ -s "$_f" ] || return 1
  _n="$(wc -c < "$_f" 2>/dev/null | tr -d ' ')"
  [ "${_n:-0}" -ge 1000 ] || return 1
  grep -q 'require("default.hypr.helpers")' "$_f" 2>/dev/null || return 1
  return 0
}
# detail: log file, plus screen when HEXCIRI_UPDATE_VERBOSE=1.
# say_detail is the same thing, kept for the sync lines.
detail() {
  printf '%s\n' "$*" >> "$DETAIL_LOG" 2>/dev/null || true
  if [[ ${HEXCIRI_UPDATE_VERBOSE:-0} == "1" ]]; then printf '%s\n' "$*"; fi
}
say_detail() { detail "$@"; }

SOURCE_ROOT=""
SYNC_METHOD=""
OLD_COMMIT="none"
NEW_COMMIT="none"

# git_retry: one retry after 5s. A transient DNS/WiFi blip (the same
# outage that makes the tarball fallback fail with curl (6) "Could not
# resolve host") must not kill the whole update on the first try.
# stderr goes to the detail log, never /dev/null, so the reason (DNS,
# timeout, auth) is visible in /tmp/hexciri-update-hexciri.log.
git_retry() {
  if "$@" 2>>"$DETAIL_LOG"; then return 0; fi
  detail "command failed, retrying once in 5s: $*"
  sleep 5
  "$@" 2>>"$DETAIL_LOG"
}

# Git sync, like v1. Returns 0 and sets SOURCE_ROOT on success.
# Quiet on purpose: sync progress goes to the detail log, the screen
# only gets the themed header (below) and one short status line.
git_sync() {
  command -v git >/dev/null 2>&1 || { detail "git not found, skipping git sync"; return 1; }
  if [[ -e "$CHECKOUT" && ! -d "$CHECKOUT/.git" ]]; then
    detail "checkout $CHECKOUT exists but is not a git checkout, not using git"
    return 1
  fi
  if [[ -d "$CHECKOUT/.git" ]]; then
    OLD_COMMIT="$(git -C "$CHECKOUT" rev-parse --short HEAD 2>/dev/null || echo none)"
    say_detail "Syncing Hexciri nyx with git: $CHECKOUT"
    git_retry git -C "$CHECKOUT" fetch --quiet origin "$BRANCH" || { detail "git fetch failed"; return 1; }
    git -C "$CHECKOUT" checkout --quiet "$BRANCH" 2>>"$DETAIL_LOG" || { detail "git checkout $BRANCH failed"; return 1; }
    git_retry git -C "$CHECKOUT" pull --ff-only --quiet origin "$BRANCH" || { detail "git pull --ff-only failed"; return 1; }
  else
    say_detail "Cloning Hexciri nyx with git: $CHECKOUT"
    mkdir -p "$(dirname "$CHECKOUT")"
    git clone --quiet --branch "$BRANCH" "$REPO_URL" "$CHECKOUT" 2>>"$DETAIL_LOG" || { detail "git clone failed, retrying once in 5s"; sleep 5; rm -rf "$CHECKOUT"; git clone --quiet --branch "$BRANCH" "$REPO_URL" "$CHECKOUT" 2>>"$DETAIL_LOG"; } || { detail "git clone failed"; return 1; }
  fi
  [ -f "$CHECKOUT/v2/install.sh" ] || { detail "cloned tree has no v2/install.sh"; return 1; }
  NEW_COMMIT="$(git -C "$CHECKOUT" rev-parse --short HEAD 2>/dev/null || echo none)"
  detail "git full commits: $(git -C "$CHECKOUT" rev-parse HEAD 2>/dev/null || echo none) (old short: $OLD_COMMIT, new short: $NEW_COMMIT)"
  SOURCE_ROOT="$CHECKOUT"
  SYNC_METHOD="git"
  return 0
}

# Tarball fallback, the old path. Only runs when git is missing or failed.
# Silent curl (no --progress-bar -=O=- bar), size in the detail log only.
tarball_sync() {
  local workdir tarball top_dir
  workdir="$(mktemp -d /tmp/hexciri-update-hexciri.XXXXXX)"
  tarball="$workdir/hexciri-nyx.tar.gz"
  detail "Tarball fallback: $TARBALL_URL"
  curl -fsSL --max-time 300 -o "$tarball" "$TARBALL_URL" || { rm -rf "$workdir"; detail "tarball download failed"; return 1; }
  [ -s "$tarball" ] || { rm -rf "$workdir"; detail "tarball download empty"; return 1; }
  local size_bytes
  size_bytes="$(wc -c < "$tarball" | tr -d ' ')"
  detail "Tarball downloaded: $size_bytes bytes (~$((size_bytes / 1024 / 1024)) MB)"
  tar -tzf "$tarball" > "$workdir/tar-list.txt" || { rm -rf "$workdir"; detail "tarball is not a valid gzip tarball"; return 1; }
  top_dir="$(head -1 "$workdir/tar-list.txt" | cut -d/ -f1)"
  [ "$top_dir" = "$EXPECTED_TOP_DIR" ] || { rm -rf "$workdir"; detail "tarball top dir is '$top_dir', expected '$EXPECTED_TOP_DIR'"; return 1; }
  tar -xzf "$tarball" -C "$workdir" || { rm -rf "$workdir"; detail "tarball extraction failed"; return 1; }
  [ -f "$workdir/$top_dir/v2/install.sh" ] || { rm -rf "$workdir"; detail "extracted tree has no v2/install.sh"; return 1; }
  # Keep the extracted tree until the installer finishes: the trap in the
  # old script deleted it on EXIT, which is after the installer runs, so
  # stash the path in a global the caller can clean up.
  TARBALL_WORKDIR="$workdir"
  SOURCE_ROOT="$workdir/$top_dir"
  SYNC_METHOD="tarball"
  return 0
}

# Themed section header, same pattern as the other update steps
# (keyring, system-pkgs): active theme green, blank line before it.
echo -e "$(hexciri-theme-ansi green)\nUpdating Hexciri\e[0m"

if git_sync; then
  say_detail "Synced with git ($OLD_COMMIT -> $NEW_COMMIT)"
else
  detail "DNS check: github.com resolves to: $(getent hosts github.com 2>/dev/null | head -1 || echo UNRESOLVED)"
  detail "DNS check: codeload.github.com resolves to: $(getent hosts codeload.github.com 2>/dev/null | head -1 || echo UNRESOLVED)"
  echo "Git sync failed, trying tarball download..."
  if ! tarball_sync; then
    if [[ ${HEXCIRI_UPDATE_CONTINUE_ON_SYNC_FAIL:-0} == "1" ]]; then
      echo "Hexciri sync failed (network/DNS down? check dock Ethernet / Wi-Fi), skipping Hexciri self-update this run, system update continues. Details: $DETAIL_LOG"
      detail "sync failed, continuing with system update (HEXCIRI_UPDATE_CONTINUE_ON_SYNC_FAIL=1)"
      exit 0
    fi
    die "Hexciri sync failed (git and tarball both failed). Fix networking, then rerun hexciri update. Details: $DETAIL_LOG"
  fi
fi

NEW_SHA="$(sha256sum "$SOURCE_ROOT/v2/install.sh" | cut -d' ' -f1)"
OLD_SHA="$(cat "$MARKER" 2>/dev/null || true)"
# Both shas go to the detail log only, so a skip is still provable
# without printing 64-char hashes on screen. If they match, the skip is
# correct and the installer already landed (e.g. via a bootstrap just
# before this update). If they differ, re-install below.
detail "installed installer sha: ${OLD_SHA:-none}"
detail "nyx installer sha: $NEW_SHA"
detail "sync method: $SYNC_METHOD"

# Short commit for the one-line status, only when git gave us one.
SHORT=""
if [[ $SYNC_METHOD == "git" && $NEW_COMMIT != "none" ]]; then
  SHORT="$NEW_COMMIT"
fi

# Light sync: installer changed but the fork did not. Compare the
# fingerprints of the new installer against the installed markers;
# on a match, --light-sync updates the marker + repo bins and exits,
# no installer re-run, no pacman, no theme, no settings touched.
INSTALLED_UP="$(cat /usr/share/hexciri/.upstream-fingerprint 2>/dev/null || true)"
INSTALLED_PATCH="$(cat /usr/share/hexciri/.patch-fingerprint 2>/dev/null || true)"
INSTALLED_PROV="$(cat /usr/share/hexciri/.provision-fingerprint 2>/dev/null || true)"
INSTALLED_SYS="$(cat /usr/share/hexciri/.system-fingerprint 2>/dev/null || true)"
if [[ $FORCE -eq 0 && -n $OLD_SHA && $NEW_SHA != "$OLD_SHA" && -n $INSTALLED_UP && -n $INSTALLED_PATCH && -n $INSTALLED_PROV && -n $INSTALLED_SYS ]] && bootstrap_ok /usr/share/hexciri/default/hypr/bootstrap.lua && hyprlua_ok /usr/share/hexciri/default/hypr/hexciri.lua && [ -x "$HOME/.local/bin/hexciri-settings" ]; then
  _fp_out="$(bash "$SOURCE_ROOT/v2/install.sh" --print-fingerprints 2>/dev/null || true)"
  _new_up="$(printf '%s\n' "$_fp_out" | grep '^upstream=' | cut -d= -f2)"
  _new_patch="$(printf '%s\n' "$_fp_out" | grep '^patch=' | cut -d= -f2)"
  _new_prov="$(printf '%s\n' "$_fp_out" | grep '^provision=' | cut -d= -f2)"
  _new_sys="$(printf '%s\n' "$_fp_out" | grep '^system=' | cut -d= -f2)"
  detail "installed fingerprints: upstream=${INSTALLED_UP:0:12} patch=${INSTALLED_PATCH:0:12} provision=${INSTALLED_PROV:0:12} system=${INSTALLED_SYS:0:12}"
  detail "nyx fingerprints: upstream=${_new_up:0:12} patch=${_new_patch:0:12} provision=${_new_prov:0:12} system=${_new_sys:0:12}"
  if [[ -n $_new_up && -n $_new_patch && -n $_new_prov && -n $_new_sys && $_new_up == "$INSTALLED_UP" && $_new_patch == "$INSTALLED_PATCH" && $_new_prov == "$INSTALLED_PROV" && $_new_sys == "$INSTALLED_SYS" ]]; then
    detail "fingerprints match, light sync (no installer re-run)"
    echo "Hexciri is up to date${SHORT:+ ($SHORT)} (light sync, no installer re-run)"
    if bash "$SOURCE_ROOT/v2/install.sh" --light-sync; then
      [[ -n ${TARBALL_WORKDIR:-} ]] && rm -rf "$TARBALL_WORKDIR"
      exit 0
    fi
    detail "light sync failed, falling through to a full installer re-run"
  elif [[ -n $_new_up && -n $_new_patch && -n $_new_prov && -n $_new_sys && $_new_up == "$INSTALLED_UP" && $_new_prov == "$INSTALLED_PROV" && $_new_sys == "$INSTALLED_SYS" && $_new_patch != "$INSTALLED_PATCH" ]]; then
    detail "only the fork patch changed, re-apply (fork + placement only, no packages / GPU / SDDM / theme / PAM / trim)"
    if [[ -n $SHORT ]]; then echo "Updating Hexciri to $SHORT... (re-apply: fork patch only)"; else echo "Updating Hexciri... (re-apply: fork patch only)"; fi
    if bash "$SOURCE_ROOT/v2/install.sh" --yes --no-reboot --re-apply; then
      _rm_after="$(cat "$MARKER" 2>/dev/null || true)"
      if [[ $_rm_after == "$NEW_SHA" ]]; then
        if [[ -n $SHORT ]]; then echo "Hexciri updated to $SHORT"; else echo "Hexciri updated"; fi
        [[ -n ${TARBALL_WORKDIR:-} ]] && rm -rf "$TARBALL_WORKDIR"
        exit 0
      fi
      detail "marker mismatch after re-apply: got '${_rm_after:-none}', expected $NEW_SHA"
    fi
    detail "re-apply failed, falling through to a full installer re-run"
  elif [[ -n $_new_up && -n $_new_patch && -n $_new_prov && -n $_new_sys && $_new_up == "$INSTALLED_UP" && $_new_patch == "$INSTALLED_PATCH" && $_new_sys == "$INSTALLED_SYS" && $_new_prov != "$INSTALLED_PROV" ]]; then
    detail "only the system config changed, re-apply-provision (config steps only, no packages / fork / placement)"
    if [[ -n $SHORT ]]; then echo "Updating Hexciri to $SHORT... (re-apply: system config only)"; else echo "Updating Hexciri... (re-apply: system config only)"; fi
    if bash "$SOURCE_ROOT/v2/install.sh" --yes --no-reboot --re-apply-provision; then
      _rm_after="$(cat "$MARKER" 2>/dev/null || true)"
      if [[ $_rm_after == "$NEW_SHA" ]]; then
        if [[ -n $SHORT ]]; then echo "Hexciri updated to $SHORT"; else echo "Hexciri updated"; fi
        [[ -n ${TARBALL_WORKDIR:-} ]] && rm -rf "$TARBALL_WORKDIR"
        exit 0
      fi
      detail "marker mismatch after re-apply-provision: got '${_rm_after:-none}', expected $NEW_SHA"
    fi
    detail "re-apply-provision failed, falling through to a full installer re-run"
  fi
fi

# Drift check: a matching sha only proves the marker was written, not
# that the installed tree is complete. If theme-ansi is missing, the
# logo is not Devi's art, or the Hexciri Settings binary is missing
# (a failed Qt build must be retried by the next update, never left
# for a manual build), re-run the installer even on a sha match.
if [[ $FORCE -eq 0 && -n $OLD_SHA && $NEW_SHA == "$OLD_SHA" ]]; then
  if [[ ! -x /usr/share/hexciri/bin/hexciri-theme-ansi ]] || ! bootstrap_ok /usr/share/hexciri/default/hypr/bootstrap.lua || ! hyprlua_ok /usr/share/hexciri/default/hypr/hexciri.lua || ! head -1 /usr/share/hexciri/logo.txt 2>/dev/null | grep -q '▄███▄' || [[ ! -x $HOME/.local/bin/hexciri-settings ]]; then
    detail "sha matches but installed tree is drifting (theme-ansi, bootstrap.lua, hexciri.lua, logo.txt or hexciri-settings binary missing/corrupt), re-running installer"
    # Self-heal first: if the fork cache still has a good bootstrap.lua,
    # restore just that file now, so the next boot works even if the
    # installer re-run below is interrupted.
    for _bs_cache in "$HOME/.cache/hexciri/fork-cache/fork-out/default/hypr/bootstrap.lua" "$HOME/.cache/hexciri/fork-cache/upstream-out/default/hypr/bootstrap.lua"; do
      if bootstrap_ok "$_bs_cache" && ! bootstrap_ok /usr/share/hexciri/default/hypr/bootstrap.lua; then
        _tmp_bs="/usr/share/hexciri/default/hypr/.bootstrap.lua.hexciri-new"
        if sudo cp -a "$_bs_cache" "$_tmp_bs" 2>/dev/null && sudo mv "$_tmp_bs" /usr/share/hexciri/default/hypr/bootstrap.lua 2>/dev/null && bootstrap_ok /usr/share/hexciri/default/hypr/bootstrap.lua; then
          detail "self-healed bootstrap.lua from fork cache: $_bs_cache"
          break
        fi
      fi
    done
    unset _bs_cache
    # Self-heal hexciri.lua the same way (2026-11-24): the drift check
    # used to restore only bootstrap.lua, so a corrupt hexciri.lua
    # survived into the next boot as emergency mode.
    for _hx_cache in "$HOME/.cache/hexciri/fork-cache/fork-out/default/hypr/hexciri.lua" "$HOME/.cache/hexciri/fork-cache/upstream-out/default/hypr/hexciri.lua"; do
      if hyprlua_ok "$_hx_cache" && ! hyprlua_ok /usr/share/hexciri/default/hypr/hexciri.lua; then
        _tmp_hx="/usr/share/hexciri/default/hypr/.hexciri.lua.hexciri-new"
        if sudo cp -a "$_hx_cache" "$_tmp_hx" 2>/dev/null && sudo mv "$_tmp_hx" /usr/share/hexciri/default/hypr/hexciri.lua 2>/dev/null && hyprlua_ok /usr/share/hexciri/default/hypr/hexciri.lua; then
          detail "self-healed hexciri.lua from fork cache: $_hx_cache"
          break
        fi
      fi
    done
    unset _hx_cache
    echo "Hexciri is up to date${SHORT:+ ($SHORT)}, but some installed files are missing, re-running the installer..."
  else
    if [[ -n $SHORT ]]; then
      echo "Hexciri is up to date ($SHORT)"
    else
      echo "Hexciri is up to date"
    fi
    [[ -n ${TARBALL_WORKDIR:-} ]] && rm -rf "$TARBALL_WORKDIR"
    exit 0
  fi
fi

if [[ -n $SHORT ]]; then
  echo "Updating Hexciri to $SHORT..."
else
  echo "Updating Hexciri..."
fi
if [[ $FORCE -eq 1 ]]; then
  bash "$SOURCE_ROOT/v2/install.sh" --yes --no-reboot --refork
else
  bash "$SOURCE_ROOT/v2/install.sh" --yes --no-reboot
fi

# The installer writes the new marker itself; verify it landed.
NEW_MARKER="$(cat "$MARKER" 2>/dev/null || true)"
if [[ $NEW_MARKER != "$NEW_SHA" ]]; then
  detail "marker mismatch after re-run: got '${NEW_MARKER:-none}', expected $NEW_SHA"
  echo "ERROR: installer did not finish updating, it will retry on the next update (details: $DETAIL_LOG)" >&2
fi
if [[ -n $SHORT ]]; then
  echo "Hexciri updated to $SHORT"
else
  echo "Hexciri updated"
fi
if [[ -n ${TARBALL_WORKDIR:-} ]]; then rm -rf "$TARBALL_WORKDIR"; fi
