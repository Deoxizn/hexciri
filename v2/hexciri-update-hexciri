#!/bin/bash
# hexciri-update-hexciri: sync Hexciri nyx and re-run the installer when it changed.
# Called by hexciri-update (the dev-checkout step is a no-op on an installed
# machine: HEXCIRI_PATH is /usr/share/hexciri, not a git checkout, so it can
# never pull Hexciri updates). Also runnable standalone: hexciri update hexciri
#
# Git sync, like v1 (2026-11-24, Devi: "shouldn't that just be a git
# clone/sync like in hexciri v1?"). v1's docs/install.sh did exactly this:
# `git clone https://github.com/Deoxizn/hexciri.git ~/.local/opt/hexciri`
# once, then `git pull --ff-only` on every run, no auth, public repo.
# v2 uses a separate checkout so it never clobbers the v1 checkout:
#   ~/.local/opt/hexciri-nyx, branch nyx
# The old tarball download (codeload, curl -=O=- bar, 43 MB every update
# just to check a sha) is now only the fallback, when git is missing or
# the fetch/clone fails. No snapshot, no GRUB/btrfs.
#
# Yes, the installer DOES re-run inside an update, but only when the
# installer itself changed, and it is not a fresh bootstrap: it does not
# re-install EndeavourOS, wipe anything, or start over. It is an
# idempotent re-apply, and it is INCREMENTAL now (2026-11-24, Devi:
# every update re-forked Omarchy from scratch): the installer reuses
# its cached fork (~/.cache/hexciri/fork-cache) unless the fork
# fingerprint changed (fork code, pinned upstream commit, or a repo
# file copied into the fork). A minor installer change (update
# output, keyring, trim) re-runs the installer but does NOT re-fork:
# no 94 MB download, no 488-bin copy, no 874-file rewrite. A full
# re-fork happens only on a fork change, or with --force / --refork.
# When the installer sha matches and the installed tree is not
# drifting, it skips the re-install entirely and the update goes
# straight to the system packages.
# The git fetch to check that is tiny, so an unchanged update no longer
# downloads 43 MB first.
#
# Output (2026-11-24, Devi): one themed section, like every other update
# step, then one short status line, then the next section. Screen shows:
#   Updating Hexciri            <- themed header, active theme green
#   Hexciri is up to date (ef56f34)
# or, when the installer changed:
#   Updating Hexciri
#   Updating Hexciri to ef56f34...
#   Hexciri updated to ef56f34
# No full 64-char shas, no checkout paths, no duplicate git old->new +
# synced + sha lines on screen. Full detail (checkout path, full
# commits, full installer shas, tarball size, drift reason) goes to
# /tmp/hexciri-update-hexciri.log, or to the screen as well with
# HEXCIRI_UPDATE_VERBOSE=1. Real errors still print clearly.
#
# Usage: hexciri-update-hexciri [--force]
#   --force re-runs the installer even when the sha marker matches.

set -euo pipefail
export GIT_TERMINAL_PROMPT=0

REPO_URL="https://github.com/Deoxizn/hexciri.git"
BRANCH="nyx"
CHECKOUT="${HEXCIRI_NYX_CHECKOUT:-$HOME/.local/opt/hexciri-nyx}"
TARBALL_URL="https://codeload.github.com/Deoxizn/hexciri/tar.gz/refs/heads/nyx"
EXPECTED_TOP_DIR="hexciri-nyx"
MARKER="/usr/share/hexciri/.installer-sha"
FORCE=0
if [[ ${1:-} == "--force" ]]; then
  FORCE=1
fi

# Detail log: full shas, paths and reasons live here, not on screen.
DETAIL_LOG="${HEXCIRI_UPDATE_DETAIL_LOG:-/tmp/hexciri-update-hexciri.log}"
{ printf 'Hexciri self-update %s\n' "$(date -Is 2>/dev/null || date)"; } > "$DETAIL_LOG" 2>/dev/null || DETAIL_LOG=/dev/null

die() { printf 'ERROR: %s\n' "$1" >&2; exit 1; }
# detail: log file, plus screen when HEXCIRI_UPDATE_VERBOSE=1.
# say_detail is the same thing, kept for the sync lines.
detail() {
  printf '%s\n' "$*" >> "$DETAIL_LOG" 2>/dev/null || true
  if [[ ${HEXCIRI_UPDATE_VERBOSE:-0} == "1" ]]; then printf '%s\n' "$*"; fi
}
say_detail() { detail "$@"; }

SOURCE_ROOT=""
SYNC_METHOD=""
OLD_COMMIT="none"
NEW_COMMIT="none"

# Git sync, like v1. Returns 0 and sets SOURCE_ROOT on success.
# Quiet on purpose: sync progress goes to the detail log, the screen
# only gets the themed header (below) and one short status line.
git_sync() {
  command -v git >/dev/null 2>&1 || { detail "git not found, skipping git sync"; return 1; }
  if [[ -e "$CHECKOUT" && ! -d "$CHECKOUT/.git" ]]; then
    detail "checkout $CHECKOUT exists but is not a git checkout, not using git"
    return 1
  fi
  if [[ -d "$CHECKOUT/.git" ]]; then
    OLD_COMMIT="$(git -C "$CHECKOUT" rev-parse --short HEAD 2>/dev/null || echo none)"
    say_detail "Syncing Hexciri nyx with git: $CHECKOUT"
    git -C "$CHECKOUT" fetch --quiet origin "$BRANCH" 2>/dev/null || { detail "git fetch failed"; return 1; }
    git -C "$CHECKOUT" checkout --quiet "$BRANCH" 2>/dev/null || { detail "git checkout $BRANCH failed"; return 1; }
    git -C "$CHECKOUT" pull --ff-only --quiet origin "$BRANCH" 2>/dev/null || { detail "git pull --ff-only failed"; return 1; }
  else
    say_detail "Cloning Hexciri nyx with git: $CHECKOUT"
    mkdir -p "$(dirname "$CHECKOUT")"
    git clone --quiet --branch "$BRANCH" "$REPO_URL" "$CHECKOUT" 2>/dev/null || { detail "git clone failed"; return 1; }
  fi
  [ -f "$CHECKOUT/v2/install.sh" ] || { detail "cloned tree has no v2/install.sh"; return 1; }
  NEW_COMMIT="$(git -C "$CHECKOUT" rev-parse --short HEAD 2>/dev/null || echo none)"
  detail "git full commits: $(git -C "$CHECKOUT" rev-parse HEAD 2>/dev/null || echo none) (old short: $OLD_COMMIT, new short: $NEW_COMMIT)"
  SOURCE_ROOT="$CHECKOUT"
  SYNC_METHOD="git"
  return 0
}

# Tarball fallback, the old path. Only runs when git is missing or failed.
# Silent curl (no --progress-bar -=O=- bar), size in the detail log only.
tarball_sync() {
  local workdir tarball top_dir
  workdir="$(mktemp -d /tmp/hexciri-update-hexciri.XXXXXX)"
  tarball="$workdir/hexciri-nyx.tar.gz"
  detail "Tarball fallback: $TARBALL_URL"
  curl -fsSL --max-time 300 -o "$tarball" "$TARBALL_URL" || { rm -rf "$workdir"; detail "tarball download failed"; return 1; }
  [ -s "$tarball" ] || { rm -rf "$workdir"; detail "tarball download empty"; return 1; }
  local size_bytes
  size_bytes="$(wc -c < "$tarball" | tr -d ' ')"
  detail "Tarball downloaded: $size_bytes bytes (~$((size_bytes / 1024 / 1024)) MB)"
  tar -tzf "$tarball" > "$workdir/tar-list.txt" || { rm -rf "$workdir"; detail "tarball is not a valid gzip tarball"; return 1; }
  top_dir="$(head -1 "$workdir/tar-list.txt" | cut -d/ -f1)"
  [ "$top_dir" = "$EXPECTED_TOP_DIR" ] || { rm -rf "$workdir"; detail "tarball top dir is '$top_dir', expected '$EXPECTED_TOP_DIR'"; return 1; }
  tar -xzf "$tarball" -C "$workdir" || { rm -rf "$workdir"; detail "tarball extraction failed"; return 1; }
  [ -f "$workdir/$top_dir/v2/install.sh" ] || { rm -rf "$workdir"; detail "extracted tree has no v2/install.sh"; return 1; }
  # Keep the extracted tree until the installer finishes: the trap in the
  # old script deleted it on EXIT, which is after the installer runs, so
  # stash the path in a global the caller can clean up.
  TARBALL_WORKDIR="$workdir"
  SOURCE_ROOT="$workdir/$top_dir"
  SYNC_METHOD="tarball"
  return 0
}

# Themed section header, same pattern as the other update steps
# (keyring, system-pkgs): active theme green, blank line before it.
echo -e "$(hexciri-theme-ansi green)\nUpdating Hexciri\e[0m"

if git_sync; then
  say_detail "Synced with git ($OLD_COMMIT -> $NEW_COMMIT)"
else
  echo "Git sync failed, trying tarball download..."
  tarball_sync || die "Hexciri sync failed (git and tarball both failed). Fix networking, then rerun hexciri update. Details: $DETAIL_LOG"
fi

NEW_SHA="$(sha256sum "$SOURCE_ROOT/v2/install.sh" | cut -d' ' -f1)"
OLD_SHA="$(cat "$MARKER" 2>/dev/null || true)"
# Both shas go to the detail log only, so a skip is still provable
# without printing 64-char hashes on screen. If they match, the skip is
# correct and the installer already landed (e.g. via a bootstrap just
# before this update). If they differ, re-install below.
detail "installed installer sha: ${OLD_SHA:-none}"
detail "nyx installer sha: $NEW_SHA"
detail "sync method: $SYNC_METHOD"

# Short commit for the one-line status, only when git gave us one.
SHORT=""
if [[ $SYNC_METHOD == "git" && $NEW_COMMIT != "none" ]]; then
  SHORT="$NEW_COMMIT"
fi

# Drift check: a matching sha only proves the marker was written, not
# that the installed tree is complete. If theme-ansi is missing or the
# logo is not Devi's art, re-run the installer even on a sha match.
if [[ $FORCE -eq 0 && -n $OLD_SHA && $NEW_SHA == "$OLD_SHA" ]]; then
  if [[ ! -x /usr/share/hexciri/bin/hexciri-theme-ansi ]] || ! head -1 /usr/share/hexciri/logo.txt 2>/dev/null | grep -q '▄███▄'; then
    detail "sha matches but installed tree is drifting (theme-ansi or logo.txt missing), re-running installer"
    echo "Hexciri is up to date${SHORT:+ ($SHORT)}, but some installed files are missing, re-running the installer..."
  else
    if [[ -n $SHORT ]]; then
      echo "Hexciri is up to date ($SHORT)"
    else
      echo "Hexciri is up to date"
    fi
    [[ -n ${TARBALL_WORKDIR:-} ]] && rm -rf "$TARBALL_WORKDIR"
    exit 0
  fi
fi

if [[ -n $SHORT ]]; then
  echo "Updating Hexciri to $SHORT..."
else
  echo "Updating Hexciri..."
fi
if [[ $FORCE -eq 1 ]]; then
  bash "$SOURCE_ROOT/v2/install.sh" --yes --no-reboot --refork
else
  bash "$SOURCE_ROOT/v2/install.sh" --yes --no-reboot
fi

# The installer writes the new marker itself; verify it landed.
NEW_MARKER="$(cat "$MARKER" 2>/dev/null || true)"
if [[ $NEW_MARKER != "$NEW_SHA" ]]; then
  detail "marker mismatch after re-run: got '${NEW_MARKER:-none}', expected $NEW_SHA"
  echo "ERROR: installer did not finish updating, it will retry on the next update (details: $DETAIL_LOG)" >&2
fi
if [[ -n $SHORT ]]; then
  echo "Hexciri updated to $SHORT"
else
  echo "Hexciri updated"
fi
if [[ -n ${TARBALL_WORKDIR:-} ]]; then rm -rf "$TARBALL_WORKDIR"; fi
