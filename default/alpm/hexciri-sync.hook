[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = avahi
Target = hwloc
Target = v4l-utils
Target = qt6ct
Target = ufw
Target = openssh

[Action]
Description = Re-applying hexciri layer (menu curation, firewall, sshd hardening)
When = PostTransaction
Exec = /usr/local/bin/hexciri-sync