[colors]
# background alpha e6 (~90% opaque) pairs with the niri fuzzel layer-rule blur.
# Use ff for fully opaque, cc for ~80% — selection stays opaque for readability.
background={{ background }}e6
text={{ foreground }}ff
message={{ muted }}ff
prompt={{ foreground }}ff
placeholder={{ muted }}ff
input={{ foreground }}ff
match={{ accent }}ff
selection={{ fuzzel_selection }}ff
selection-text={{ fuzzel_selection_text }}ff
selection-match={{ fuzzel_selection_match }}ff
counter={{ muted }}ff
border={{ accent }}ff