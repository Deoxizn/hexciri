# Hexciri — Sway config (entry point)
# https://github.com/deoxizn/hexciri
#
# This file is the entry point only: it includes the per-concern fragments in
# conf.d/ via the glob below (sway ≥1.8). Keep personal tweaks either in the
# fragments or in your own conf.d/zz-*.conf file.
#
#   conf.d/input.conf        -- input type:keyboard / type:touchpad blocks
#   conf.d/monitors.conf     -- output { } — screens, scale, mode, VRR (carry-over)
#   conf.d/looknfeel.conf    -- theme-owned: client.{focused,unfocused} borders
#   conf.d/keybinds.conf     -- bindsym — hexciri core (hand-written)
#   conf.d/autostart.conf    -- exec — boot-time services & shell
#   conf.d/window-rules.conf -- for_window — floating dialogs (samples)
#
# Env is NOT a sway directive — the Wayland stack is exported via
# ~/.config/environment.d/10-hexciri.conf (imported by the sway session command).
# Split so each concern is easy to find, edit and back up on its own.
# To add custom keybinds without touching the schema, append bindsym lines
# here or in conf.d/zz-custom.conf (after the glob).

include ~/.config/sway/conf.d/*