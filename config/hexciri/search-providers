# hexciri search providers — single source of truth for hexciri-fuzzel search.
#
# Read by bin/hexciri-fuzzel (web search) and bin/hexciri-search-provider
# (System ▸ Config ▸ Search provider picker). Mod+Shift+S uses the provider
# named by `default=`; the picker rewrites that line.
#
# Format, one provider per line:
#   name|Display Name|url-template      (%s = URL-encoded query)
# Legacy "name=url" lines also parse. Lines starting with # are ignored.
# A box that never touched this file gets the repo default on install/update
# (hexciri-sync seeds it); once edited, your version is kept forever.

default=google

# Main web search engines ── pick a default and switch via the picker:
#   google       Google AI Mode (udm=8 → generative answer view)
#   googleclassic Google classic (udm=14 → plain results, no AI Overview)
#   ddg          DuckDuckGo — private, no tracking profile
#   brave        Brave Search — independent index with built-in AI answers
#   searxng      SearXNG — meta-search aggregator (point it at your own instance)
google|Google AI|https://google.com/search?udm=8&q=%s
googleclassic|Google (classic)|https://google.com/search?udm=14&q=%s
ddg|DuckDuckGo|https://duckduckgo.com/?q=%s
brave|Brave|https://search.brave.com/search?q=%s
searxng|SearXNG|https://searx.be/search?q=%s

# Targeted destinations — handy extras, add or drop as you like:
github|GitHub|https://github.com/search?q=%s&type=code
wiki|Wikipedia|https://en.wikipedia.org/w/index.php?search=%s
archwiki|Arch Wiki|https://wiki.archlinux.org/index.php?search=%s
youtube|YouTube|https://www.youtube.com/results?search_query=%s
aur|AUR|https://aur.archlinux.org/packages?K=%s
man|Arch Man Pages|https://man.archlinux.org/search?q=%s

# Self-hosted SearXNG example — set default=mysearx and it's your search:
# mysearx|SearXNG (self-hosted)|https://searx.example.org/search?q=%s