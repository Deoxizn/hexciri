#!/bin/bash
# hexciri:summary=Default apps: kitty + fish + brave-origin + strata + imv + zed + opencode (xdg-native)
# Only shows apps that are actually installed; current choice is marked with ✓.
# usage: hexciri-defaults [Browser|Editor|Images|Terminal|Shell|Files|Agent]
set -euo pipefail

STATE_BASE="$HOME/.local/state/hexciri/defaults"
mkdir -p "$STATE_BASE"
get() { cat "$STATE_BASE/$1" 2>/dev/null || true; }
setv() { printf '%s' "$2" > "$STATE_BASE/$1"; }

# seed user core on first run
[[ -f $STATE_BASE/terminal ]] || setv terminal kitty
[[ -f $STATE_BASE/shell ]]    || setv shell fish
[[ -f $STATE_BASE/browser ]]  || setv browser brave-origin
[[ -f $STATE_BASE/files ]]    || setv files strata
[[ -f $STATE_BASE/editor ]]   || setv editor zed
[[ -f $STATE_BASE/agent ]]    || setv agent opencode
[[ -f $STATE_BASE/images ]]   || setv images imv

# available(): only list candidates whose binary exists (browser: via desktop file)
has_bin() { command -v "$1" >/dev/null 2>&1; }
has_desktop() {
  local d
  for d in "$@"; do
    [[ -f $HOME/.local/share/applications/$d || -f /usr/local/share/applications/$d || -f /usr/share/applications/$d ]] && return 0
  done
  return 1
}
available() { # <browser|terminal|...> <current> <candidates...>
  local type=$1 current=$2; shift 2
  local c
  for c in "$@"; do
    case "$type" in
      browser) has_desktop "$c.desktop" || continue ;;
      editor)  # Arch's zed ships as zeditor, not zed
        if [[ $c == zed ]]; then
          command -v zeditor >/dev/null 2>&1 || continue
        else
          has_bin "$c" || continue
        fi
        ;;
      *) has_bin "$c" || continue ;;
    esac
    printf '%s\n' "$c"
  done | while read -r c; do
    if [[ $c == "$current" ]]; then printf '✓ %s\n' "$c"; else printf '%s\n' "$c"; fi
  done
}

menu_via_fuzzel() { # <prompt> -- <items...>
  local prompt=$1; shift
  [[ $1 == -- ]] && shift
  if command -v hexciri-fuzzel &>/dev/null; then
    printf '%s\n' "$@" | hexciri-fuzzel --dmenu --prompt="$prompt" --width=30 --lines=8
  else
    printf '%s\n' "$@" | head -n 1
  fi
}

pick_type="${1:-}"
if [[ -z $pick_type ]]; then
  pick_type="$(menu_via_fuzzel 'Defaults: ' -- Browser Editor Terminal Shell Files Images Agent)" || exit 0
fi

case "${pick_type,,}" in
  browser)
    current="$(get browser)"
    choice="$(menu_via_fuzzel 'Browser: ' -- "$(available browser "$current" brave-origin brave-origin-beta brave firefox chromium zen)")" || exit 0
    if [[ -z $(available browser "$current" brave-origin brave-origin-beta brave firefox chromium zen | grep -F "$choice") && $choice != "$current" ]]; then
      exit 0
    fi
    setv browser "$choice"
    # map choice -> desktop file for xdg (first existing wins)
    set_browser() {
      for d in "$@"; do
        [[ -f $HOME/.local/share/applications/$d || -f /usr/local/share/applications/$d || -f /usr/share/applications/$d ]] || continue
        xdg-settings set default-web-browser "$d" 2>/dev/null && return 0
      done
      return 1
    }
    case "$choice" in
      brave-origin) set_browser brave-origin.desktop com.brave.Origin.desktop || true ;;
      brave-origin-beta) set_browser brave-origin-beta.desktop com.brave.Origin.beta.desktop || true ;;
      brave) set_browser brave-browser.desktop || true ;;
      firefox) set_browser firefox.desktop || true ;;
      chromium) set_browser chromium.desktop || true ;;
      zen) set_browser zen.desktop || true ;;
    esac
    ;;
  terminal)
    current="$(get terminal)"
    choice="$(menu_via_fuzzel 'Terminal: ' -- "$(available terminal "$current" kitty foot ghostty alacritty)")" || exit 0
    [[ -n $choice ]] || exit 0
    setv terminal "$choice"
    ;;
  shell)
    current="$(get shell)"
    choice="$(menu_via_fuzzel 'Shell: ' -- "$(available shell "$current" fish bash)")" || exit 0
    [[ -n $choice ]] || exit 0
    setv shell "$choice"
    # shell is the interactive terminal shell only; the login shell stays bash
    # (SSH/su/scripts stay POSIX-safe). kitty reads it from this default.
    if command -v kitty >/dev/null 2>&1; then
      if [[ $choice == fish ]]; then
        kitty +kitten edit-config main.conf --replace 'shell fish' --apply-config "shell fish" >/dev/null 2>&1 \
          || sed -i 's|^shell .*|shell fish|' "$HOME/.config/kitty/kitty.conf" 2>/dev/null || true
        echo "kitty terminals now open in fish"
      else
        sed -i 's|^shell .*|shell '"$choice"'|' "$HOME/.config/kitty/kitty.conf" 2>/dev/null \
          || printf 'shell %s\n' "$choice" >> "$HOME/.config/kitty/kitty.conf"
        echo "kitty terminals now open in $choice"
      fi
    fi
    ;;
  files)
    current="$(get files)"
    choice="$(menu_via_fuzzel 'Files: ' -- "$(available files "$current" strata nautilus thunar yazi)")" || exit 0
    [[ -n $choice ]] || exit 0
    setv files "$choice"
    if [[ $choice == strata ]]; then
      # Strata ships io.github.lgse.Strata.desktop; register as folder handler
      xdg-mime default io.github.lgse.Strata.desktop inode/directory 2>/dev/null || true
    fi
    ;;
  images)
    current="$(get images)"
    choice="$(menu_via_fuzzel 'Images: ' -- "$(available images "$current" imv qimgv)")" || exit 0
    [[ -n $choice ]] || exit 0
    setv images "$choice"
    # imv ships NoDisplay=true, so it never wins as a hidden default; a
    # displayable user-level override makes it visible and defaultable.
    if [[ $choice == imv ]]; then
      if [[ -f /usr/share/applications/imv.desktop || -f ~/.local/share/applications/imv.desktop ]]; then
        mkdir -p "$HOME/.local/share/applications"
        awk '/^NoDisplay=/{next} {print}' /usr/share/applications/imv.desktop > "$HOME/.local/share/applications/imv.desktop" 2>/dev/null || true
        awk '/^NoDisplay=/{next} {print}' /usr/share/applications/imv-dir.desktop > "$HOME/.local/share/applications/imv-dir.desktop" 2>/dev/null || true
        for mt in image/png image/x-png image/jpeg image/jpg image/pjpeg image/gif image/bmp image/x-bmp image/webp image/avif image/heif image/tiff image/tiff-fx image/svg+xml image/x-farbfeld image/jxl image/qoi image/*; do
          xdg-mime default imv.desktop "$mt" 2>/dev/null || true
        done
      fi
    fi
    ;;
  editor)
    current="$(get editor)"
    choice="$(menu_via_fuzzel 'Editor: ' -- "$(available editor "$current" zed nvim helix code)")" || exit 0
    [[ -n $choice ]] || exit 0
    setv editor "$choice"
    ;;
  agent)
    current="$(get agent)"
    choice="$(menu_via_fuzzel 'Agent: ' -- "$(available agent "$current" opencode claude codex)")" || exit 0
    [[ -n $choice ]] || exit 0
    setv agent "$choice"
    ;;
  *) exit 0 ;;
esac

echo "default ${pick_type,,}: $(get "${pick_type,,}")"