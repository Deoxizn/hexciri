#!/bin/bash
# hexciri:summary=Capture submenu: screenshot, screen recording, OCR, QR decode, transcode
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
note() { notify-send "Hexciri" "$1" 2>/dev/null || true; }
SHOT_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
latest_shot() { ls -t "$SHOT_DIR" 2>/dev/null | head -n 1; }

if [[ $# -gt 0 ]]; then
  choice="$*"
else
  choice=$(printf '%s\n' 'Screenshot region' 'Screenshot screen' 'Screen recording' 'OCR text from screen' 'Decode QR from screen' 'Transcode media' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Capture: ' --width=32 --lines=6) || exec "$SCRIPT_DIR/hexciri-menu"
fi

case "$choice" in
  "Screenshot region")
    niri msg action screenshot 2>/dev/null && note "Region shot saved to $SHOT_DIR" || note "Screenshot failed"
    ;;
  "Screenshot screen")
    niri msg action screenshot-screen 2>/dev/null && note "Screen shot saved to $SHOT_DIR" || note "Screenshot failed"
    ;;
  "Screen recording")
    exec "$SCRIPT_DIR/hexciri-screenrecord"
    ;;
  "OCR text from screen")
    niri msg action screenshot-screen 2>/dev/null || { note "Screenshot failed"; exit 1; }
    sleep 1
    img="$SHOT_DIR/$(latest_shot)"
    [[ -f $img ]] || { note "No screenshot found"; exit 1; }
    text="$(tesseract "$img" stdout 2>/dev/null)"
    [[ -n $text ]] && { printf '%s' "$text" | wl-copy; note "OCR copied to clipboard"; } || note "No text found"
    ;;
  "Decode QR from screen")
    niri msg action screenshot-screen 2>/dev/null || { note "Screenshot failed"; exit 1; }
    sleep 1
    img="$SHOT_DIR/$(latest_shot)"
    [[ -f $img ]] || { note "No screenshot found"; exit 1; }
    code="$(zbarimg --raw --quiet "$img" 2>/dev/null | head -n 1)"
    [[ -n $code ]] && { printf '%s' "$code" | wl-copy; note "QR copied: ${code:0:60}"; } || note "No QR found"
    ;;
  "Transcode media")
    exec "$SCRIPT_DIR/hexciri-terminal" -e hexciri-transcode
    ;;
esac
