#!/bin/bash
# hexciri:summary=Kernel menu: stock linux/lts (stable) + linux-omarchy/-bore/-muqss (bleeding rolling pkgs)
# No Limine, no CachyOS, no snapshots. systemd-boot entries only. Stock kernel never removed.
set -euo pipefail

declare -A KERNEL_PKGS=(
  [stock]="linux"
  [lts]="linux-lts"
  [omarchy]="linux-omarchy"
  [bore]="linux-omarchy-bore"
  [muqss]="linux-omarchy-muqss"
)

info() { echo -e "\e[0;36m[hexciri]\e[0m $*"; }
ok()   { echo -e "\e[0;32m[hexciri]\e[0m $*"; }
warn() { echo -e "\e[1;33m[hexciri]\e[0m $*" >&2; }
err()  { echo -e "\e[0;31m[hexciri]\e[0m $*" >&2; }

channel_is_bleeding() {
  grep -q "https://pkgs.omarchy.org/edge/" /etc/pacman.conf 2>/dev/null
}

do_kernel() {
  local key=$1 base=${KERNEL_PKGS[$1]:-}
  [[ -n $base ]] || { err "unknown kernel '$1'"; exit 1; }

  if pacman -Q "$base" &>/dev/null; then
    ok "$base already installed"
  else
    case "$base" in
      linux-omarchy*)
        # availability, not channel name: true today only on bleeding,
        # auto-relaxes if stable ever ships these kernels
        pacman -Si "$base" &>/dev/null || {
          warn "$base is not in your configured repos (today: bleeding only)."
          warn "Run: hexciri-channel-set bleeding — or install stock instead."
          exit 1
        }
        ;;
    esac
    info "installing $base + headers..."
    sudo pacman -S --noconfirm "$base" "$base-headers"
  fi

  # systemd-boot: nothing to repoint by hand — entries drop into
  # /boot/loader/entries/ via mkinitcpio preset. Set default:
  local entry
  entry="$(ls /boot/loader/entries/ 2>/dev/null | grep -i "$base" | sort | head -n 1 || true)"
  if [[ -n $entry && -f /boot/loader/loader.conf ]]; then
    if grep -q "^default " /boot/loader/loader.conf 2>/dev/null; then
      sudo sed -i "s|^default .*|default $entry|" /boot/loader/loader.conf
    else
      echo "default $entry" | sudo tee -a /boot/loader/loader.conf >/dev/null
    fi
    ok "systemd-boot default -> $entry (stock kept as fallback)"
  else
    ok "$base ready (reboot, pick it in systemd-boot; stock kept)"
  fi
}

do_status() {
  for k in stock lts omarchy bore muqss; do
    if pacman -Q "${KERNEL_PKGS[$k]}" &>/dev/null; then
      echo "installed: $k (${KERNEL_PKGS[$k]} $(pacman -Q "${KERNEL_PKGS[$k]}" | cut -d' ' -f2))"
    fi
  done
  echo "default: $(grep '^default ' /boot/loader/loader.conf 2>/dev/null || echo '(systemd-boot default)')"
  channel_is_bleeding && echo "channel: bleeding" || echo "channel: stable (bore/muqss need bleeding)"
}

if [[ ${1:-} == run ]]; then
  shift
  case ${1:-} in
    status) do_status ;;
    stock|lts|omarchy|bore|muqss) do_kernel "$1" ;;
    *) err "unknown action '$1'"; exit 1 ;;
  esac
  exit 0
fi

# menu mode (fuzzel when available, numbered fallback)
if command -v hexciri-fuzzel &>/dev/null; then
  choice="$(printf '%s\n' 'Stock — linux' 'LTS — linux-lts' 'Omarchy — linux-omarchy' 'BORE — linux-omarchy-bore' 'MuQSS — linux-omarchy-muqss' 'Status' | hexciri-fuzzel --dmenu --prompt='Kernel: ' --width=32 --lines=6)" || exit 0
  case "$choice" in
    Stock*)  exec "$0" run stock ;;
    LTS*)    exec "$0" run lts ;;
    Omarchy*) exec "$0" run omarchy ;;
    BORE*)   exec "$0" run bore ;;
    MuQSS*)  exec "$0" run muqss ;;
    Status)  exec "$0" run status ;;
  esac
else
  do_status
fi
