#!/bin/bash
# hexciri:summary=Hexciri repo sync: pull newer commits + quietly deploy changed files. Nothing new → says up to date and stops.
set -euo pipefail

REPO="${HEXCIRI_PATH:-$HOME/.local/opt/hexciri}"
if [[ ! -d $REPO ]]; then
  echo "hexciri repo not found at: $REPO"
  echo "expected a bootstrap clone at ~/.local/opt/hexciri"
  exit 1
fi

run_as_root() { sudo -n "$@" 2>/dev/null || sudo "$@"; }

echo "syncing $REPO ..."
git -C "$REPO" fetch --tags origin --quiet 2>/dev/null || true
behind=$(git -C "$REPO" rev-list --count HEAD..@{upstream} 2>/dev/null || echo 0)
head_before=$(git -C "$REPO" rev-parse --short HEAD)

if (( behind == 0 )); then
  echo "up to date (HEAD $head_before) — nothing to deploy"
  exit 0
fi

echo "pulling $behind new commit(s)..."
git -C "$REPO" pull --ff-only --quiet

current="$(hexciri-channel-current 2>/dev/null || echo stable)"
user_out=""; system_out=""
if ! user_out=$("$REPO/install.sh" --channel "$current" --user-only --update -y 2>&1); then
  echo "user phase failed — output:" >&2
  echo "$user_out" >&2
  exit 1
fi
if ! system_out=$(run_as_root env HEXCIRI_USER="$(id -un)" "$REPO/install.sh" --channel "$current" --system-only --update -y 2>&1); then
  echo "system phase failed — output:" >&2
  echo "$system_out" >&2
  exit 1
fi

head_after=$(git -C "$REPO" rev-parse --short HEAD)
echo "repo updated to $head_after ($behind commit(s)); scripts/hooks/configs deployed"