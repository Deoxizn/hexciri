#!/bin/bash
# hexciri:speedtest=speed-tests
# hexciri:summary=Speed tests: network down/up and disk
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bindir="${HEXCIRI_BIN_DIR:-}"
if [[ -z $bindir && -d $(dirname "$SCRIPT_DIR")/bin ]]; then bindir="$(dirname "$SCRIPT_DIR")/bin"; fi
bindir="${bindir:-$SCRIPT_DIR}"

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
choice=$(
  printf '%s\n' \
    'Network download' \
    'Network upload' \
    'Disk' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Speed test: ' --width=26 --lines=3
) || exec "$SCRIPT_DIR/hexciri-menu"
fi

case "$choice" in
  "Network download") exec "$SCRIPT_DIR/hexciri-launch-webapp" 'https://fast.com' ;;
  "Network upload")   exec "$SCRIPT_DIR/hexciri-launch-webapp" 'https://fast.com' ;;
  "Disk")             exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$bindir/hexciri-disk-speedtest" ;;
esac