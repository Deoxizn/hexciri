#!/bin/bash
# hexciri:menu=root
# hexciri:summary=Root application menu — dispatches to sub-menus
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choice=$(
  printf '%s\n' \
    'Learn >' \
    'Packages >' \
    'Share >' \
    'Capture >' \
    'Reminders >' \
    'Hardware >' \
    'Themes >' \
    'System >' \
    'Restart >' \
    'System Update >' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='► Hexciri ' --width=28 --lines=10
) || exit 0
choice=${choice%' >'}

case "$choice" in
  Learn)         exec "$SCRIPT_DIR/hexciri-learn" ;;
  Packages)      exec "$SCRIPT_DIR/hexciri-packages" ;;
  Share)         exec "$SCRIPT_DIR/hexciri-share" ;;
  Capture)       exec "$SCRIPT_DIR/hexciri-capture" ;;
  Reminders)     exec "$SCRIPT_DIR/hexciri-reminders" ;;
  Hardware)      exec "$SCRIPT_DIR/hexciri-trigger" ;;
  Themes)        exec "$SCRIPT_DIR/hexciri-themes" ;;
  System)        exec "$SCRIPT_DIR/hexciri-system" ;;
  Restart)       exec "$SCRIPT_DIR/hexciri-restart" ;;
  "System Update") exec "$SCRIPT_DIR/hexciri-update" ;;
esac