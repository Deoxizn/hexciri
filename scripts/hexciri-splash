#!/bin/bash
# hexciri:summary=Splash submenu: adopt or refresh the hexciri boot splash (systemd-boot + mkinitcpio)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PLYMOUTH_DST="/usr/share/plymouth/themes/hexciri"
PLYMOUTH_SRC="${HEXCIRI_PATH:-/usr/share/hexciri}/branding/plymouth"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info() { echo -e "${CYAN}[hexciri]${NC} $*"; }
ok()   { echo -e "${GREEN}[hexciri]${NC} $*"; }
warn() { echo -e "${YELLOW}[hexciri]${NC} $*"; }
err()  { echo -e "${RED}[hexciri]${NC} $*" >&2; }

rebuild_initrd() {
  if ! mountpoint -q /boot; then
    warn "/boot is not mounted — refusing to leave boot images half-built."
    warn "Mount the ESP (e.g. mount /dev/nvme0n1p1 /boot) and rerun this menu."
    return 1
  fi
  info "rebuilding initramfs (mkinitcpio -P)..."
  if ! sudo mkinitcpio -P; then
    warn "mkinitcpio FAILED — boot images are stale. DO NOT reboot until a rebuild succeeds."
    return 1
  fi
}

splash_active() { grep -q '^Theme=hexciri' /etc/plymouth/plymouthd.conf 2>/dev/null; }

do_status() {
  if splash_active; then
    ok "hexciri splash active"
  else
    warn "no hexciri splash — adopt via this menu"
  fi
}

do_adopt() {
  if [[ ! -d $PLYMOUTH_SRC ]]; then
    err "branding/plymouth not found (looked in $PLYMOUTH_SRC) — clone the repo with branding/ intact"
    exit 1
  fi
  if ! pacman -Q plymouth &>/dev/null; then
    info "installing plymouth..."
    sudo pacman -S --noconfirm plymouth
  fi
  sudo mkdir -p "$PLYMOUTH_DST"
  sudo cp -r "$PLYMOUTH_SRC"/. "$PLYMOUTH_DST"/
  sudo plymouth-set-default-theme hexciri
  rebuild_initrd || { err "splash adopt incomplete — fix the above before rebooting"; exit 1; }
  ok "hexciri splash adopted (takes effect next boot)"
}

do_refresh() {
  if ! splash_active; then
    warn "hexciri splash is not active — use Adopt first"
    exit 1
  fi
  sudo cp -r "$PLYMOUTH_SRC"/. "$PLYMOUTH_DST"/
  rebuild_initrd || { err "splash refresh incomplete — fix the above before rebooting"; exit 1; }
  ok "hexciri splash up to date"
}

if [[ ${1:-} == run ]]; then
  set -e
  shift
  case $1 in
    adopt)   do_adopt ;;
    refresh) do_refresh ;;
    status)  do_status ;;
    *) err "unknown action '$1'"; exit 1 ;;
  esac
  exit 0
fi

declare -A cmd_for=()
add() { cmd_for[$1]=$2; menu+="$1"$'\n'; }
menu=""
add 'Adopt hexciri splash'  'adopt'
add 'Refresh splash assets' 'refresh'
add 'Status'                'status'

choice=$(
  printf '%s' "$menu" |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Splash: ' --width=30 --lines=${#cmd_for[@]}
) || exec "$SCRIPT_DIR/hexciri-system"   # Esc = back to System menu

exec "$SCRIPT_DIR/hexciri-terminal" -e "$0" run "${cmd_for[$choice]}"