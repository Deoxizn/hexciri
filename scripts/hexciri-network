#!/bin/bash
# hexciri:network=network-setup
# hexciri:summary=Network setup: DNS provider picker and Wi-Fi sharing QR code
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bindir="${HEXCIRI_BIN_DIR:-}"
if [[ -z $bindir && -d $(dirname "$SCRIPT_DIR")/bin ]]; then bindir="$(dirname "$SCRIPT_DIR")/bin"; fi
bindir="${bindir:-$SCRIPT_DIR}"

entries=('DNS >')
[[ $("$bindir/hexciri-network-status" 2>/dev/null) == wifi ]] && entries+=('Wi-Fi QR Code')

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
choice=$(
  printf '%s\n' "${entries[@]}" |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Network: ' --width=26 --lines=${#entries[@]}
) || exec "$SCRIPT_DIR/hexciri-system"
fi
choice=${choice%' >'}

case "$choice" in
  DNS) ;;
  'Wi-Fi QR Code') exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-wifi-qr" ;;
  *) exit 0 ;;
esac

current=$("$bindir/hexciri-dns" 2>/dev/null)

pick=$(
  printf '%s\n' DHCP Cloudflare Google Custom |
    awk -v cur="$current" '$0 == cur { print "✓ " $0; next } { print }' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='DNS: ' --width=22 --lines=4
) || exec "$SCRIPT_DIR/hexciri-network"

provider=${pick#✓ }
[[ -n $provider ]] || exit 0

exec "$SCRIPT_DIR/hexciri-terminal" -e "$SCRIPT_DIR/hexciri-hold" sudo "$bindir/hexciri-dns" "$provider"