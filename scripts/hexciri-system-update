#!/bin/bash
# hexciri:menu=system-update
# hexciri:summary=Maintenance: clock sync, cleaner, user password, boot config reset.
# Notably no snapshot/tmux rows (hexciri is deliberately minimal).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
choice=$(
  printf '%s\n' \
    'Sync system clock' \
    'System Cleaner' \
    'User password' \
    'Reset boot config' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Maintenance: ' --width=32 --lines=4
) || exec "$SCRIPT_DIR/hexciri-system"   # Esc = back to System menu
fi

case "$choice" in
  "Sync system clock") exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" bash -c 'sudo timedatectl set-ntp false; sudo timedatectl set-ntp true; timedatectl status' ;;
  "System Cleaner")    exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$SCRIPT_DIR/hexciri-cleaner" ;;
  "User password")     exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" passwd ;;
  "Reset boot config") exec xdg-terminal-exec --app-id=TUI.float -e "$SCRIPT_DIR/hexciri-hold" "$SCRIPT_DIR/hexciri-refresh-boot" ;;
esac
