#!/bin/bash
# hexciri:update-hardware=restart-hardware-stacks
# hexciri:summary=Restart hardware stacks: audio, Wi-Fi, Bluetooth, trackpad
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -gt 0 ]]; then
  # Direct dispatch from menu search
  choice="$*"
else
choice=$(
  printf '%s\n' \
    'Audio' \
    'Wi-Fi' \
    'Bluetooth' \
    'Trackpad' |
    "$SCRIPT_DIR/hexciri-fuzzel" --dmenu --prompt='Restart: ' --width=26 --lines=4
) || exec "$SCRIPT_DIR/hexciri-update"
fi

case "$choice" in
  Audio)     exec "$SCRIPT_DIR/hexciri-terminal" -e bash -c 'systemctl --user restart pipewire pipewire-pulse; echo "pipewire restarted"; read -rp "press enter to close"' ;;
  Wi-Fi)     exec "$SCRIPT_DIR/hexciri-terminal" -e bash -c 'sudo systemctl restart NetworkManager; echo "NetworkManager restarted"; read -rp "press enter to close"' ;;
  Bluetooth) exec "$SCRIPT_DIR/hexciri-terminal" -e bash -c 'sudo systemctl restart bluetooth; echo "bluetooth restarted"; read -rp "press enter to close"' ;;
  Trackpad)  exec "$SCRIPT_DIR/hexciri-terminal" -e bash -c 'sudo modprobe -r i2c-hid-acpi && sudo modprobe i2c-hid-acpi; echo "trackpad stack reloaded"; read -rp "press enter to close"' ;;
esac