#!/bin/bash
# hexciri:summary=Reset tmux config: regenerate the themed tmux.conf from the active palette and reload tmux
set -euo pipefail

hook="$HOME/.config/hexciri/hooks/theme-set.d/10-tmux.sh"
if [[ ! -f $hook && -d "$HOME/.local/opt/hexciri" ]]; then
  hook="$HOME/.local/opt/hexciri/hooks/theme-set.d/10-tmux.sh"
fi

if [[ -f $hook ]]; then
  bash "$hook"
else
  echo "tmux theme hook not found ($hook)" >&2
  exit 1
fi

if command -v tmux >/dev/null 2>&1; then
  tmux source-file "$HOME/.config/tmux/hexciri-theme.conf" >/dev/null 2>&1 || true
  tmux source-file "$HOME/.config/tmux/tmux.conf" >/dev/null 2>&1 || true
fi
